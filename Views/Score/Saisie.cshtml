@{
    ViewData["Title"] = "Saisie des scores";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Saisie des scores";
    var tournoi = (croupe_06_TournoiGolf.Models.Tournoi)ViewBag.Tournoi;
    var equipes = ViewBag.Equipes as List<croupe_06_TournoiGolf.Models.Equipe>;
    var scores = ViewBag.Scores as List<croupe_06_TournoiGolf.Models.ScoreTrou>;
}

<section class="app-page-shell app-page-shell--wide">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-pencil-alt",
        Eyebrow = "Scoring",
        Title = "Saisie des scores",
        Description = $"{tournoi.Nom} - {tournoi.Lieu}"
    })

    <div id="message-confirmation" class="alert alert-success d-none" role="alert">
        <span id="texte-confirmation"></span>
    </div>
    <div id="message-erreur" class="alert alert-danger d-none" role="alert">
        <span id="texte-erreur"></span>
    </div>

    @if (equipes == null || !equipes.Any())
    {
        @await Html.PartialAsync("_EmptyState", new croupe_06_TournoiGolf.Models.ViewModels.EmptyStateViewModel
        {
            Icon = "fas fa-user-slash",
            Title = "Aucune equipe inscrite",
            Description = "Le tournoi ne contient encore aucune equipe active.",
            PrimaryLabel = "Retour au tournoi",
            PrimaryHref = $"/Tournoi/Details/{tournoi.TournoiId}"
        })
    }
    else
    {
        <section class="app-surface-card app-form-card">
            <div class="app-actions app-actions--spread">
                <div>
                    <span class="app-section-eyebrow"><i class="fas fa-flag"></i> Enregistrer un score</span>
                    <p class="app-muted-note">Saisissez les coups trou par trou puis ouvrez le classement en direct si necessaire.</p>
                </div>
                <div class="app-actions">
                    <a href="/Score/Tableau/@tournoi.TournoiId" class="btn btn-secondary" target="_blank">Voir le classement</a>
                    <a href="/Tournoi/Details/@tournoi.TournoiId" class="btn btn-secondary">Retour</a>
                </div>
            </div>

            <form id="score-entry-form" action="/Score/SaisirScore" method="post" class="app-form-card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tournoiId" value="@tournoi.TournoiId" />

                <div class="app-form-grid">
                    <div class="form-group">
                        <label for="select-equipe">Equipe</label>
                        <select id="select-equipe" name="equipeId">
                            @foreach (var equipe in equipes)
                            {
                                <option value="@equipe.EquipeId">@equipe.NomEquipe</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="select-trou">Trou</label>
                        <select id="select-trou" name="numeroTrou">
                            @for (int trou = 1; trou <= 18; trou++)
                            {
                                <option value="@trou">Trou @trou</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="input-coups">Nombre de coups</label>
                        <input type="number" id="input-coups" name="nbCoups" min="1" max="20" value="4" />
                    </div>
                </div>

                <div class="app-actions">
                    <button id="btn-saisir" class="btn" type="submit">Enregistrer le score</button>
                </div>
            </form>
        </section>

        <section class="app-surface-card app-table-card">
            <div class="app-table-card__header">
                <div>
                    <h2>Recapitulatif des scores</h2>
                    <p class="app-muted-note">Tableau mis a jour au fur et a mesure des saisies.</p>
                </div>
            </div>

            <div class="app-table-wrap">
                <table class="app-data-table" id="tableau-scores">
                    <thead>
                        <tr>
                            <th>Equipe</th>
                            @for (int trou = 1; trou <= 18; trou++)
                            {
                                <th>T@trou</th>
                            }
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var equipe in equipes)
                        {
                            <tr id="ligne-equipe-@equipe.EquipeId">
                                <td><strong>@equipe.NomEquipe</strong></td>
                                @for (int trou = 1; trou <= 18; trou++)
                                {
                                    var score = scores?.FirstOrDefault(s => s.EquipeId == equipe.EquipeId && s.NumeroTrou == trou);
                                    <td id="cell-@equipe.EquipeId-@trou">
                                        @(score != null ? score.NbCoups.ToString() : "-")
                                    </td>
                                }
                                <td id="total-@equipe.EquipeId">
                                    @(scores?.Where(s => s.EquipeId == equipe.EquipeId).Sum(s => s.NbCoups) is int total && total > 0 ? total.ToString() : "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>

@section Scripts {
    <script src="~/js/score-entry.js"></script>
}
