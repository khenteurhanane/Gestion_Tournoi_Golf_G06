@{
    ViewData["Title"] = "Classement en direct";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Classement";
    var tournoi = (croupe_06_TournoiGolf.Models.Tournoi)ViewBag.Tournoi;
    int tournoiId = (int)ViewBag.TournoiId;
}

<section class="app-page-shell app-page-shell--medium">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-golf-ball-tee",
        Eyebrow = "Scores en direct",
        Title = "Classement en direct",
        Description = $"{tournoi.Nom} · {tournoi.Lieu}"
    })

    <section class="app-surface-card app-table-card">
        <div class="app-table-card__header">
            <div>
                <h2>Classement</h2>
                <p class="app-muted-note"><span class="app-status-badge app-status-badge--success" id="statut-connexion">Connecté en direct</span></p>
            </div>
        </div>

        <div class="app-table-wrap">
            <table id="tableau-classement" class="app-data-table">
                <thead>
                    <tr>
                        <th>Position</th>
                        <th>Équipe</th>
                        <th>Trous joués</th>
                        <th>Total coups</th>
                    </tr>
                </thead>
                <tbody id="corps-classement">
                    <tr>
                        <td colspan="4" class="text-center">Chargement du classement...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <input type="hidden" id="tournoi-id" value="@tournoiId" />
</section>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/scoreboard.js"></script>
}
