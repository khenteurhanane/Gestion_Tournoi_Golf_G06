@{
    ViewData["Title"] = "Email envoyé";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card mb-4" style="text-align:center;">
            <div style="font-size: 3rem; margin-bottom: 16px;">📧</div>
            <h2>Vérifiez votre boîte mail</h2>
            <p class="sub">
                Si cet email est associé à un compte, vous recevrez dans quelques instants
                un lien pour réinitialiser votre mot de passe.
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" style="margin-top:16px;">
                    @TempData["Success"]
                </div>
            }

            <p style="margin-top: 24px; color: #888; font-size: 0.9rem;">
                ⚠️ Le lien expire après <strong>1 heure</strong>.
            </p>

            <div style="margin-top: 24px;">
                <a href="/Auth/Login" class="btn">Retour à la connexion</a>
            </div>
        </div>
    </div>
</div>
