@{
    ViewData["Title"] = "Email envoye";
    ViewData["UsePublicShell"] = true;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-envelope-circle-check",
        EyebrowText = "Verification",
        Title = "Verifiez votre boite courriel",
        Description = "Si un compte correspond a cette adresse, un lien de reinitialisation vient d'etre envoye."
    };
}

<div class="public-page auth-shell">
    <partial name="_PublicPageHero" model="hero" />

    <section class="public-section-card confirmation-panel">
        <div class="confirmation-panel__icon">
            <i class="fas fa-envelope-open-text"></i>
        </div>
        <h2 class="confirmation-panel__title">Message envoye</h2>
        <p class="confirmation-panel__text">
            Si cet email est associe a un compte, vous recevrez dans quelques instants un lien pour reinitialiser votre mot de passe.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="surface-alert surface-alert--success mt-4">@TempData["Success"]</div>
        }

        <div class="confirmation-panel__details">
            <div class="confirmation-panel__detail">
                <span>Validite du lien</span>
                <strong>1 heure</strong>
            </div>
            <div class="confirmation-panel__detail">
                <span>Etape suivante</span>
                <strong>Consulter votre courriel</strong>
            </div>
        </div>

        <div class="confirmation-panel__actions">
            <a href="/Auth/Login" class="btn">Retour a la connexion</a>
        </div>
    </section>
</div>
