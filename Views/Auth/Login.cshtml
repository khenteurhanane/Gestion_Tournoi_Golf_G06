@{
    ViewData["Title"] = "Connexion";
    ViewData["UsePublicShell"] = true;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-shield-alt",
        EyebrowText = "Acces securise",
        Title = "Connexion",
        Description = "Connectez-vous pour retrouver vos inscriptions, vos equipes et les outils de gestion associes a votre profil."
    };
}

<div class="public-page auth-shell">
    <partial name="_PublicPageHero" model="hero" />

    <section class="public-section-card auth-card">
        <div class="auth-card__header">
            <h2 class="auth-card__title">Acceder a votre espace</h2>
            <p class="auth-card__text">Utilisez votre adresse courriel et votre mot de passe pour continuer.</p>
        </div>

        <form action="/Auth/Login" method="post" class="form-stack">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="email">Adresse courriel</label>
                <input id="email" name="email" type="email" placeholder="exemple@email.com" required />
            </div>

            <div class="form-group">
                <label for="motDePasse">Mot de passe</label>
                <input id="motDePasse" name="motDePasse" type="password" placeholder="Entrez votre mot de passe" required />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="surface-alert surface-alert--danger">@ViewBag.Error</div>
            }

            <div class="auth-actions">
                <button class="btn" type="submit">Se connecter</button>
            </div>
        </form>

        <div class="auth-links">
            <span>Pas de compte ? <a href="/Auth/Register">Creer un compte</a></span>
            <span>Vous etes un commanditaire ? <a href="/Auth/InscriptionCommanditaire">Devenir commanditaire</a></span>
            <span><a href="/Auth/ForgotPassword">Mot de passe oublie ?</a></span>
        </div>
    </section>
</div>
