@model croupe_06_TournoiGolf.Models.ViewModels.InscriptionCommanditaireViewModel

@{
    ViewData["Title"] = "Devenir commanditaire";
    ViewData["UsePublicShell"] = true;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-handshake-angle",
        EyebrowText = "Commanditaire",
        Title = "Creer un acces commanditaire",
        Description = "Activez votre espace pour choisir un palier, suivre vos engagements et gerer la visibilite de votre organisation."
    };
}

<div class="public-page auth-shell">
    <partial name="_PublicPageHero" model="hero" />

    <section class="public-section-card auth-card">
        <div class="auth-card__header">
            <h2 class="auth-card__title">Informations du commanditaire</h2>
            <p class="auth-card__text">Remplissez ce formulaire pour creer votre acces et poursuivre ensuite avec le choix de votre commandite.</p>
        </div>

        <form asp-controller="Auth" asp-action="InscriptionCommanditaire" method="post" class="form-stack">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="surface-alert surface-alert--danger" asp-validation-summary="ModelOnly"></div>
            }

            <div class="form-split">
                <div class="form-group">
                    <label asp-for="Prenom">Prenom</label>
                    <input asp-for="Prenom" />
                    <span asp-validation-for="Prenom" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Nom">Nom</label>
                    <input asp-for="Nom" />
                    <span asp-validation-for="Nom" class="field-error"></span>
                </div>
            </div>

            <div class="form-split">
                <div class="form-group">
                    <label asp-for="Email">Courriel</label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Telephone">Telephone</label>
                    <input asp-for="Telephone" type="tel" />
                    <span asp-validation-for="Telephone" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="NomEntreprise">Nom de l'entreprise</label>
                <input asp-for="NomEntreprise" />
                <span asp-validation-for="NomEntreprise" class="field-error"></span>
            </div>

            <div class="form-split">
                <div class="form-group">
                    <label asp-for="MotDePasse">Mot de passe</label>
                    <input asp-for="MotDePasse" type="password" />
                    <span asp-validation-for="MotDePasse" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmationMotDePasse">Confirmer le mot de passe</label>
                    <input asp-for="ConfirmationMotDePasse" type="password" />
                    <span asp-validation-for="ConfirmationMotDePasse" class="field-error"></span>
                </div>
            </div>

            <div class="auth-actions">
                <button type="submit" class="btn">S'inscrire comme commanditaire</button>
            </div>
        </form>

        <div class="auth-links">
            <span>Deja inscrit ? <a asp-controller="Auth" asp-action="Login">Se connecter</a></span>
            <span>Vous etes un participant ? <a asp-controller="Auth" asp-action="Register">Inscription standard</a></span>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
