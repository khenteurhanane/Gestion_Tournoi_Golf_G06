@{
    ViewData["Title"] = "Inscription commanditaire confirmee";
    ViewData["UsePublicShell"] = true;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-circle-check",
        EyebrowText = "Compte actif",
        Title = "Inscription commanditaire confirmee",
        Description = "Votre acces commanditaire est pret. Vous pouvez maintenant parcourir les tournois et choisir votre niveau d'engagement."
    };
}

<div class="public-page auth-shell">
    <partial name="_PublicPageHero" model="hero" />

    <section class="public-section-card confirmation-panel">
        <div class="confirmation-panel__icon">
            <i class="fas fa-check"></i>
        </div>
        <h2 class="confirmation-panel__title">Compte cree avec succes</h2>
        <p class="confirmation-panel__text">
            Votre profil commanditaire est maintenant actif. Vous pouvez choisir un tournoi, suivre vos commandites et gerer vos informations depuis votre espace.
        </p>

        <div class="confirmation-panel__details">
            <div class="confirmation-panel__detail">
                <span>Prochaine etape</span>
                <strong>Choisir un tournoi a commanditer</strong>
            </div>
            <div class="confirmation-panel__detail">
                <span>Acces disponible</span>
                <strong>Mes commandites et mon profil</strong>
            </div>
        </div>

        <div class="confirmation-panel__actions">
            <a href="/Tournoi/Index" class="btn">Parcourir les tournois</a>
            <a href="/Commandite/Index" class="btn btn-secondary">Mes commandites</a>
        </div>
    </section>
</div>
