@model List<croupe_06_TournoiGolf.Models.Participant>
@using croupe_06_TournoiGolf.Models

@{
    ViewData["Title"] = "Mes Inscriptions";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Mes inscriptions";
    var equipes = (Dictionary<int, Equipe>)(ViewBag.Equipes ?? new Dictionary<int, Equipe>());
}

<section class="app-page-shell app-page-shell--wide">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-clipboard-list",
        Eyebrow = "Mon espace",
        Title = "Mes inscriptions",
        Description = Model.Count > 0
            ? $"Vous êtes actuellement inscrit à {Model.Count} tournoi(s)."
            : "Retrouvez ici toutes vos participations confirmées ou en attente."
    })

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Count == 0)
    {
        @await Html.PartialAsync("_EmptyState", new croupe_06_TournoiGolf.Models.ViewModels.EmptyStateViewModel
        {
            Icon = "fas fa-calendar-xmark",
            Title = "Aucune inscription",
            Description = "Vous n'êtes inscrit à aucun tournoi pour le moment.",
            PrimaryLabel = "Voir les tournois disponibles",
            PrimaryHref = "/Tournoi/Index"
        })
    }
    else
    {
        <section class="app-surface-card app-table-card">
            <div class="app-table-card__header">
                <div>
                    <h2>Historique</h2>
                    <p class="app-muted-note">Toutes vos inscriptions et leurs actions associées.</p>
                </div>
            </div>

            <div class="app-table-wrap">
                <table class="app-data-table">
                    <thead>
                        <tr>
                            <th>Tournoi</th>
                            <th>Date</th>
                            <th>Lieu</th>
                            <th>Type</th>
                            <th>Montant</th>
                            <th>Équipe</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inscription in Model)
                        {
                            var nomEquipe = "—";
                            var codeEquipe = "";
                            if (inscription.EquipeId != null && equipes.ContainsKey(inscription.EquipeId.Value))
                            {
                                nomEquipe = equipes[inscription.EquipeId.Value].NomEquipe;
                                codeEquipe = equipes[inscription.EquipeId.Value].CodeSecret;
                            }

                            <tr>
                                <td><strong>@inscription.Tournoi?.Nom</strong></td>
                                <td>@inscription.Tournoi?.DateTournoi.ToShortDateString()</td>
                                <td>@inscription.Tournoi?.Lieu</td>
                                <td>@(inscription.TypeParticipant == "retraite" ? "Retraité" : "Employé")</td>
                                <td>@inscription.MontantPaye.ToString("C")</td>
                                <td>
                                    @if (nomEquipe != "—")
                                    {
                                        <strong>@nomEquipe</strong>
                                        <div class="table-emphasis-code">@codeEquipe</div>
                                    }
                                    else
                                    {
                                        <div class="app-inline-actions">
                                            <span class="app-muted-note">Individuel</span>
                                            <a href="/Equipe/Rejoindre?participantId=@inscription.ParticipantId" class="btn btn-secondary">Rejoindre une équipe</a>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (inscription.StatutInscription == "CONFIRMEE")
                                    {
                                        <span class="app-status-badge app-status-badge--success">Confirmée</span>
                                    }
                                    else
                                    {
                                        <span class="app-status-badge app-status-badge--warning">@inscription.StatutInscription</span>
                                    }
                                </td>
                                <td>
                                    <div class="app-inline-actions">
                                        @if (inscription.StatutInscription == "EN_ATTENTE_PAIEMENT")
                                        {
                                            <a href="/Inscription/Paiement?participantId=@inscription.ParticipantId" class="btn">Payer</a>
                                        }
                                        <form action="/Auth/AnnulerInscription" method="post" class="inline-form" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette inscription?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="participantId" value="@inscription.ParticipantId" />
                                            <button type="submit" class="btn btn-secondary">Annuler</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
