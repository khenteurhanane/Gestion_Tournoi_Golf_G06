@model List<croupe_06_TournoiGolf.Models.Participant>
@using croupe_06_TournoiGolf.Models

@{
    ViewData["Title"] = "Mes Inscriptions";
    var equipes = (Dictionary<int, Equipe>)(ViewBag.Equipes ?? new Dictionary<int, Equipe>());
}

<h1>Mes Inscriptions</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="background: rgba(40, 167, 69, 0.2); color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 5px solid #28a745;">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="background: rgba(220, 53, 69, 0.2); color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 5px solid #dc3545;">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}


@if (Model.Count == 0)
{
    <div class="card text-center">
        <h3>Aucune inscription</h3>
        <p>Vous n'êtes inscrit à aucun tournoi pour le moment.</p>
        <a class="btn" href="/Tournoi/Index">Voir les tournois disponibles</a>
    </div>
}
else
{
    <p>Vous êtes inscrit à <strong>@Model.Count</strong> tournoi(s).</p>

    <table>
        <thead>
            <tr>
                <th>Tournoi</th>
                <th>Date</th>
                <th>Lieu</th>
                <th>Type</th>
                <th>Montant</th>
                <th>Équipe</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inscription in Model)
            {
                var nomEquipe = "—";
                var codeEquipe = "";
                if (inscription.EquipeId != null && equipes.ContainsKey(inscription.EquipeId.Value))
                {
                    nomEquipe = equipes[inscription.EquipeId.Value].NomEquipe;
                    codeEquipe = equipes[inscription.EquipeId.Value].CodeSecret;
                }

                <tr>
                    <td><strong>@inscription.Tournoi?.Nom</strong></td>
                    <td>@inscription.Tournoi?.DateTournoi.ToShortDateString()</td>
                    <td>@inscription.Tournoi?.Lieu</td>
                    <td>
                        @if (inscription.TypeParticipant == "retraite")
                        {
                            <span>Retraité</span>
                        }
                        else
                        {
                            <span>Employé</span>
                        }
                    </td>
                    <td>@inscription.MontantPaye.ToString("C")</td>
                    <td>
                        @if (nomEquipe != "—")
                        {
                            <span>@nomEquipe</span>
                            <br /><small style="color:var(--accent); letter-spacing:1px;">@codeEquipe</small>
                        }
                        else
                        {
                            <div style="display:flex; flex-direction:column; gap:5px;">
                                <span style="color:#aaa;">Individuel</span>
                                <a href="/Equipe/Rejoindre?participantId=@inscription.ParticipantId" class="btn btn-sm" style="font-size: 0.75rem; padding: 4px 8px; background-color: var(--accent); color: white; border: none; border-radius: 4px; text-decoration: none; display: inline-block; text-align: center;">Rejoindre une équipe</a>
                            </div>
                        }

                    </td>
                    <td>
                        @if (inscription.StatutInscription == "CONFIRMEE")
                        {
                            <span class="badge badge-ouvert">Confirmée</span>
                        }
                        else
                        {
                            <span class="badge badge-ferme">@inscription.StatutInscription</span>
                        }
                    </td>
                    <td>
                        @if (inscription.StatutInscription == "EN_ATTENTE_PAIEMENT")
                        {
                            <a href="/Inscription/Paiement?participantId=@inscription.ParticipantId" class="btn btn-primary" style="font-size:0.85rem; margin-right:5px; background-color:var(--gold); color:black; border:none;">Payer</a>
                        }
                        <form action="/Auth/AnnulerInscription" method="post" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette inscription?');">
                            <input type="hidden" name="participantId" value="@inscription.ParticipantId" />
                            <button type="submit" class="btn btn-secondary" style="font-size:0.85rem;">Annuler</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="card-footer">
    <a href="/Tournoi/Index" class="btn">Voir les tournois</a>
    <a href="/Auth/Profil" class="btn btn-secondary">Mon profil</a>
</div>
