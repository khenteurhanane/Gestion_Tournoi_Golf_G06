@model croupe_06_TournoiGolf.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Mot de passe oublie";
    ViewData["UsePublicShell"] = true;
    var emailErrors = ViewData.ModelState["Email"]?.Errors;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-key",
        EyebrowText = "Recuperation",
        Title = "Mot de passe oublie",
        Description = "Entrez votre adresse courriel pour recevoir les instructions de reinitialisation de votre acces."
    };
}

<div class="public-page auth-shell">
    <partial name="_PublicPageHero" model="hero" />

    <section class="public-section-card auth-card">
        <div class="auth-card__header">
            <h2 class="auth-card__title">Reinitialiser votre acces</h2>
            <p class="auth-card__text">Nous vous enverrons un lien de reinitialisation a l'adresse associee a votre compte.</p>
        </div>

        <form action="/Auth/ForgotPassword" method="post" class="form-stack">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Email">Adresse courriel</label>
                <input type="email" id="Email" name="Email" placeholder="exemple@email.com" required value="@Model?.Email" />
                @if (emailErrors is { Count: > 0 })
                {
                    <span class="field-error">@emailErrors[0].ErrorMessage</span>
                }
            </div>

            <div class="auth-actions">
                <button class="btn" type="submit">Envoyer le lien</button>
            </div>
        </form>

        <div class="auth-links">
            <span><a href="/Auth/Login">Retour a la connexion</a></span>
        </div>
    </section>
</div>
