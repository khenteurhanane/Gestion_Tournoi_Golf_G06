@model croupe_06_TournoiGolf.Models.Utilisateur

@{
    ViewData["Title"] = "Mon Profil";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card">
            <h2>Mon Profil</h2>
            <p class="sub">Gérez vos informations personnelles.</p>

            @if (ViewBag.Success != null)
            {
                <div class="alert-success">@ViewBag.Success</div>
            }

            <form action="/Auth/Profil" method="post">

                <div class="form-group">
                    <label>Adresse courriel</label>
                    <input type="email" value="@Model.Email" readonly />
                    <small>L'email ne peut pas être modifié.</small>
                </div>

                <div class="form-group">
                    <label>Rôle</label>
                    <input type="text" value="@Model.Role" readonly />
                </div>

                <div class="form-group">
                    <label for="Prenom">Prénom</label>
                    <input id="Prenom" name="Prenom" type="text" value="@Model.Prenom" placeholder="Votre prénom" required />
                </div>

                <div class="form-group">
                    <label for="Nom">Nom</label>
                    <input id="Nom" name="Nom" type="text" value="@Model.Nom" placeholder="Votre nom" required />
                </div>

                <div class="form-group">
                    <label for="Telephone">Téléphone</label>
                    <input id="Telephone" name="Telephone" type="tel" value="@Model.Telephone" placeholder="Ex: 613-555-1234" />
                </div>

                <div class="form-group">
                    <label for="Adresse">Adresse</label>
                    <input id="Adresse" name="Adresse" type="text" value="@Model.Adresse" placeholder="Votre adresse (optionnel)" />
                </div>

                <div class="form-group">
                    <label>Membre depuis</label>
                    <input type="text" value="@Model.CreeLe.ToShortDateString()" readonly />
                </div>

                <button class="btn" type="submit">Enregistrer les modifications</button>
            </form>

            <div class="card-footer">
                <a href="/Auth/MesInscriptions">Voir mes inscriptions</a> |
                <a href="/Auth/ForgotPassword">Changer mon mot de passe</a>
            </div>
        </div>

    </div>
</div>
