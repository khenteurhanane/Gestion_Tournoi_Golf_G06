@model croupe_06_TournoiGolf.Models.Utilisateur

@{
    ViewData["Title"] = "Mon Profil";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Mon profil";
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-user-circle",
        Eyebrow = "Mon espace",
        Title = "Mon profil",
        Description = "Mettez à jour vos informations personnelles utilisées dans les flux d'inscription et de paiement."
    })

    <section class="app-surface-card app-form-card">
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }

        <form action="/Auth/Profil" method="post" class="app-form-card">
            @Html.AntiForgeryToken()

            <div class="app-form-grid">
                <div class="form-group">
                    <label>Adresse courriel</label>
                    <input type="email" value="@Model.Email" readonly />
                    <p class="app-field-hint">L'adresse courriel ne peut pas être modifiée.</p>
                </div>

                <div class="form-group">
                    <label>Rôle</label>
                    <input type="text" value="@Model.Role" readonly />
                </div>

                <div class="form-group">
                    <label for="Prenom">Prénom</label>
                    <input id="Prenom" name="Prenom" type="text" value="@Model.Prenom" required />
                </div>

                <div class="form-group">
                    <label for="Nom">Nom</label>
                    <input id="Nom" name="Nom" type="text" value="@Model.Nom" required />
                </div>

                <div class="form-group">
                    <label for="Telephone">Téléphone</label>
                    <input id="Telephone" name="Telephone" type="tel" value="@Model.Telephone" placeholder="Ex: 613-555-1234" />
                </div>

                <div class="form-group">
                    <label for="Adresse">Adresse</label>
                    <input id="Adresse" name="Adresse" type="text" value="@Model.Adresse" placeholder="Votre adresse (optionnel)" />
                </div>

                <div class="form-group">
                    <label>Membre depuis</label>
                    <input type="text" value="@Model.CreeLe.ToShortDateString()" readonly />
                </div>
            </div>

            <div class="app-actions">
                <button class="btn" type="submit">Enregistrer les modifications</button>
                <a href="/Auth/MesInscriptions" class="btn btn-secondary">Mes inscriptions</a>
                <a href="/Auth/ForgotPassword" class="btn btn-secondary">Changer le mot de passe</a>
            </div>
        </form>
    </section>
</section>
