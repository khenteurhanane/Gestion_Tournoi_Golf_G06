@model croupe_06_TournoiGolf.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reinitialiser le mot de passe";
    ViewData["UsePublicShell"] = true;
    var newPasswordErrors = ViewData.ModelState["NewPassword"]?.Errors;
    var confirmPasswordErrors = ViewData.ModelState["ConfirmPassword"]?.Errors;
    var globalErrors = ViewData.ModelState[string.Empty]?.Errors;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-lock",
        EyebrowText = "Nouveau mot de passe",
        Title = "Reinitialisation",
        Description = "Choisissez un nouveau mot de passe securise pour reouvrir votre acces a la plateforme."
    };
}

<div class="public-page auth-shell">
    <partial name="_PublicPageHero" model="hero" />

    <section class="public-section-card auth-card">
        <div class="auth-card__header">
            <h2 class="auth-card__title">Definir un nouveau mot de passe</h2>
            <p class="auth-card__text">Confirmez votre nouveau mot de passe pour terminer la procedure.</p>
        </div>

        <form action="/Auth/ResetPassword" method="post" class="form-stack">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Email" value="@Model.Email" />
            <input type="hidden" name="Token" value="@Model.Token" />

            <div class="form-group">
                <label for="NewPassword">Nouveau mot de passe</label>
                <input type="password" id="NewPassword" name="NewPassword" placeholder="Minimum 6 caracteres" required />
                @if (newPasswordErrors is { Count: > 0 })
                {
                    <span class="field-error">@newPasswordErrors[0].ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label for="ConfirmPassword">Confirmer le mot de passe</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Retapez votre mot de passe" required />
                @if (confirmPasswordErrors is { Count: > 0 })
                {
                    <span class="field-error">@confirmPasswordErrors[0].ErrorMessage</span>
                }
            </div>

            @if (!ViewData.ModelState.IsValid && globalErrors is { Count: > 0 })
            {
                <div class="surface-alert surface-alert--danger">
                    @foreach (var error in globalErrors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="auth-actions">
                <button class="btn" type="submit">Changer le mot de passe</button>
            </div>
        </form>
    </section>
</div>
