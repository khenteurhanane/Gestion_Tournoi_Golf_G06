@{
    ViewData["Title"] = "Verification de votre email";
    ViewData["UsePublicShell"] = true;
}

<section class="auth-shell">
    <article class="auth-card">
        <div class="auth-card__header">
            <span class="auth-card__eyebrow"><i class="fas fa-envelope-open-text"></i> Activation</span>
            <h1 class="auth-card__title">Vérifiez votre adresse courriel</h1>
            <p class="auth-card__text">Un code de vérification a été envoyé à <strong>@ViewBag.Email</strong>. Saisissez-le pour activer votre compte.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="surface-alert surface-alert--danger">@ViewBag.Error</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="surface-alert surface-alert--success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="surface-alert surface-alert--danger">@TempData["Error"]</div>
        }

        @if (TempData["CodeAffiche"] != null)
        {
            <div class="warning-callout">
                <p class="warning-callout-text">Le service email n'est pas configuré. Voici votre code :</p>
                <span class="code-display">@TempData["CodeAffiche"]</span>
            </div>
        }

        <form action="/Auth/VerifierEmail" method="post" class="form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="form-group">
                <label for="code">Code de vérification (6 chiffres)</label>
                <input id="code" name="code" type="text" placeholder="000000" maxlength="6" pattern="[0-9]{6}" required class="verification-input" />
            </div>

            <div class="auth-actions">
                <button class="btn" type="submit">Vérifier mon compte</button>
            </div>
        </form>

        <div class="card-footer verification-footer">
            <p class="mb-2">Vous n'avez pas reçu le code ?</p>
            <form action="/Auth/RenvoyerCode" method="post" class="inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@ViewBag.Email" />
                <button type="submit" class="btn btn-secondary">Renvoyer le code</button>
            </form>
        </div>
    </article>
</section>
