@model croupe_06_TournoiGolf.Models.ViewModels.InscriptionViewModel

@{
    ViewData["Title"] = "Inscription au tournoi";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        
        <div class="card">
            <h2>Inscription au tournoi</h2>
            <p class="sub">Vous vous inscrivez au tournoi : <strong>@ViewBag.NomTournoi</strong></p>
            <p class="sub">Date : @ViewBag.DateTournoi | Lieu : @ViewBag.LieuTournoi</p>

            <form action="/Inscription/Index" method="post">
                @Html.AntiForgeryToken()

                
                <input type="hidden" name="TournoiId" value="@Model.TournoiId" />

                @if (ViewBag.Error != null)
                {
                    <div class="error">@ViewBag.Error</div>
                }

                <div class="form-group">
                    <label>Prénom</label>
                    <input name="Prenom" type="text" value="@Model?.Prenom" readonly />
                </div>

                <div class="form-group">
                    <label>Nom</label>
                    <input name="Nom" type="text" value="@Model?.Nom" readonly />
                </div>

                <div class="form-group">
                    <label>Adresse courriel</label>
                    <input name="Email" type="email" value="@Model?.Email" readonly />
                </div>

                <div class="form-group">
                    <label>Téléphone</label>
                    <input name="Telephone" type="tel" value="@Model?.Telephone" readonly />
                </div>

                <div class="form-group">
                    <label>Type de participant</label>
                    <select name="TypeParticipant" id="typeParticipant" onchange="mettreAJourPrix()">
                        <option value="employe">Employé (60,00 $)</option>
                        <option value="retraite">Retraité (50,00 $)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Montant à payer</label>
                    <input type="text" id="montantAffiche" value="60,00 $" readonly style="font-weight:bold;" />
                </div>

                <!-- Section équipe -->
                <div class="form-group">
                    <label>Équipe</label>
                    <select name="ChoixEquipe" id="choixEquipe" onchange="afficherEquipe()">
                        <option value="aucune">Pas d'équipe</option>
                        <option value="creer">Créer une équipe</option>
                        <option value="rejoindre">Rejoindre une équipe</option>
                    </select>
                </div>

                <div id="sectionCreer" style="display:none;">
                    <div class="form-group">
                        <label>Nom de l'équipe</label>
                        <input name="NomEquipe" type="text" placeholder="Ex: Les Aigles" />
                    </div>
                </div>

                <div id="sectionRejoindre" style="display:none;">
                    <div class="form-group">
                        <label>Code secret de l'équipe</label>
                        <input name="CodeEquipe" type="text" placeholder="Ex: ABC123" />
                    </div>
                </div>

                <button class="btn" type="submit">Confirmer mon inscription</button>
            </form>

            <div class="card-footer">
                <a href="/Tournoi/Index">Retour à la liste des tournois</a>
            </div>
        </div>

    </div>
</div>

<script>
    function afficherEquipe() {
        var choix = document.getElementById('choixEquipe').value;
        document.getElementById('sectionCreer').style.display = (choix === 'creer') ? 'block' : 'none';
        document.getElementById('sectionRejoindre').style.display = (choix === 'rejoindre') ? 'block' : 'none';
    }

    function mettreAJourPrix() {
        var type = document.getElementById('typeParticipant').value;
        var montant = (type === 'retraite') ? '50,00 $' : '60,00 $';
        document.getElementById('montantAffiche').value = montant;
    }
</script>
