@{
    ViewData["Title"] = "Inscription non disponible";
    ViewData["HideTopbarPageInfo"] = true;
    var header = new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-lock",
        Eyebrow = "Inscription",
        Title = "Inscriptions non disponibles",
        Description = "Ce tournoi n'accepte pas de nouvelles inscriptions pour le moment."
    };
    var message = ViewBag.Message != null
        ? ViewBag.Message.ToString()
        : "Les inscriptions pour ce tournoi sont actuellement fermees.";
    var state = new croupe_06_TournoiGolf.Models.ViewModels.EmptyStateViewModel
    {
        Icon = "fas fa-door-closed",
        Title = "Acces temporairement ferme",
        Description = message + " Vous pouvez reessayer plus tard ou contacter l'administrateur si necessaire.",
        PrimaryLabel = "Retour aux tournois",
        PrimaryHref = "/Tournoi/Index",
        SecondaryLabel = "Contacter l'equipe",
        SecondaryHref = "/Home/Contact"
    };
}

<div class="app-page">
    <partial name="_AppSectionHeader" model="header" />
    <partial name="_EmptyState" model="state" />
</div>
