@{
    ViewData["Title"] = "Inscription non disponible";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card text-center">
            <h2>Inscription non disponible</h2>
            
            <div class="error">
                @if (ViewBag.Message != null)
                {
                    @ViewBag.Message
                }
                else
                {
                    <text>Les inscriptions pour ce tournoi sont actuellement fermées.</text>
                }
            </div>

            <p>Veuillez réessayer plus tard ou <a href="/Home/Contact">contacter l'administrateur</a>.</p>

            <a class="btn" href="/Tournoi/Index">Retour à la liste des tournois</a>
        </div>
    </div>
</div>
