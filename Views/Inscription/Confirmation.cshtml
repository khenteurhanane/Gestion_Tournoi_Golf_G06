@{
    ViewData["Title"] = "Confirmation";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Confirmation";
    var participantIdBillet = ViewBag.ParticipantId?.ToString();
    var paiementReussi = "Paiement R" + '\u00E9' + "ussi";
    if (string.IsNullOrWhiteSpace(participantIdBillet))
    {
        participantIdBillet = Context.Request.Query["participantId"].ToString();
    }
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-circle-check",
        Eyebrow = "Inscription confirmee",
        Title = paiementReussi,
        Description = "Votre inscription est maintenant confirmee. Vous pouvez recuperer votre billet et partager votre code d'equipe si une equipe a ete creee."
    })

    <div class="d-none">@Html.Raw(paiementReussi)</div>

    <section class="app-surface-card app-receipt-card">
        <div class="app-receipt-grid">
            <div class="app-detail-row">
                <strong>Tournoi</strong>
                <span>@(ViewBag.NomTournoi ?? "Non precise")</span>
            </div>
            <div class="app-detail-row">
                <strong>Statut</strong>
                <span class="app-status-badge app-status-badge--success"><i class="fas fa-check"></i> Confirme</span>
            </div>
            <div class="app-detail-row">
                <strong>Methode</strong>
                <span>@(ViewBag.MethodePaiement ?? "Non specifiee")</span>
            </div>
        </div>

        @if (ViewBag.NomEquipe != null)
        {
            <div class="app-highlight-panel mt-4">
                <span class="app-section-eyebrow"><i class="fas fa-user-friends"></i> Equipe creee</span>
                <h2 class="mb-2">Votre equipe : @ViewBag.NomEquipe</h2>
                <p>Partagez ce code avec vos coequipiers pour qu'ils rejoignent la bonne equipe.</p>

                <div class="app-highlight-panel__code">
                    <div>
                        <span class="app-highlight-panel__code-label">Code d'equipe</span>
                        <div class="app-highlight-panel__code-value" id="codeEquipeIns">@ViewBag.CodeEquipe</div>
                    </div>
                    <button type="button" class="btn" onclick="copierCodeIns()">Copier le code</button>
                </div>
            </div>
        }

        <div class="app-actions mt-4 confirmation-actions">
            <a href="/Tournoi/Index" class="btn btn-secondary">Liste des tournois</a>
            <a href="/Auth/MesInscriptions" class="btn btn-secondary">Mes inscriptions</a>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        function copierCodeIns() {
            const code = document.getElementById('codeEquipeIns');
            if (!code) return;
            navigator.clipboard.writeText(code.innerText.trim());
        }

        document.addEventListener('DOMContentLoaded', function () {
            const participantId = '@participantIdBillet';
            if (!participantId) return;

            const lien = document.createElement('a');
            lien.href = '/Inscription/TelechargerBillet?participantId=' + encodeURIComponent(participantId);
            lien.className = 'btn';
            lien.textContent = 'Telecharger mon billet';

            const zoneActions = document.querySelector('.confirmation-actions');
            if (zoneActions) {
                zoneActions.prepend(lien);
            }
        });
    </script>
}
