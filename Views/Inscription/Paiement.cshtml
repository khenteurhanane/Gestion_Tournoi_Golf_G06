@model croupe_06_TournoiGolf.Models.Participant
@{
    ViewData["Title"] = "Paiement";
}

<div class="payment-container">
    <div class="payment-card">
        <h1 class="payment-title">Finalisez votre inscription</h1>
        <p class="payment-subtitle">Tournoi : <strong>@Model.Tournoi.Nom</strong></p>
        
        <div class="payment-details">
            <div class="detail-row">
                <span>Type de participant:</span>
                <span class="detail-value">@Model.TypeParticipant.ToUpper()</span>
            </div>
            <hr />
            <div class="detail-row total-row">
                <span>Total à payer:</span>
                <span class="total-amount">@Model.MontantPaye.ToString("C")</span>
            </div>
        </div>

        <div class="payment-form-section mt-4">
            <h3 class="section-title">Mode de paiement</h3>
            
            <div class="payment-methods-tabs mb-4">
                <button type="button" class="method-tab active" onclick="switchPaymentMethod('card')">
                    <i class="fas fa-credit-card"></i> Carte Débit/Crédit
                </button>
                <button type="button" class="method-tab" onclick="switchPaymentMethod('interac')">
                    <i class="fas fa-exchange-alt"></i> Virement Interac
                </button>
            </div>

<form asp-action="SimulerPaiement" asp-route-participantId="@Model.ParticipantId" method="post" id="paymentForm">
                <input type="hidden" name="participantId" value="@Model.ParticipantId" />
                <input type="hidden" name="methodePaiement" id="methodePaiement" value="Carte de Crédit/Débit" />
                
                <!-- Section Carte -->
                <div id="cardSection">
                    <div class="form-group">
                        <label>Nom sur la carte</label>
                        <input type="text" value="@($"{Model.Utilisateur.Prenom} {Model.Utilisateur.Nom}")" required />
                    </div>
                    
                    <div class="form-group">
                        <label>Numéro de carte</label>
                        <div class="card-input-wrapper">
                            <input type="text" value="4540 1234 5678 9012" required />
                            <span class="card-type-icon">VISA</span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group col-half">
                            <label>Expiration</label>
                            <input type="text" value="12/28" required />
                        </div>
                        <div class="form-group col-half">
                            <label>CVV</label>
                            <input type="text" value="***" required />
                        </div>
                    </div>
                </div>

                <!-- Section Interac (Cachée par défaut) -->
                <div id="interacSection" style="display:none;">
                    <div class="interac-instructions">
                        <p class="mb-3">Pour finaliser votre inscription, veuillez effectuer un virement Interac aux coordonnées suivantes :</p>
                        <div class="interac-detail">
                            <strong>Courriel :</strong> <span>paiement@golfg06.com</span>
                        </div>
                        <div class="interac-detail">
                            <strong>Question :</strong> <span>Numéro de Tournoi</span>
                        </div>
                        <div class="interac-detail">
                            <strong>Réponse :</strong> <span>Golf2024</span>
                        </div>
                        <p class="mt-3 small text-muted">Note : Votre inscription sera confirmée une fois le virement reçu.</p>
                    </div>
                </div>

                <p class="text-muted small mb-3 text-start mt-3">
                    <i class="fas fa-lock"></i> Ceci est une simulation sécurisée pour le projet G06.
                </p>
                
                <button type="submit" class="btn btn-payment-simulate" id="submitBtn">
                    <span class="btn-text" id="btnText">Confirmer le paiement</span>
                    <span class="btn-icon">💳</span>
                    <div id="spinner" class="spinner-border spinner-border-sm ms-2" role="status" style="display:none;">
                      <span class="visually-hidden">Chargement...</span>
                    </div>
                </button>
            </form>

            <script>
                function switchPaymentMethod(method) {
                    const cardSection = document.getElementById('cardSection');
                    const interacSection = document.getElementById('interacSection');
                    const methodInput = document.getElementById('methodePaiement');
                    const tabs = document.querySelectorAll('.method-tab');
                    const btnIcon = document.querySelector('.btn-icon');
                    
                    tabs.forEach(tab => tab.classList.remove('active'));
                    
                    if (method === 'card') {
                        cardSection.style.display = 'block';
                        interacSection.style.display = 'none';
                        methodInput.value = "Carte de Crédit/Débit";
                        tabs[0].classList.add('active');
                        btnIcon.innerText = "💳";
                        // Re-ajouter les attributs 'required'
                        cardSection.querySelectorAll('input').forEach(i => i.required = true);
                    } else {
                        cardSection.style.display = 'none';
                        interacSection.style.display = 'block';
                        methodInput.value = "Virement Interac";
                        tabs[1].classList.add('active');
                        btnIcon.innerText = "📲";
                        // Enlever les attributs 'required' pour ne pas bloquer le formulaire
                        cardSection.querySelectorAll('input').forEach(i => i.required = false);
                    }
                }

                document.getElementById('paymentForm').addEventListener('submit', function(e) {
                    const btn = document.getElementById('submitBtn');
                    const text = document.getElementById('btnText');
                    const spinner = document.getElementById('spinner');
                    
                    e.preventDefault(); 
                    
                    btn.disabled = true;
                    text.innerText = "Déjà payé";
                    spinner.style.display = "inline-block";
                    btn.style.filter = "grayscale(0.5)";
                    
                    setTimeout(() => {
                        this.submit(); 
                    }, 1500);
                });
            </script>
        </div>
    </div>
</div>
