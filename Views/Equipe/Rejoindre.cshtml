@{
    ViewData["Title"] = "Rejoindre une equipe";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Rejoindre une équipe";
    var participantId = ViewBag.ParticipantId;
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-users",
        Eyebrow = "Code d'accès",
        Title = "Rejoindre une équipe",
        Description = "Entrez le code secret partagé par votre capitaine pour rejoindre le bon groupe."
    })

    <div class="app-grid-sidebar">
        <section class="app-surface-card app-form-card">
            <form action="/Equipe/Rejoindre" method="post" id="formRejoindre" class="app-form-card">
                @Html.AntiForgeryToken()
                <input type="hidden" name="participantId" value="@participantId" />

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <div class="form-group">
                    <label>Code secret de l'équipe</label>
                    <input name="codeSecret"
                           type="text"
                           placeholder="ABC123"
                           required
                           maxlength="6"
                           autocomplete="off"
                           class="text-uppercase"
                           oninput="this.value = this.value.toUpperCase(); validateCode(this)" />
                    <p class="app-field-hint"><span id="charCount">0/6</span> caractères alphanumériques.</p>
                </div>

                <div class="app-actions">
                    <button class="btn" type="submit">Rejoindre maintenant</button>
                    <a href="/Auth/MesInscriptions" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </section>

        <aside class="app-surface-card app-progress-card">
            <span class="app-section-eyebrow"><i class="fas fa-circle-info"></i> Avant de continuer</span>
            <div class="app-detail-list">
                <div class="app-detail-row">
                    <strong>Demandez le code</strong>
                    <span>Le capitaine de l'équipe doit vous le transmettre.</span>
                </div>
                <div class="app-detail-row">
                    <strong>Vérifiez le tournoi</strong>
                    <span>Le code ne fonctionne que pour l'équipe liée à votre inscription.</span>
                </div>
                <div class="app-detail-row">
                    <strong>En cas d'erreur</strong>
                    <span>Revenez à vos inscriptions et reprenez le flux.</span>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        function validateCode(input) {
            document.getElementById('charCount').innerText = input.value.length + '/6';
        }

        document.addEventListener('DOMContentLoaded', function () {
            const input = document.querySelector('input[name="codeSecret"]');
            if (input) validateCode(input);
        });
    </script>
}
