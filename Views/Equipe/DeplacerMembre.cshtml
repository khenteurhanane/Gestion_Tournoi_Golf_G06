@{
    ViewData["Title"] = "Déplacer un joueur";
    var participant = (croupe_06_TournoiGolf.Models.Participant)ViewBag.Participant;
    var equipeActuelle = (croupe_06_TournoiGolf.Models.Equipe)ViewBag.EquipeActuelle;
    var autresEquipes = (List<croupe_06_TournoiGolf.Models.Equipe>)ViewBag.AutresEquipes;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-exchange-alt"></i> Déplacer un joueur</h1>
    <a href="/Equipe/Gestion/@equipeActuelle.EquipeId" class="btn btn-secondary">Retour à l'équipe</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card mb-4">
            <h3>
                <i class="fas fa-user"></i>
                @participant.Utilisateur?.Prenom @participant.Utilisateur?.Nom
            </h3>
            <p class="text-muted">Actuellement dans : <strong>@equipeActuelle.NomEquipe</strong></p>

            @if (autresEquipes.Count == 0)
            {
                <div class="alert alert-warning">
                    Aucune autre équipe disponible dans ce tournoi (toutes sont complètes ou inexistantes).
                </div>
                <a href="/Equipe/Gestion/@equipeActuelle.EquipeId" class="btn btn-secondary w-100">Retour</a>
            }
            else
            {
                <form action="/Equipe/DeplacerMembre" method="post">
                    <input type="hidden" name="participantId" value="@participant.ParticipantId" />
                    <input type="hidden" name="equipeId" value="@equipeActuelle.EquipeId" />

                    <div class="form-group mb-3">
                        <label>Choisir l'équipe de destination</label>
                        <select name="nouvelleEquipeId" class="form-control" required>
                            <option value="">-- Sélectionner une équipe --</option>
                            @foreach (var e in autresEquipes)
                            {
                                <option value="@e.EquipeId">@e.NomEquipe (Code : @e.CodeSecret)</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"
                            onclick="return confirm('Confirmer le déplacement du joueur ?');">
                        <i class="fas fa-check"></i> Confirmer le déplacement
                    </button>
                </form>
            }
        </div>
    </div>
</div>
