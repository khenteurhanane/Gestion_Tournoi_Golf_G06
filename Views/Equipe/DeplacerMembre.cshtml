@model croupe_06_TournoiGolf.Models.Participant
@{
    ViewData["Title"] = "Deplacer un membre";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Déplacer un membre";
    var autresEquipes = (List<croupe_06_TournoiGolf.Models.Equipe>)ViewBag.AutresEquipes;
    var equipeActuelle = (croupe_06_TournoiGolf.Models.Equipe)ViewBag.EquipeActuelle;
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-right-left",
        Eyebrow = "Gestion d'équipe",
        Title = "Déplacer un membre",
        Description = $"Déplacez {(Model.Utilisateur?.Prenom ?? Model.Prenom)} {(Model.Utilisateur?.Nom ?? Model.Nom)} vers une autre équipe du même tournoi."
    })

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <section class="app-surface-card app-form-card">
        <div class="app-detail-list">
            <div class="app-detail-row">
                <strong>Équipe actuelle</strong>
                <span>@equipeActuelle.NomEquipe</span>
            </div>
            <div class="app-detail-row">
                <strong>Membre</strong>
                <span>@(Model.Utilisateur?.Prenom ?? Model.Prenom) @(Model.Utilisateur?.Nom ?? Model.Nom)</span>
            </div>
        </div>

        @if (autresEquipes.Count == 0)
        {
            <div class="alert alert-warning">Aucune autre équipe disponible avec de la place dans ce tournoi.</div>
        }
        else
        {
            <form action="/Equipe/DeplacerMembre" method="post" class="app-form-card">
                <input type="hidden" name="participantId" value="@Model.ParticipantId" />
                <input type="hidden" name="equipeSourceId" value="@equipeActuelle.EquipeId" />

                <div class="form-group">
                    <label>Choisir l'équipe de destination</label>
                    <select name="equipeCibleId" required>
                        <option value="">-- Sélectionner une équipe --</option>
                        @foreach (var e in autresEquipes)
                        {
                            <option value="@e.EquipeId">@e.NomEquipe</option>
                        }
                    </select>
                </div>

                <div class="app-actions">
                    <button type="submit" class="btn">Confirmer le déplacement</button>
                    <a href="/Equipe/Gestion/@equipeActuelle.EquipeId" class="btn btn-secondary">Retour à la gestion</a>
                </div>
            </form>
        }
    </section>
</section>
