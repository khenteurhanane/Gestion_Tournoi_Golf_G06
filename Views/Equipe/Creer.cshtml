@model croupe_06_TournoiGolf.Models.Equipe

@{
    ViewData["Title"] = "Créer une équipe";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card">
            <h2>Créer une équipe</h2>
            <p class="sub">Ton code secret sera généré automatiquement.</p>

            <form action="/Equipe/Creer" method="post">
                @if (Model.TournoiId > 0)
                {
                    <input type="hidden" name="TournoiId" value="@Model.TournoiId" />
                }
                else
                {
                    <div class="form-group mb-3">
                        <label>Choisir un tournoi</label>
                        <select name="TournoiId" class="form-control" required style="padding: 12px; border-radius: 8px; border: 1px solid #ddd; width: 100%;">
                            <option value="">-- Sélectionner un tournoi --</option>
                            @foreach (var t in (List<Tournoi>)ViewBag.ListeTournois)
                            {
                                <option value="@t.TournoiId">@t.Nom (@t.DateTournoi.ToShortDateString())</option>
                            }
                        </select>
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="error" style="color:red; margin-bottom:15px;">@ViewBag.Error</div>
                }

                <div class="form-group">
                    <label>Nom de l'équipe</label>
                    <input name="NomEquipe" type="text" placeholder="Ex: Les Aigles" value="@Model.NomEquipe" required />
                </div>

                <div class="form-group">
                    <label>Code secret de l'équipe</label>
                    <div class="input-group">
                        <input name="CodeSecret" id="codeEquipe" type="text" value="@Model.CodeSecret" readonly class="form-control" style="background-color:#f0f4ec; font-weight:bold; letter-spacing:3px;" />
                        <button type="button" class="btn btn-outline-secondary" onclick="copierCode()">Copier le code</button>
                    </div>
                    <small>Ce code sera partagé avec tes coéquipiers pour rejoindre l'équipe.</small>
                </div>

                <script>
                function copierCode() {
                    var code = document.getElementById("codeEquipe");
                    code.select();
                    code.setSelectionRange(0, 99999);
                    navigator.clipboard.writeText(code.value);
                    alert("Code copié !");
                }
                </script>

                <button class="btn" type="submit">Créer l'équipe</button>
            </form>

            <div class="footer">
                <a href="/Inscription/Index">Retour à l'inscription</a>
            </div>
        </div>

    </div>
</div>
