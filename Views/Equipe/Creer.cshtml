@model croupe_06_TournoiGolf.Models.Equipe

@{
    ViewData["Title"] = "Créer une équipe";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card">
            <h2>Créer une équipe</h2>
            <p class="sub">Ton code secret sera généré automatiquement.</p>

            <form action="/Equipe/Creer" method="post">
                <input type="hidden" name="TournoiId" value="@Model.TournoiId" />

                @if (ViewBag.Error != null)
                {
                    <div class="error" style="color:red; margin-bottom:15px;">@ViewBag.Error</div>
                }

                <div class="form-group">
                    <label>Nom de l'équipe</label>
                    <input name="NomEquipe" type="text" placeholder="Ex: Les Aigles" value="@Model.NomEquipe" required />
                </div>

                <div class="form-group">
                    <label>Code secret de l'équipe</label>
                    <input name="CodeSecret" type="text" value="@Model.CodeSecret" readonly style="background-color:#f0f0f0; font-weight:bold; letter-spacing:3px;" />
                    <small>Ce code sera partagé avec tes coéquipiers pour rejoindre l'équipe.</small>
                </div>

                <button class="btn" type="submit">Créer l'équipe</button>
            </form>

            <div class="footer">
                <a href="/Inscription/Index">Retour à l'inscription</a>
            </div>
        </div>

    </div>
</div>
