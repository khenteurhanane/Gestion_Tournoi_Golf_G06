@model croupe_06_TournoiGolf.Models.Equipe

@{
    ViewData["Title"] = "Creer une equipe";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Créer une équipe";
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-user-friends",
        Eyebrow = "Nouvelle équipe",
        Title = "Créez votre équipe",
        Description = "Définissez le nom de votre groupe. Un code secret sera généré automatiquement pour permettre aux autres joueurs de vous rejoindre."
    })

    <div class="app-grid-sidebar">
        <section class="app-surface-card app-form-card">
            <form action="/Equipe/Creer" method="post" class="app-form-card">
                @Html.AntiForgeryToken()
                @if (Model.TournoiId > 0)
                {
                    <input type="hidden" name="TournoiId" value="@Model.TournoiId" />
                }
                else
                {
                    <div class="form-group">
                        <label>Choisir un tournoi</label>
                        <select name="TournoiId" required>
                            <option value="">-- Sélectionner un tournoi --</option>
                            @foreach (var t in (List<Tournoi>)ViewBag.ListeTournois)
                            {
                                <option value="@t.TournoiId">@t.Nom (@t.DateTournoi.ToShortDateString())</option>
                            }
                        </select>
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mb-0">@ViewBag.Error</div>
                }

                <div class="form-group">
                    <label>Nom de l'équipe</label>
                    <input asp-for="NomEquipe" type="text" placeholder="Ex: Les Aigles" required />
                    <span asp-validation-for="NomEquipe" class="text-danger validation-inline"></span>
                </div>

                <div class="form-group">
                    <label>Code secret de l'équipe</label>
                    <div class="app-highlight-panel app-highlight-panel--compact">
                        <span class="app-highlight-panel__code-label">Code généré</span>
                        <div class="app-highlight-panel__code mt-0">
                            <div class="app-highlight-panel__code-value" id="codeEquipe">@Model.CodeSecret</div>
                            <button type="button" class="btn" onclick="copierCode()">Copier le code</button>
                        </div>
                    </div>
                    <p class="app-field-hint mt-2">Ce code devra être partagé avec les coéquipiers qui veulent rejoindre votre groupe.</p>
                </div>

                <div class="app-actions">
                    <button class="btn" type="submit">Créer l'équipe</button>
                    <a href="/Inscription/Index" class="btn btn-secondary">Retour à l'inscription</a>
                </div>
            </form>
        </section>

        <aside class="app-surface-card app-progress-card">
            <span class="app-section-eyebrow"><i class="fas fa-lightbulb"></i> Conseils</span>
            <div class="app-detail-list">
                <div class="app-detail-row">
                    <strong>Capitaine</strong>
                    <span>Le créateur devient automatiquement capitaine.</span>
                </div>
                <div class="app-detail-row">
                    <strong>Code</strong>
                    <span>Il sert à rejoindre l'équipe sans erreur de tournoi.</span>
                </div>
                <div class="app-detail-row">
                    <strong>Suite</strong>
                    <span>Vous pourrez gérer ou déplacer les membres plus tard.</span>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copierCode() {
            const code = document.getElementById('codeEquipe');
            if (!code) return;
            navigator.clipboard.writeText(code.innerText.trim());
        }
    </script>
}
