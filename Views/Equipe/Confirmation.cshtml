@model croupe_06_TournoiGolf.Models.Equipe

@{
    ViewData["Title"] = "Equipe creee";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Équipe créée";
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-check-circle",
        Eyebrow = "Succès",
        Title = "Votre équipe est prête",
        Description = "Le code secret ci-dessous peut maintenant être partagé avec les autres joueurs du groupe."
    })

    <section class="app-highlight-panel">
        <h2>@Model.NomEquipe</h2>
        <p>Utilisez ce code pour faire rejoindre vos coéquipiers rapidement et sans ambiguïté.</p>

        <div class="app-highlight-panel__code">
            <div>
                <span class="app-highlight-panel__code-label">Code secret</span>
                <div class="app-highlight-panel__code-value" id="codeEquipe">@Model.CodeSecret</div>
            </div>
            <button class="btn" type="button" onclick="copierCode()">Copier le code</button>
        </div>

        <div class="app-actions mt-4">
            <a href="/Equipe/Index" class="btn">Voir mes équipes</a>
            <a href="/Inscription/Index" class="btn btn-secondary">Retour à l'inscription</a>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        function copierCode() {
            const code = document.getElementById('codeEquipe');
            if (!code) return;
            navigator.clipboard.writeText(code.innerText.trim());
        }
    </script>
}
