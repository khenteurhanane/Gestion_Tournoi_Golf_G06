@{
    ViewData["Title"] = "Confirmation de commande";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Confirmation boutique";
    var montantPaye = TempData["MontantPaye"];
    var modePaiement = TempData["ModePaiement"];
    var commandeId = TempData["CommandeId"];
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-bag-shopping",
        Eyebrow = "Commande confirmée",
        Title = "Paiement réussi",
        Description = "Votre réservation de matériel et de restauration a bien été enregistrée."
    })

    <section class="app-surface-card app-receipt-card">
        <div class="app-receipt-grid">
            <div class="app-detail-row">
                <strong>Montant payé</strong>
                <span>@montantPaye $</span>
            </div>
            <div class="app-detail-row">
                <strong>Mode de paiement</strong>
                <span>@modePaiement</span>
            </div>
            <div class="app-detail-row">
                <strong>Date</strong>
                <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        <div class="app-actions mt-4">
            @if (commandeId != null)
            {
                <a href="/Boutique/TelechargerRecu?commandeId=@commandeId" class="btn">Télécharger mon reçu</a>
            }
            <a href="/Boutique/Index" class="btn btn-secondary">Retour à la boutique</a>
            <a href="/" class="btn btn-secondary">Retour à l'accueil</a>
        </div>
    </section>
</section>
