@model croupe_06_TournoiGolf.Models.ViewModels.PaiementBoutiqueViewModel
@{
    ViewData["Title"] = "Paiement - Boutique";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Paiement boutique";
}

<section class="app-page-shell app-page-shell--narrow">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-credit-card",
        Eyebrow = "Boutique",
        Title = "Paiement sécurisé",
        Description = "Finalisez votre commande de matériel et de restauration avec un parcours de paiement simple et cohérent."
    })

    <div class="app-grid-sidebar">
        <section class="app-surface-card app-form-card">
            <div class="app-kpi-card">
                <span class="app-kpi-card__label">Total à payer</span>
                <span class="app-kpi-card__value">@Model.Panier.TotalFinal.ToString("C")</span>
            </div>

            <form action="/Boutique/ConfirmerPaiement" method="post" class="app-form-card">
                @Html.AntiForgeryToken()

                <div class="app-actions">
                    <label class="app-pill">
                        <input type="radio" name="ModePaiement" value="carte" checked>
                        Carte de crédit / débit
                    </label>
                    <label class="app-pill">
                        <input type="radio" name="ModePaiement" value="interac">
                        Virement Interac
                    </label>
                </div>

                <div id="formCarte" class="app-form-grid">
                    <div class="form-group">
                        <label>Nom sur la carte</label>
                        <input type="text" placeholder="Ex: Jean Tremblay" required>
                    </div>
                    <div class="form-group">
                        <label>Numéro de carte</label>
                        <input type="text" placeholder="XXXX XXXX XXXX XXXX" required>
                    </div>
                    <div class="form-group">
                        <label>Expiration</label>
                        <input type="text" placeholder="MM/AA" required>
                    </div>
                    <div class="form-group">
                        <label>CVC</label>
                        <input type="text" placeholder="123" required>
                    </div>
                </div>

                <div class="app-actions">
                    <a href="/Boutique/Panier" class="btn btn-secondary">Retour au panier</a>
                    <button type="submit" class="btn" id="submitBtn">
                        <span id="btnText">Payer @Model.Panier.TotalFinal.ToString("C")</span>
                        <span id="spinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                    </button>
                </div>
            </form>
        </section>

        <aside class="app-surface-card app-progress-card">
            <span class="app-section-eyebrow"><i class="fas fa-bag-shopping"></i> Résumé de commande</span>
            <div class="app-detail-list">
                <div class="app-detail-row">
                    <strong>Sous-total</strong>
                    <span>@Model.Panier.SousTotal.ToString("C")</span>
                </div>
                @if (Model.Panier.EstEtudiantLaCite)
                {
                    <div class="app-detail-row">
                        <strong>Rabais</strong>
                        <span>-@Model.Panier.Rabais.ToString("C")</span>
                    </div>
                }
                <div class="app-detail-row">
                    <strong>Taxes</strong>
                    <span>@Model.Panier.Taxes.ToString("C")</span>
                </div>
                <div class="app-detail-row">
                    <strong>Total</strong>
                    <span>@Model.Panier.TotalFinal.ToString("C")</span>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            const text = document.getElementById('btnText');
            const spinner = document.getElementById('spinner');

            btn.disabled = true;
            text.innerText = 'Paiement en cours';
            spinner.classList.remove('d-none');
        });

        document.querySelectorAll('input[name="ModePaiement"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const formCarte = document.getElementById('formCarte');
                if (this.value === 'interac') {
                    formCarte.classList.add('d-none');
                    formCarte.querySelectorAll('input').forEach(i => i.removeAttribute('required'));
                } else {
                    formCarte.classList.remove('d-none');
                    formCarte.querySelectorAll('input').forEach(i => i.setAttribute('required', 'required'));
                }
            });
        });
    </script>
}
