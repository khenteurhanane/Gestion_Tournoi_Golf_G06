@model croupe_06_TournoiGolf.Models.ViewModels.PanierViewModel
@{
    ViewData["Title"] = "Mon Panier";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Panier";
}

<section class="app-page-shell app-page-shell--wide">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-shopping-cart",
        Eyebrow = "Boutique",
        Title = "Mon panier",
        Description = "Vérifiez vos articles, ajustez votre sélection et passez au paiement."
    })

    @if (!Model.Items.Any())
    {
        @await Html.PartialAsync("_EmptyState", new croupe_06_TournoiGolf.Models.ViewModels.EmptyStateViewModel
        {
            Icon = "fas fa-shopping-basket",
            Title = "Votre panier est vide",
            Description = "Ajoutez du matériel ou de la restauration depuis la boutique pour préparer votre journée de tournoi.",
            PrimaryLabel = "Retour à la boutique",
            PrimaryHref = "/Boutique/Index"
        })
    }
    else
    {
        <div class="app-grid-sidebar">
            <section class="app-surface-card app-table-card">
                <div class="app-table-card__header">
                    <div>
                        <h2>Articles sélectionnés</h2>
                        <p class="app-muted-note">@Model.Items.Sum(i => i.Quantite) article(s) dans votre panier</p>
                    </div>
                    <form action="/Boutique/ViderPanier" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary">Vider le panier</button>
                    </form>
                </div>

                <div class="app-table-wrap">
                    <table class="app-data-table">
                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Prix</th>
                                <th>Quantité</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Article.Nom</strong>
                                        <div class="app-muted-note">@item.Article.Categorie</div>
                                    </td>
                                    <td>@item.Article.Prix.ToString("C")</td>
                                    <td><span class="app-pill">@item.Quantite</span></td>
                                    <td><strong>@item.Total.ToString("C")</strong></td>
                                    <td>
                                        <form action="/Boutique/RetirerDuPanier" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Article.Id" />
                                            <button type="submit" class="btn btn-danger">Retirer</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <aside class="app-surface-card app-progress-card">
                <span class="app-section-eyebrow"><i class="fas fa-receipt"></i> Résumé</span>
                <div class="app-detail-list">
                    <div class="app-detail-row">
                        <strong>Sous-total</strong>
                        <span>@Model.SousTotal.ToString("C")</span>
                    </div>
                    @if (Model.EstEtudiantLaCite)
                    {
                        <div class="app-detail-row">
                            <strong>Rabais étudiant</strong>
                            <span>-@Model.Rabais.ToString("C")</span>
                        </div>
                    }
                    <div class="app-detail-row">
                        <strong>Taxes</strong>
                        <span>@Model.Taxes.ToString("C")</span>
                    </div>
                    <div class="app-detail-row">
                        <strong>Total final</strong>
                        <span>@Model.TotalFinal.ToString("C")</span>
                    </div>
                </div>

                <div class="app-actions">
                    <a href="/Boutique/Paiement" class="btn">Procéder au paiement</a>
                    <a href="/Boutique/Index" class="btn btn-secondary">Continuer mes achats</a>
                </div>
            </aside>
        </div>
    }
</section>
