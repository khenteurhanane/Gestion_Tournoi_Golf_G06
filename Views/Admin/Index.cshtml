@{
    ViewData["Title"] = "Espace Administrateur";
    var prochains = ViewBag.ProchainsTournois as List<croupe_06_TournoiGolf.Models.Tournoi>;
    var inscriptionsRecentes = ViewBag.InscriptionsRecentes as List<croupe_06_TournoiGolf.Models.Participant>;
    var tournoiStatus = ViewBag.TournoiStatus as List<croupe_06_TournoiGolf.Models.TournoiStatusViewModel>;
    var commanditaires = ViewBag.Commanditaires as List<croupe_06_TournoiGolf.Models.Commandite>;
}

<div class="dashboard-header mb-4">
    <div>
        <h1 class="fw-bold">Tableau de bord <span class="text-success">Admin</span></h1>
        <p class="text-muted">Vue d'ensemble de l'activité des tournois</p>
    </div>
    </div>
</div>

@if (ViewBag.NbEquipesIncompletes > 0)
{
    <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center p-3 animate__animated animate__fadeInDown" style="background: rgba(243, 156, 18, 0.1); border-left: 5px solid #f39c12 !important;">
        <div class="alert-icon me-3 bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; min-width: 40px;">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="flex-grow-1">
            <h5 class="mb-0 fw-bold text-dark">Équipes incomplètes détectées</h5>
            <p class="mb-0 text-muted small">Il y a actuellement <strong>@ViewBag.NbEquipesIncompletes</strong> équipes qui n'ont pas encore atteint leur nombre maximal de joueurs.</p>
        </div>
        <div>
            <a href="/Admin/Equipes" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">Gérer</a>
        </div>
    </div>
}

    <!-- Statistiques -->
    <div class="stats-grid">
        <div class="stat-premium-card">
            <div class="stat-icon"><i class="fas fa-trophy"></i></div>
            <div class="stat-info">
                <h3>@ViewBag.NbTournois</h3>
                <p>Tournois Totaux</p>
            </div>
            <div class="stat-trend">+@ViewBag.NbTournoisOuverts actifs</div>
        </div>
        <div class="stat-premium-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-info">
                <h3>@ViewBag.NbParticipants</h3>
                <p>Inscriptions</p>
            </div>
        </div>
        <div class="stat-premium-card">
            <div class="stat-icon"><i class="fas fa-user-friends"></i></div>
            <div class="stat-info">
                <h3>@ViewBag.NbUtilisateurs</h3>
                <p>Utilisateurs</p>
            </div>
        </div>
        <div class="stat-premium-card">
            <div class="stat-icon"><i class="fas fa-dollar-sign"></i></div>
            <div class="stat-info">
                <h3>@(((decimal)ViewBag.RevenuTotal).ToString("C"))</h3>
                <p>Revenus</p>
            </div>
        </div>
        <div class="stat-premium-card">
            <div class="stat-icon" style="background: rgba(46,204,113,0.1); color: #27ae60;"><i class="fas fa-users"></i></div>
            <div class="stat-info">
                <h3>@ViewBag.NbEquipes</h3>
                <p>Équipes</p>
                <div class="stat-equipes-detail mt-1">
                    <span class="badge-completes me-2">
                        <i class="fas fa-check-circle"></i> @ViewBag.NbEquipesCompletes complètes
                    </span>
                    <span class="badge-incompletes">
                        <i class="fas fa-exclamation-circle"></i> @ViewBag.NbEquipesIncompletes incomplètes
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-main-grid">
        <!-- Section Gauche -->
        <div class="grid-col-8">
            <!-- Prochains Tournois et Occupation -->
            <div class="premium-card">
                <div class="card-header">
                    <h3><i class="fas fa-calendar-alt"></i> État des Tournois</h3>
                </div>
                <div class="occupation-list">
                    @if (tournoiStatus != null && tournoiStatus.Any())
                    {
                        @foreach (var ts in tournoiStatus)
                        {
                            var percentage = ts.PlacesParticipantsMax > 0 ? (ts.NbInscrits * 100) / ts.PlacesParticipantsMax : 0;
                            <div class="occupation-item">
                                <div class="occ-info">
                                    <span class="occ-name">@ts.Nom</span>
                                    <span class="occ-count">@ts.NbInscrits / @ts.PlacesParticipantsMax</span>
                                </div>
                                <div class="progress-bar-bg">
                                    <div class="progress-bar-fill" style="width: @(percentage)%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Aucun tournoi actif.</p>
                    }
                </div>
            </div>

            <div class="premium-card mt-20">
                <div class="card-header">
                    <h3><i class="fas fa-list"></i> Liste des Prochains Tournois</h3>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Date</th>
                            <th>Lieu</th>
                            <th>Statut</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (prochains != null && prochains.Any())
                        {
                            @foreach (var t in prochains)
                            {
                                <tr>
                                    <td class="font-bold">@t.Nom</td>
                                    <td>@t.DateTournoi.ToShortDateString()</td>
                                    <td>@t.Lieu</td>
                                    <td>
                                        @if (t.EstEnCours)
                                        {
                                            <span class="badge badge-en-cours">En cours</span>
                                        }
                                        else if (t.InscriptionsOuvertes)
                                        {
                                            <span class="badge badge-ouvert">Ouvert</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-ferme">Fermé</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Tournoi/Edit/@t.TournoiId" class="btn-icon" title="Modifier"><i class="fas fa-edit"></i></a>
                                        <a href="/Tournoi/Details/@t.TournoiId" class="btn-icon" title="Détails"><i class="fas fa-eye"></i></a>
                                        
                                        <form asp-action="CompleterEquipes" asp-controller="Admin" method="post" style="display:inline;">
                                            <input type="hidden" name="tournoiId" value="@t.TournoiId" />
                                            <button type="submit" class="btn-icon text-warning border-0 bg-transparent" style="cursor: pointer;" title="Affectation auto des équipes" onclick="return confirm('Voulez-vous répartir tous les étudiants sans équipe du tournoi ?');">
                                                <i class="fas fa-magic"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center">Aucun tournoi à venir.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section Droite -->
        <div class="grid-col-4">
            <!-- Actions Rapides -->
            <div class="premium-card accent">
                <div class="card-header">
                    <h3><i class="fas fa-bolt"></i> Actions Rapides</h3>
                </div>
                <div class="quick-actions">
                    <a href="/Tournoi/Index" class="qa-item">
                        <i class="fas fa-cog"></i> Gérer les tournois
                    </a>
                    <a href="/Admin/Utilisateurs" class="qa-item">
                        <i class="fas fa-user-shield"></i> Gérer les utilisateurs
                    </a>
                    <a href="/Admin/Participants" class="qa-item">
                        <i class="fas fa-id-card"></i> Gérer les participants
                    </a>
                    <a href="/Admin/Equipes" class="qa-item">
                        <i class="fas fa-flag"></i> Gérer les équipes
                    </a>
                    <a href="/Commandite/Index" class="qa-item">
                        <i class="fas fa-handshake"></i> Commandites
                    </a>
                    <a href="/Score/Tableau" class="qa-item">
                        <i class="fas fa-golf-ball"></i> Tableau des scores
                    </a>
                </div>
            </div>

            <!-- Inscriptions Récentes -->
            <div class="premium-card mt-20">
                <div class="card-header">
                    <h3><i class="fas fa-history"></i> Inscriptions Récentes</h3>
                </div>
                <div class="recent-list">
                    @if (inscriptionsRecentes != null && inscriptionsRecentes.Any())
                    {
                        @foreach (var ins in inscriptionsRecentes)
                        {
                            <div class="recent-item">
                                <div class="recent-icon"><i class="fas fa-user-plus"></i></div>
                                <div class="recent-details">
                                    <span class="recent-user">@(ins.Utilisateur?.Prenom ?? ins.Prenom) @(ins.Utilisateur?.Nom ?? ins.Nom)</span>
                                    <span class="recent-tournoi">@ins.Tournoi.Nom</span>
                                    <span class="recent-time">@ins.CreeLe.ToShortDateString()</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Aucune inscription récente.</p>
                    }
                </div>
            </div>

            <!-- Commanditaires (US-13) -->
            <div class="premium-card mt-20">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3><i class="fas fa-handshake"></i> Commanditaires</h3>
                    <a href="/Commandite/Index" class="btn btn-sm btn-outline-success rounded-pill px-3" style="font-size:0.75rem;">Voir tout</a>
                </div>
                <div class="commanditaires-list">
                    @if (commanditaires != null && commanditaires.Any())
                    {
                        @foreach (var c in commanditaires)
                        {
                            <div class="commanditaire-item">
                                <div class="commanditaire-badge @c.TypeCommandite.ToLower()">
                                    @c.TypeCommandite.Substring(0, 1)
                                </div>
                                <div class="commanditaire-details">
                                    <span class="commanditaire-nom">@c.Utilisateur?.Prenom @c.Utilisateur?.Nom</span>
                                    <span class="commanditaire-meta">@c.TypeCommandite · @c.Tournoi?.Nom</span>
                                </div>
                                <span class="commanditaire-montant">@c.Montant.ToString("C")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Aucun commanditaire enregistré.</p>
                    }
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

