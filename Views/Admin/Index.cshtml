@model croupe_06_TournoiGolf.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Espace Administrateur";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Administration";
    ViewData["CompactTopbarSubtitle"] = "Pilotage global";
    var header = new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-chart-pie",
        Eyebrow = "Administration",
        Title = "Tableau de bord admin",
        Description = "Suivez les tournois, les inscriptions, les equipes et les revenus depuis une vue centrale coherente avec le reste de l'application."
    };
}

<section class="admin-dashboard-shell">
    @await Html.PartialAsync("_AppSectionHeader", header)

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-warning">@TempData["Info"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <section class="app-surface-card">
        <div class="app-actions">
            <a href="/Tournoi/Index" class="btn">Gerer les tournois</a>
            <a href="/Admin/Utilisateurs" class="btn btn-secondary">Utilisateurs</a>
            <a href="/Admin/Participants" class="btn btn-secondary">Participants</a>
            <a href="/Admin/Equipes" class="btn btn-secondary">Equipes</a>
            @if (Model.TournoiScoreActifId.HasValue)
            {
                <a href="/Score/Saisie/@Model.TournoiScoreActifId.Value" class="btn btn-secondary">Saisir les scores</a>
                <a href="/Score/Tableau/@Model.TournoiScoreActifId.Value" class="btn btn-secondary">Classement live</a>
            }
        </div>
    </section>

    @if (Model.TournoisAvecEquipesIncompletes.Any())
    {
        <section class="app-surface-card app-table-card">
            <div class="app-table-card__header">
                <div>
                    <h2>Completer les equipes</h2>
                    <p class="app-muted-note">Le matchmaking admin est maintenant branche pour les tournois qui ont des equipes incompletes ou des joueurs solos regroupables.</p>
                </div>
            </div>

            <div class="admin-list admin-list--carded">
                @foreach (var tournoi in Model.TournoisAvecEquipesIncompletes)
                {
                    <div class="admin-list__item admin-list__item--stack">
                        <div class="admin-list__meta">
                            <strong>@tournoi.NomTournoi</strong>
                            <span>@tournoi.EquipesIncompletes equipe(s) incomplete(s) - @tournoi.JoueursSoloDisponibles joueur(s) solo regroupable(s)</span>
                            @if (!tournoi.PeutCompleterAutomatiquement)
                            {
                                <span class="app-muted-note">@tournoi.MessageDisponibilite</span>
                            }
                        </div>
                        <div class="app-inline-actions">
                            <a href="/Tournoi/Details/@tournoi.TournoiId" class="btn btn-secondary">Voir le tournoi</a>
                            @if (tournoi.PeutCompleterAutomatiquement)
                            {
                                <form action="/Admin/CompleterEquipes" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tournoiId" value="@tournoi.TournoiId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn">Completer automatiquement</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="admin-kpi-grid">
        <article class="admin-kpi-card">
            <span class="admin-kpi-card__icon"><i class="fas fa-trophy"></i></span>
            <div class="admin-kpi-card__value">@Model.NbTournois</div>
            <span class="admin-kpi-card__label">Tournois</span>
        </article>
        <article class="admin-kpi-card">
            <span class="admin-kpi-card__icon"><i class="fas fa-users"></i></span>
            <div class="admin-kpi-card__value">@Model.NbParticipants</div>
            <span class="admin-kpi-card__label">Inscriptions</span>
        </article>
        <article class="admin-kpi-card">
            <span class="admin-kpi-card__icon"><i class="fas fa-user-friends"></i></span>
            <div class="admin-kpi-card__value">@Model.NbEquipes</div>
            <span class="admin-kpi-card__label">Equipes</span>
        </article>
        <article class="admin-kpi-card">
            <span class="admin-kpi-card__icon"><i class="fas fa-dollar-sign"></i></span>
            <div class="admin-kpi-card__value">@Model.RevenuTotal.ToString("C")</div>
            <span class="admin-kpi-card__label">Revenus</span>
        </article>
    </section>

    <div class="admin-dashboard-grid">
        <div class="app-page-shell">
            <section class="app-surface-card">
                <span class="app-section-eyebrow"><i class="fas fa-wave-square"></i> Etat des tournois</span>
                <div class="admin-list">
                    @if (Model.TournoiStatus.Any())
                    {
                        @foreach (var ts in Model.TournoiStatus)
                        {
                            var percentage = ts.PlacesParticipantsMax > 0 ? (ts.NbInscrits * 100) / ts.PlacesParticipantsMax : 0;
                            <div class="admin-list__item">
                                <div class="admin-list__meta">
                                    <strong>@ts.Nom</strong>
                                    <span>@ts.NbInscrits / @ts.PlacesParticipantsMax inscrit(s)</span>
                                </div>
                                <div class="app-progress" style="width: 180px;"><span style="width:@percentage%"></span></div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="app-muted-note">Aucun tournoi actif.</p>
                    }
                </div>
            </section>

            <section class="app-surface-card app-table-card">
                <div class="app-table-card__header">
                    <div>
                        <h2>Prochains tournois</h2>
                        <p class="app-muted-note">Pilotage et actions rapides</p>
                    </div>
                </div>

                <div class="app-table-wrap">
                    <table class="app-data-table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Date</th>
                                <th>Lieu</th>
                                <th>Statut</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ProchainsTournois.Any())
                            {
                                @foreach (var tournoi in Model.ProchainsTournois)
                                {
                                    <tr>
                                        <td><strong>@tournoi.Nom</strong></td>
                                        <td>@tournoi.DateTournoi.ToShortDateString()</td>
                                        <td>@tournoi.Lieu</td>
                                        <td>
                                            @if (tournoi.EstEnCours)
                                            {
                                                <span class="app-status-badge app-status-badge--warning">En cours</span>
                                            }
                                            else if (tournoi.InscriptionsOuvertes)
                                            {
                                                <span class="app-status-badge app-status-badge--success">Ouvert</span>
                                            }
                                            else
                                            {
                                                <span class="app-status-badge app-status-badge--danger">Ferme</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="app-inline-actions">
                                                <a href="/Tournoi/Edit/@tournoi.TournoiId" class="btn btn-secondary">Modifier</a>
                                                <a href="/Tournoi/Details/@tournoi.TournoiId" class="btn btn-secondary">Details</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5">Aucun tournoi a venir.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="app-page-shell">
            <section class="app-surface-card">
                <span class="app-section-eyebrow"><i class="fas fa-bolt"></i> Actions rapides</span>
                <div class="app-actions">
                    <a href="/Tournoi/Index" class="btn btn-secondary">Tournois</a>
                    <a href="/Admin/Utilisateurs" class="btn btn-secondary">Utilisateurs</a>
                    <a href="/Admin/Participants" class="btn btn-secondary">Participants</a>
                    <a href="/Admin/Equipes" class="btn btn-secondary">Equipes</a>
                    <a href="/Commandite/Index" class="btn btn-secondary">Commandites</a>
                    @if (Model.TournoiScoreActifId.HasValue)
                    {
                        <a href="/Score/Saisie/@Model.TournoiScoreActifId.Value" class="btn btn-secondary">Scores</a>
                    }
                </div>
            </section>

            <section class="app-surface-card">
                <span class="app-section-eyebrow"><i class="fas fa-history"></i> Inscriptions recentes</span>
                <div class="admin-list">
                    @if (Model.InscriptionsRecentes.Any())
                    {
                        @foreach (var inscription in Model.InscriptionsRecentes)
                        {
                            <div class="admin-list__item">
                                <div class="admin-list__meta">
                                    <strong>@(inscription.Utilisateur?.Prenom ?? inscription.Prenom) @(inscription.Utilisateur?.Nom ?? inscription.Nom)</strong>
                                    <span>@inscription.Tournoi?.Nom</span>
                                </div>
                                <span>@inscription.CreeLe.ToShortDateString()</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="app-muted-note">Aucune inscription recente.</p>
                    }
                </div>
            </section>

            <section class="app-surface-card">
                <span class="app-section-eyebrow"><i class="fas fa-handshake"></i> Commanditaires</span>
                <div class="admin-list">
                    @if (Model.Commanditaires.Any())
                    {
                        @foreach (var commandite in Model.Commanditaires)
                        {
                            <div class="admin-list__item">
                                <div class="admin-list__meta">
                                    <strong>@commandite.Utilisateur?.Prenom @commandite.Utilisateur?.Nom</strong>
                                    <span>@commandite.TypeCommandite - @commandite.Tournoi?.Nom</span>
                                </div>
                                <span>@commandite.Montant.ToString("C")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="app-muted-note">Aucun commanditaire enregistre.</p>
                    }
                </div>
            </section>
        </div>
    </div>
</section>
