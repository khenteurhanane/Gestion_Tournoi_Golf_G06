@{
    ViewData["Title"] = "Espace Administrateur";
}

<h1>Tableau de bord Administrateur</h1>

<!-- Statistiques -->
<div class="stats-row">
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbTournois</p>
        <p class="stat-label">Tournois</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbTournoisOuverts</p>
        <p class="stat-label">Inscriptions ouvertes</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbParticipants</p>
        <p class="stat-label">Inscriptions</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbUtilisateurs</p>
        <p class="stat-label">Utilisateurs</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbEquipes</p>
        <p class="stat-label">Équipes</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@(((decimal)ViewBag.RevenuTotal).ToString("C"))</p>
        <p class="stat-label">Revenus totaux</p>
    </div>
</div>

<!-- Prochains tournois -->
@{
    var prochains = ViewBag.ProchainsTournois as List<croupe_06_TournoiGolf.Models.Tournoi>;
}
@if (prochains != null && prochains.Count > 0)
{
    <div class="card">
        <h3>Prochains tournois</h3>
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Date</th>
                    <th>Lieu</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in prochains)
                {
                    <tr>
                        <td>@t.Nom</td>
                        <td>@t.DateTournoi.ToShortDateString()</td>
                        <td>@t.Lieu</td>
                        <td>
                            @if (t.InscriptionsOuvertes)
                            {
                                <span class="badge badge-ouvert">Ouvertes</span>
                            }
                            else
                            {
                                <span class="badge badge-ferme">Fermées</span>
                            }
                        </td>
                        <td>
                            <a href="/Tournoi/Details/@t.TournoiId" class="btn btn-secondary btn-sm">Détails</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Actions rapides -->
<div class="card">
    <h3>Actions rapides</h3>
    <div class="admin-actions-grid">
        <a class="btn" href="/Tournoi/Create"><i class="fas fa-plus"></i> Créer un tournoi</a>
        <a class="btn" href="/Tournoi/Index"><i class="fas fa-golf-ball"></i> Gérer les tournois</a>
        <a class="btn" href="/Admin/Utilisateurs"><i class="fas fa-users"></i> Gérer les utilisateurs</a>
        <a class="btn" href="/Admin/Equipes"><i class="fas fa-users-cog"></i> Gérer les équipes</a>
        <a class="btn btn-secondary" href="/Auth/Logout"><i class="fas fa-sign-out-alt"></i> Se déconnecter</a>
    </div>

    <style>
        .admin-actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 10px;
        }
        .admin-actions-grid .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            height: auto;
        }
    </style>
</div>
