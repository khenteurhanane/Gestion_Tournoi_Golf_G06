@model IEnumerable<croupe_06_TournoiGolf.Models.Participant>
@{
    ViewData["Title"] = "Gestion des Participants";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Participants";
}

<section class="app-page-shell app-page-shell--wide">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-users",
        Eyebrow = "Administration",
        Title = "Gestion des participants",
        Description = "Consultez toutes les inscriptions individuelles et sponsorisées de la plateforme."
    })

    <section class="app-surface-card app-table-card">
        <div class="app-table-card__header">
            <div>
                <h2>Tous les participants</h2>
                <p class="app-muted-note">@Model.Count() participant(s)</p>
            </div>
        </div>

        <div class="app-table-wrap">
            <table class="app-data-table">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Tournoi</th>
                        <th>Type</th>
                        <th>Source / Sponsor</th>
                        <th>Date d'inscription</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(p.Utilisateur?.Prenom ?? p.Prenom) @(p.Utilisateur?.Nom ?? p.Nom)</strong>
                                <div class="app-muted-note">@(p.Utilisateur?.Email ?? p.Email)</div>
                            </td>
                            <td>
                                <strong>@p.Tournoi.Nom</strong>
                                <div class="app-muted-note">@p.Tournoi.DateTournoi.ToShortDateString()</div>
                            </td>
                            <td>
                                @if (p.CommanditeId != null)
                                {
                                    <span class="app-status-badge app-status-badge--warning">Commandité</span>
                                }
                                else if (p.UtilisateurId != null && p.Utilisateur?.Role == "EMPLOYE")
                                {
                                    <span class="app-status-badge app-status-badge--success">Employé</span>
                                }
                                else
                                {
                                    <span class="app-pill">Individuel</span>
                                }
                            </td>
                            <td>
                                @if (p.Commandite != null)
                                {
                                    <strong>@p.Commandite.Utilisateur.NomEntreprise</strong>
                                    <div class="app-muted-note">Forfait @p.Commandite.TypeCommandite</div>
                                }
                                else
                                {
                                    <span class="app-muted-note">—</span>
                                }
                            </td>
                            <td>@p.CreeLe.ToString("g")</td>
                            <td><span class="app-status-badge app-status-badge--success">@p.StatutInscription</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
