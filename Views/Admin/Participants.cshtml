@model IEnumerable<croupe_06_TournoiGolf.Models.Participant>
@{
    ViewData["Title"] = "Gestion des Participants";
}

<div class="dashboard-header mb-4">
    <div>
        <h1 class="fw-bold">Gestion des <span class="text-success">Participants</span></h1>
        <p class="text-muted">Inscriptions individuelles et joueurs commanditaires</p>
    </div>
</div>

<div class="premium-card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fas fa-users me-2 text-success"></i> Tous les participants (@Model.Count())</h5>
    </div>
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-admin-table">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Participant</th>
                        <th class="py-3">Tournoi</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Source / Sponsor</th>
                        <th class="py-3">Date d'inscription</th>
                        <th class="text-end pe-4 py-3">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm rounded-circle bg-success-light text-success me-3 d-flex align-items-center justify-content-center fw-bold">
                                        #@p.ParticipantId.ToString("D3")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@(p.Utilisateur?.Prenom ?? p.Prenom) @(p.Utilisateur?.Nom ?? p.Nom)</div>
                                        <div class="small text-muted">@(p.Utilisateur?.Email ?? p.Email)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3">
                                <div class="fw-600">@p.Tournoi.Nom</div>
                                <div class="small text-muted">@p.Tournoi.DateTournoi.ToShortDateString()</div>
                            </td>
                            <td class="py-3">
                                @if (p.CommanditeId != null)
                                {
                                    <span class="badge rounded-pill bg-warning-light text-warning border-warning-light">Commandité</span>
                                }
                                else if (p.UtilisateurId != null && p.Utilisateur?.Role == "EMPLOYE")
                                {
                                    <span class="badge rounded-pill bg-info-light text-info border-info-light">Employé</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-light text-secondary border-secondary-light">Individuel</span>
                                }
                            </td>
                            <td class="py-3">
                                @if (p.Commandite != null)
                                {
                                    <div class="small fw-bold">@p.Commandite.Utilisateur.NomEntreprise</div>
                                    <div class="small text-muted">Forfait @p.Commandite.TypeCommandite</div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="py-3">
                                <div class="small">@p.CreeLe.ToString("g")</div>
                            </td>
                            <td class="text-end pe-4 py-3">
                                <span class="badge rounded-pill bg-success text-white">@p.StatutInscription</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .avatar-sm { width: 32px; height: 32px; font-size: 0.65rem; }
    .bg-success-light { background: rgba(45, 106, 46, 0.1); }
    .bg-warning-light { background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.2); }
    .text-warning { color: #856404 !important; }
    .bg-info-light { background: rgba(13, 202, 240, 0.1); border: 1px solid rgba(13, 202, 240, 0.2); }
    .text-info { color: #055160 !important; }
    .bg-secondary-light { background: rgba(108, 117, 125, 0.1); border: 1px solid rgba(108, 117, 125, 0.2); }
    
    .custom-admin-table th { border: none; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .custom-admin-table td { border-bottom: 1px solid #f1f3f5; }
    .fw-600 { font-weight: 600; }
</style>
