@model croupe_06_TournoiGolf.Models.Equipe
@{
    ViewData["Title"] = "Détails de l'équipe";
    var membres = (List<Participant>)ViewBag.Membres;
}

<div class="admin-header">
    <h1><i class="fas fa-edit"></i> Équipe : @Model.NomEquipe</h1>
    <a href="/Admin/Equipes" class="btn btn-secondary">Retour à la liste</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <!-- Formulaire de modification -->
    <div class="col-md-5">
        <div class="card">
            <h3>Paramètres de l'équipe</h3>
            <form action="/Admin/ModifierEquipe" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EquipeId" value="@Model.EquipeId" />
                
                <div class="form-group">
                    <label>Nom de l'équipe</label>
                    <input type="text" name="NomEquipe" value="@Model.NomEquipe" required />
                </div>

                <div class="form-group">
                    <label>Code Secret</label>
                    <input type="text" name="CodeSecret" value="@Model.CodeSecret" style="text-transform: uppercase; font-weight: bold; letter-spacing: 2px;" required />
                </div>

                <div class="form-group">
                    <label>Tournoi</label>
                    <input type="text" value="@Model.Tournoi?.Nom" readonly style="background: #f1f1f1; color: #666;" />
                </div>

                <div class="form-group">
                    <label>Date de création</label>
                    <input type="text" value="@Model.CreeLe.ToShortDateString()" readonly style="background: #f1f1f1; color: #666;" />
                </div>

                <button type="submit" class="btn" style="width: 100%;">Enregistrer les modifications</button>
            </form>
        </div>
    </div>

    <!-- Gestion des membres -->
    <div class="col-md-7">
        <div class="card">
            <h3>Membres (@membres.Count / @Model.NbJoueursMax)</h3>
            
            @if (membres.Count == 0)
            {
                <p class="text-muted">Aucun membre dans cette équipe pour le moment.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in membres)
                        {
                            <tr>
                                <td>
                                    @if (m.UtilisateurId == Model.CreeParUtilisateurId)
                                    {
                                        <span class="badge-capitaine"><i class="fas fa-crown"></i> Capitaine</span>
                                    }
                                    @m.Utilisateur?.Prenom @m.Utilisateur?.Nom
                                </td>
                                <td>@m.Utilisateur?.Email</td>
                                <td>
                                    <form action="/Admin/RetirerMembre" method="post" onsubmit="return confirm('Retirer ce participant de l\'équipe ?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="participantId" value="@m.ParticipantId" />
                                        <input type="hidden" name="equipeId" value="@Model.EquipeId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
