@model List<croupe_06_TournoiGolf.Models.Equipe>
@{
    ViewData["Title"] = "Gestion des Équipes";
    var nbMembres = ViewBag.NbMembres as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="admin-header">
    <h1><i class="fas fa-users-cog"></i> Gestion des Équipes</h1>
    <div>
        <a href="/Tournoi/Index" class="btn btn-primary">+ Créer une équipe</a>
        <a href="/Admin/Index" class="btn btn-secondary">Retour au Dashboard</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card mt-4">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Nom de l'équipe</th>
                    <th>Tournoi</th>
                    <th>Créateur</th>
                    <th>Membres</th>
                    <th>Code Secret</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eq in Model)
                {
                    int count = nbMembres.ContainsKey(eq.EquipeId) ? nbMembres[eq.EquipeId] : 0;
                    <tr>
                        <td><strong>@eq.NomEquipe</strong></td>
                        <td>@eq.Tournoi?.Nom</td>
                        <td>
                            <span class="badge-capitaine"><i class="fas fa-crown"></i></span>
                            @eq.Createur?.Prenom @eq.Createur?.Nom
                        </td>
                        <td>
                            <span class="badge @(count >= eq.NbJoueursMax ? "badge-ferme" : "badge-ouvert")">
                                @count / @eq.NbJoueursMax
                            </span>
                            @if (count < eq.NbJoueursMax)
                            {
                                <small class="text-warning ms-1" title="Incomplète">
                                    <i class="fas fa-exclamation-circle"></i>
                                </small>
                            }
                        </td>
                        <td><code>@eq.CodeSecret</code></td>
                        <td>
                            <div style="display: flex; gap: 5px;">
                                <a href="/Admin/DetailsEquipe/@eq.EquipeId" class="btn btn-sm">Gérer</a>
                                <form action="/Admin/SupprimerEquipe" method="post" onsubmit="return confirm('Supprimer cette équipe ? Les membres deviendront des participants individuels.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@eq.EquipeId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
