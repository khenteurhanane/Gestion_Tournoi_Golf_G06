@model List<croupe_06_TournoiGolf.Models.Tournoi>

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Liste des Tournois";

    var tournoisAVenir = Model.Where(t => t.DateTournoi >= DateTime.Today).OrderBy(t => t.DateTournoi).ToList();
    var tournoisPasses = Model.Where(t => t.DateTournoi < DateTime.Today).OrderByDescending(t => t.DateTournoi).ToList();
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-calendar-days",
        EyebrowText = "Programmation",
        Title = "Tournois de golf",
        Description = "Consultez les evenements a venir, verifiez les places restantes et inscrivez-vous des que les inscriptions sont ouvertes."
    };

    bool estAdmin = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") == "ADMIN";
    bool estConnecte = HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true";
    var nbInscrits = ViewBag.NbInscrits as Dictionary<int, int> ?? new Dictionary<int, int>();
    var tournoiInscrits = ViewBag.TournoiInscrits as List<int> ?? new List<int>();
}

<div class="public-page">
    <partial name="_PublicPageHero" model="hero" />

    <section class="app-toolbar">
        <div class="inline-note">
            <i class="fas fa-flag-checkered"></i>
            <span>@tournoisAVenir.Count tournoi(s) a venir | @tournoisPasses.Count dans l'historique</span>
        </div>
        <div class="app-toolbar__actions">
            <div class="app-toolbar__search">
                <input type="text" id="rechercheTournoi" placeholder="Rechercher un tournoi..." class="search-field-sm" onkeyup="filtrerCartes()" />
            </div>
            @if (estAdmin)
            {
                <a class="btn" href="/Tournoi/Create">+ Nouveau tournoi</a>
            }
        </div>
    </section>

    <div class="app-chip-tabs tournoi-tabs">
        <button class="btn onglet-actif pill-btn" id="btnAVenir" onclick="afficherOnglet('avenir')">
            A venir (@tournoisAVenir.Count)
        </button>
        <button class="btn btn-secondary pill-btn" id="btnPasses" onclick="afficherOnglet('passes')">
            Historique (@tournoisPasses.Count)
        </button>
    </div>

    <section id="sectionAVenir" class="tournoi-section">
        <div class="tournoi-section__header">
            <h2 class="tournoi-section__title">Tournois ouverts et a venir</h2>
            <span class="tournoi-section__meta">Inscription, capacite et date limite en un coup d'oeil</span>
        </div>

        @if (tournoisAVenir.Count == 0)
        {
            var emptyState = new croupe_06_TournoiGolf.Models.ViewModels.EmptyStateViewModel
            {
                Icon = "fas fa-calendar-xmark",
                Title = "Aucun tournoi a venir",
                Description = "Aucun evenement n'est programme pour le moment. Revenez bientot pour consulter la prochaine ouverture des inscriptions.",
                PrimaryLabel = estAdmin ? "Creer un tournoi" : null,
                PrimaryHref = estAdmin ? "/Tournoi/Create" : null
            };
            <partial name="_EmptyState" model="emptyState" />
        }
        else
        {
            <div class="tournois-grid" id="grilleAVenir">
                @foreach (var tournoi in tournoisAVenir)
                {
                    var nb = nbInscrits.ContainsKey(tournoi.TournoiId) ? nbInscrits[tournoi.TournoiId] : 0;
                    var placesRestantes = tournoi.PlacesParticipantsMax - nb;
                    var pct = (int)Math.Min(100, nb * 100.0 / Math.Max(1, tournoi.PlacesParticipantsMax));
                    var dejaInscrit = tournoiInscrits.Contains(tournoi.TournoiId);

                    string[] defaultImages = {
                        "/images/tournois/tournament_summer.png",
                        "/images/tournois/tournament_classic.png",
                        "/images/tournois/tournament_competition.png"
                    };
                    var imgSrc = string.IsNullOrEmpty(tournoi.ImageUrl)
                        ? defaultImages[tournoi.TournoiId % defaultImages.Length]
                        : tournoi.ImageUrl;

                    var joursRestants = (tournoi.DateTournoi - DateTime.Today).Days;
                    string badgeDelai = joursRestants == 0 ? "Aujourd'hui" :
                                        joursRestants == 1 ? "Demain" :
                                        $"Dans {joursRestants} jours";

                    <div class="tournoi-card carte-tournoi">
                        <div class="tournoi-card-img" style="background-image:url('@imgSrc');">
                            <div class="tournoi-card-badge-status">
                                @if (tournoi.InscriptionsOuvertes)
                                {
                                    <span class="badge badge-ouvert">Inscriptions ouvertes</span>
                                }
                                else
                                {
                                    <span class="badge badge-ferme">Inscriptions fermees</span>
                                }
                            </div>
                            <div class="tournoi-card-badge-delai">@badgeDelai</div>
                        </div>

                        <div class="tournoi-card-body">
                            <h3 class="tournoi-card-titre">@tournoi.Nom</h3>

                            <div class="tournoi-card-meta">
                                <span>Date : @tournoi.DateTournoi.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-CA"))</span>
                                <span>Lieu : @tournoi.Lieu</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(tournoi.Description))
                            {
                                <p class="tournoi-card-desc">@tournoi.Description</p>
                            }

                            <div class="tournoi-progress-block">
                                <div class="tournoi-progress-row">
                                    <span><strong>@nb</strong> / @tournoi.PlacesParticipantsMax participants</span>
                                    @if (placesRestantes <= 5 && placesRestantes > 0)
                                    {
                                        <span class="tournoi-progress-warning">@placesRestantes place(s) restante(s)</span>
                                    }
                                    else if (placesRestantes <= 0)
                                    {
                                        <span class="tournoi-progress-danger">Complet</span>
                                    }
                                </div>
                                <div class="tournoi-progress-track">
                                    <div class="tournoi-progress-fill" style="background:@(pct >= 90 ? "var(--danger)" : pct >= 70 ? "var(--warning)" : "var(--accent)"); width:@(pct)%;"></div>
                                </div>
                            </div>

                            @if (tournoi.DateLimiteInscription.HasValue)
                            {
                                <p class="tournoi-date-limit">
                                    Date limite : @tournoi.DateLimiteInscription.Value.ToShortDateString()
                                </p>
                            }

                            <div class="tournoi-card-actions">
                                @if (estAdmin)
                                {
                                    <a href="/Tournoi/Details/@tournoi.TournoiId" class="btn btn-secondary btn-sm">Details</a>
                                    <a href="/Tournoi/Edit/@tournoi.TournoiId" class="btn btn-secondary btn-sm">Modifier</a>
                                    @if (tournoi.InscriptionsOuvertes)
                                    {
                                        <form action="/Tournoi/FermerInscriptions" method="post" class="inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@tournoi.TournoiId" />
                                            <button type="submit" class="btn btn-secondary btn-sm">Fermer</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form action="/Tournoi/OuvrirInscriptions" method="post" class="inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@tournoi.TournoiId" />
                                            <button type="submit" class="btn btn-sm">Ouvrir</button>
                                        </form>
                                    }
                                }
                                else if (estConnecte)
                                {
                                    @if (dejaInscrit)
                                    {
                                        <span class="btn btn-secondary btn-sm btn-static">Deja inscrit</span>
                                    }
                                    else if (tournoi.InscriptionsOuvertes && placesRestantes > 0)
                                    {
                                        <a href="/Inscription/Index?tournoiId=@tournoi.TournoiId" class="btn btn-sm">S'inscrire</a>
                                    }
                                    else if (placesRestantes <= 0)
                                    {
                                        <span class="btn btn-secondary btn-sm btn-static">Complet</span>
                                    }
                                }
                                else if (tournoi.InscriptionsOuvertes)
                                {
                                    <a href="/Auth/Login" class="btn btn-sm">Se connecter pour s'inscrire</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section id="sectionPasses" class="tournoi-section d-none">
        <div class="tournoi-section__header">
            <h2 class="tournoi-section__title">Historique des tournois</h2>
            <span class="tournoi-section__meta">Consultez les editions deja tenues</span>
        </div>

        @if (tournoisPasses.Count == 0)
        {
            var emptyState = new croupe_06_TournoiGolf.Models.ViewModels.EmptyStateViewModel
            {
                Icon = "fas fa-clock-rotate-left",
                Title = "Aucun tournoi dans l'historique",
                Description = "L'historique n'affiche encore aucun evenement passe."
            };
            <partial name="_EmptyState" model="emptyState" />
        }
        else
        {
            <div class="tournois-grid" id="grillePasses">
                @foreach (var tournoi in tournoisPasses)
                {
                    var nb = nbInscrits.ContainsKey(tournoi.TournoiId) ? nbInscrits[tournoi.TournoiId] : 0;
                    var imgSrc = string.IsNullOrEmpty(tournoi.ImageUrl) ? "/images/golf-hero.png" : tournoi.ImageUrl;

                    <div class="tournoi-card carte-tournoi tournoi-card--past">
                        <div class="tournoi-card-img tournoi-card-img--muted" style="background-image:url('@imgSrc');">
                            <div class="tournoi-card-badge-status">
                                <span class="badge badge-muted">Termine</span>
                            </div>
                        </div>
                        <div class="tournoi-card-body">
                            <h3 class="tournoi-card-titre">@tournoi.Nom</h3>
                            <div class="tournoi-card-meta">
                                <span>Date : @tournoi.DateTournoi.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-CA"))</span>
                                <span>Lieu : @tournoi.Lieu</span>
                            </div>
                            <p class="text-muted text-sm mb-2">
                                @nb participant(s)
                            </p>
                            @if (estAdmin)
                            {
                                <div class="tournoi-card-actions">
                                    <a href="/Tournoi/Details/@tournoi.TournoiId" class="btn btn-secondary btn-sm">Details</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<script>
function afficherOnglet(onglet) {
    document.getElementById('sectionAVenir').classList.toggle('d-none', onglet !== 'avenir');
    document.getElementById('sectionPasses').classList.toggle('d-none', onglet !== 'passes');
    document.getElementById('btnAVenir').className = onglet === 'avenir' ? 'btn onglet-actif pill-btn' : 'btn btn-secondary pill-btn';
    document.getElementById('btnPasses').className = onglet === 'passes' ? 'btn onglet-actif pill-btn' : 'btn btn-secondary pill-btn';
}

function filtrerCartes() {
    var filtre = document.getElementById('rechercheTournoi').value.toLowerCase();
    document.querySelectorAll('.carte-tournoi').forEach(function(c) {
        c.style.display = c.innerText.toLowerCase().includes(filtre) ? '' : 'none';
    });
}
</script>
