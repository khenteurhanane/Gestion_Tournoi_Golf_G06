@model croupe_06_TournoiGolf.Models.Tournoi

@{
    ViewData["Title"] = "Modifier le tournoi";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Modifier le tournoi";
}

<section class="app-page-shell app-page-shell--medium">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-pen-to-square",
        Eyebrow = "Administration",
        Title = "Modifier le tournoi",
        Description = "Mettez à jour les informations, la période d'inscription et l'image du tournoi."
    })

    <section class="app-surface-card app-form-card">
        <form action="/Tournoi/Edit" method="post" enctype="multipart/form-data" class="app-form-card">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TournoiId" value="@Model.TournoiId" />

            <div class="app-form-grid">
                <div class="form-group">
                    <label>Nom du tournoi</label>
                    <input name="Nom" type="text" value="@Model.Nom" required />
                </div>

                <div class="form-group">
                    <label>Date du tournoi</label>
                    <input id="DateTournoi" name="DateTournoi" type="date" value="@Model.DateTournoi.ToString("yyyy-MM-dd")" min-today required />
                </div>

                <div class="form-group">
                    <label>Lieu</label>
                    <input name="Lieu" type="text" value="@Model.Lieu" required />
                </div>

                <div class="form-group">
                    <label>Nombre max de participants</label>
                    <input name="PlacesParticipantsMax" type="number" value="@Model.PlacesParticipantsMax" min="1" max="200" />
                </div>

                <div class="form-group app-form-grid--single" style="grid-column: 1 / -1;">
                    <label>Description</label>
                    <textarea name="Description" rows="4">@Model.Description</textarea>
                </div>

                <div class="form-group">
                    <label>Date limite d'inscription (optionnel)</label>
                    <input id="DateLimiteInscription" name="DateLimiteInscription" type="date" value="@(Model.DateLimiteInscription?.ToString("yyyy-MM-dd"))" data-before="DateTournoi" />
                    <p class="app-field-hint">Si vide, aucune date limite ne sera appliquée.</p>
                </div>

                <div class="form-group">
                    <label>Image du tournoi</label>
                    <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.gif" onchange="previewImage(this)" />
                    <p class="app-field-hint">Laissez vide pour conserver l'image actuelle.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="app-surface-card">
                    <span class="app-section-eyebrow"><i class="fas fa-image"></i> Image actuelle</span>
                    <img src="@Model.ImageUrl" alt="Image actuelle" class="upload-current-image" />
                </div>
            }

            <div id="upload-preview" class="app-surface-card d-none">
                <img id="img-preview" src="" alt="Aperçu" class="upload-preview-image" />
                <p id="img-nom" class="upload-preview-name"></p>
            </div>

            <div class="app-actions">
                <button type="submit" class="btn">Enregistrer</button>
                <a href="/Tournoi/Details/@Model.TournoiId" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <script>
        function previewImage(input) {
            if (!input.files || !input.files[0]) return;

            const file = input.files[0];
            if (file.size > 5 * 1024 * 1024) {
                alert('Image trop lourde (maximum 5 Mo).');
                input.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('upload-preview').classList.remove('d-none');
                document.getElementById('img-preview').src = e.target.result;
                document.getElementById('img-nom').textContent = file.name;
            };
            reader.readAsDataURL(file);
        }
    </script>
}
