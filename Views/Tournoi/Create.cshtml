@model croupe_06_TournoiGolf.Models.Tournoi

@{
    ViewData["Title"] = "Creer un tournoi";
    ViewData["HideTopbarPageInfo"] = true;
    ViewData["CompactTopbarTitle"] = "Créer un tournoi";
}

<section class="app-page-shell app-page-shell--medium">
    @await Html.PartialAsync("_AppSectionHeader", new croupe_06_TournoiGolf.Models.ViewModels.AppSectionHeaderViewModel
    {
        Icon = "fas fa-calendar-plus",
        Eyebrow = "Administration",
        Title = "Créer un tournoi",
        Description = "Configurez un nouveau tournoi avec ses dates, sa capacité et son identité visuelle."
    })

    <section class="app-surface-card app-form-card">
        <form action="/Tournoi/Create" method="post" enctype="multipart/form-data" class="app-form-card">
            @Html.AntiForgeryToken()

            <div class="app-form-grid">
                <div class="form-group">
                    <label>Nom du tournoi</label>
                    <input name="Nom" type="text" placeholder="Nom du tournoi" required />
                </div>

                <div class="form-group">
                    <label>Date du tournoi</label>
                    <input id="DateTournoi" name="DateTournoi" type="date" min-today required />
                </div>

                <div class="form-group">
                    <label>Lieu</label>
                    <input name="Lieu" type="text" placeholder="Lieu du tournoi" required />
                </div>

                <div class="form-group">
                    <label>Nombre max de participants</label>
                    <input name="PlacesParticipantsMax" type="number" value="100" min="1" max="200" />
                </div>

                <div class="form-group app-form-grid--single" style="grid-column: 1 / -1;">
                    <label>Description</label>
                    <textarea name="Description" placeholder="Description du tournoi" rows="4"></textarea>
                </div>

                <div class="form-group">
                    <label>Date limite d'inscription (optionnel)</label>
                    <input id="DateLimiteInscription" name="DateLimiteInscription" type="date" data-before="DateTournoi" />
                    <p class="app-field-hint">Si vide, aucune date limite ne sera appliquée.</p>
                </div>

                <div class="form-group">
                    <label>Image du tournoi</label>
                    <input type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.gif" onchange="previewImage(this)" />
                    <p class="app-field-hint">JPG, PNG, WEBP ou GIF. Maximum 5 Mo.</p>
                </div>
            </div>

            <div id="upload-preview" class="app-surface-card d-none">
                <img id="img-preview" src="" alt="Aperçu" class="upload-preview-image upload-preview-image-lg" />
                <p id="img-nom" class="upload-preview-name"></p>
            </div>

            <div class="app-actions">
                <button type="submit" class="btn">Créer le tournoi</button>
                <a href="/Tournoi/Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    <script>
        function previewImage(input) {
            if (!input.files || !input.files[0]) return;

            const file = input.files[0];
            if (file.size > 5 * 1024 * 1024) {
                alert('Image trop lourde (maximum 5 Mo).');
                input.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('upload-preview').classList.remove('d-none');
                document.getElementById('img-preview').src = e.target.result;
                document.getElementById('img-nom').textContent = file.name;
            };
            reader.readAsDataURL(file);
        }
    </script>
}
