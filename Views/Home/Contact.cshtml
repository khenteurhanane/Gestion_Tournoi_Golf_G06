@{
    ViewData["Title"] = "Contactez-nous";
}

<h1>Contactez-nous</h1>
<p class="sub">Vous avez une question sur le tournoi de golf? N'hésitez pas à nous joindre.</p>

<!-- Informations de contact -->
<div class="grid grid-3 mt-3">
    <div class="card">
        <h3>Adresse</h3>
        <p>La Cité collégiale</p>
        <p>801, promenade de l'Aviation</p>
        <p>Ottawa, ON K1K 4R3</p>
    </div>

    <div class="card">
        <h3>Téléphone</h3>
        <p>Bureau principal : <strong>(613) 742-2483</strong></p>
        <p>Lundi au vendredi : 8h à 17h</p>
    </div>

    <div class="card">
        <h3>Courriel</h3>
        <p>Tournoi : <strong>tournoi@lacite.ca</strong></p>
        <p>Support : <strong>support@lacite.ca</strong></p>
    </div>
</div>

<!-- Formulaire de contact -->
<div class="card mt-3">
    <h3>Envoyer un message</h3>
    <form id="formContact">
        <div class="form-group">
            <label>Votre nom</label>
            <input type="text" id="contactNom" placeholder="Prénom et nom" required />
        </div>
        <div class="form-group">
            <label>Votre courriel</label>
            <input type="email" id="contactEmail" placeholder="exemple@email.com" required />
        </div>
        <div class="form-group">
            <label>Sujet</label>
            <select id="contactSujet">
                <option value="question">Question générale</option>
                <option value="inscription">Problème d'inscription</option>
                <option value="equipe">Question sur les équipes</option>
                <option value="commandite">Devenir commanditaire</option>
                <option value="autre">Autre</option>
            </select>
        </div>
        <div class="form-group">
            <label>Message</label>
            <textarea id="contactMessage" rows="5" placeholder="Écrivez votre message ici..." required></textarea>
        </div>
        <button class="btn" type="submit">Envoyer le message</button>
    </form>
    <div id="contactSuccess" class="success" style="display:none;">
        Votre message a été envoyé avec succès! Nous vous répondrons dans les plus brefs délais.
    </div>
</div>

<script>
    document.getElementById('formContact').addEventListener('submit', function (e) {
        e.preventDefault();
        this.style.display = 'none';
        document.getElementById('contactSuccess').style.display = 'block';
    });
</script>
