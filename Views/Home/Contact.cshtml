@{
    ViewData["Title"] = "Contactez-nous";
    ViewData["UsePublicShell"] = true;
    var hero = new croupe_06_TournoiGolf.Models.ViewModels.PublicPageHeroViewModel
    {
        EyebrowIcon = "fas fa-envelope-open-text",
        EyebrowText = "Contact",
        Title = "Contactez-nous",
        Description = "Vous avez une question sur le tournoi, les inscriptions, les equipes ou les commandites ? Notre equipe peut vous orienter rapidement."
    };
    var addressCard = new croupe_06_TournoiGolf.Models.ViewModels.PublicInfoCardViewModel
    {
        Icon = "fas fa-location-dot",
        Title = "Adresse",
        Lines = ["La Cite collegiale", "801, promenade de l'Aviation", "Ottawa, ON K1K 4R3"]
    };
    var phoneCard = new croupe_06_TournoiGolf.Models.ViewModels.PublicInfoCardViewModel
    {
        Icon = "fas fa-phone",
        Title = "Telephone",
        Lines = ["Bureau principal : (613) 742-2483", "Lundi au vendredi : 8h a 17h"]
    };
    var mailCard = new croupe_06_TournoiGolf.Models.ViewModels.PublicInfoCardViewModel
    {
        Icon = "fas fa-at",
        Title = "Courriel",
        Lines = ["Tournoi : tournoi@lacite.ca", "Support : support@lacite.ca"]
    };
}

<div class="public-page">
    <partial name="_PublicPageHero" model="hero" />

    <section class="info-grid">
        <partial name="_PublicInfoCard" model="addressCard" />
        <partial name="_PublicInfoCard" model="phoneCard" />
        <partial name="_PublicInfoCard" model="mailCard" />
    </section>

    <section class="public-section-card auth-card">
        <div class="auth-card__header">
            <h2 class="auth-card__title">Envoyer un message</h2>
            <p class="auth-card__text">Ce formulaire de contact simule l'envoi d'un message et restera harmonise avec le reste des ecrans publics.</p>
        </div>

        <form id="formContact" class="form-stack">
            <div class="form-group">
                <label for="contactNom">Votre nom</label>
                <input type="text" id="contactNom" placeholder="Prenom et nom" required />
            </div>
            <div class="form-group">
                <label for="contactEmail">Votre courriel</label>
                <input type="email" id="contactEmail" placeholder="exemple@email.com" required />
            </div>
            <div class="form-group">
                <label for="contactSujet">Sujet</label>
                <select id="contactSujet">
                    <option value="question">Question generale</option>
                    <option value="inscription">Probleme d'inscription</option>
                    <option value="equipe">Question sur les equipes</option>
                    <option value="commandite">Devenir commanditaire</option>
                    <option value="autre">Autre</option>
                </select>
            </div>
            <div class="form-group">
                <label for="contactMessage">Message</label>
                <textarea id="contactMessage" rows="5" placeholder="Ecrivez votre message ici..." required></textarea>
            </div>
            <div class="auth-actions">
                <button class="btn" type="submit">Envoyer le message</button>
            </div>
        </form>

        <div id="contactSuccess" class="surface-alert surface-alert--success d-none">
            Votre message a ete envoye avec succes. Nous vous repondrons dans les plus brefs delais.
        </div>
    </section>
</div>

<script>
    document.getElementById('formContact').addEventListener('submit', function (e) {
        e.preventDefault();
        this.classList.add('d-none');
        document.getElementById('contactSuccess').classList.remove('d-none');
    });
</script>
