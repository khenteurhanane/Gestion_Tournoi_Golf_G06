@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Accueil";
    bool estConnecte = HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true";
    string role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "";
    string prenom = HttpContextAccessor.HttpContext?.Session.GetString("UserPrenom") ?? "";
}

<!-- Page d'accueil style affiche complète -->
<div class="full-poster-page">
    <div class="hero-poster">
        <div class="poster-overlay">
            <div class="poster-content">
                <div class="poster-badge animate__animated animate__fadeInDown">
                    <span class="poster-golf-text">CONCOURS ANNUEL</span>
                    <h1 class="poster-golf-title">GOLF</h1>
                    <p class="poster-subtitle">L'ÉVÉNEMENT PRESTIGE DE L'ANNÉE</p>
                </div>
                
                <div class="poster-college animate__animated animate__fadeIn">
                    <div class="college-logo-wrapper">
                        <span class="college-text-small">COLLÈGE</span>
                        <h2 class="college-name">LA CITÉ</h2>
                        <span class="college-location">Ottawa</span>
                    </div>
                </div>

                <div class="poster-cta-group animate__animated animate__fadeInUp">
                    @if (estConnecte)
                    {
                        <p class="poster-welcome">Heureux de vous revoir, <strong>@prenom</strong></p>
                        <div class="poster-btns">
                            <a class="btn-poster-primary luxury-btn" href="/Tournoi/Index">Découvrir les tournois</a>
                            @if (role == "ADMIN")
                            {
                                <a class="btn-poster-outline luxury-outline" href="/Admin/Index">Tableau de Bord</a>
                            }
                            else
                            {
                                <a class="btn-poster-outline luxury-outline" href="/Auth/MesInscriptions">Mon Profil</a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="poster-btns">
                            <a class="btn-poster-primary luxury-btn" href="/Auth/Register">Rejoindre l'aventure</a>
                            <a class="btn-poster-outline luxury-outline" href="/Auth/Login">Accès Membre</a>
                        </div>
                    }
                </div>

                <div class="poster-footer animate__animated animate__fadeInUp">
                    <div class="footer-info-line">
                        <span class="line"></span>
                        <span class="info-text">Information & Réservation</span>
                        <span class="line"></span>
                    </div>
                    <div class="poster-phone">
                        <span class="phone-icon">📞</span> (613) 742-2483
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* On surcharge le conteneur principal pour cette page spécifique */
    .container {
        background: transparent !important;
        backdrop-filter: none !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
    }

    .full-poster-page {
        margin: 0;
        width: 100%;
    }

    .hero-poster {
        border-radius: 0;
        min-height: calc(100vh - 66px); /* 66px = hauteur navbar */
        margin-bottom: 0;
        background-position: center center;
        background-size: cover;
    }

    @@media (min-width: 1200px) {
        .poster-content {
            transform: scale(1.1);
        }
    }
</style>
