        letter-spacing: 0.5px;
    }
    .weather-location i { color: #94a3b8; }
    #weatherCity { color: #cbd5e1; font-weight: 700; }
    .weather-label { color: rgba(255,255,255,0.4); }
    .weather-details {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
