@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Accueil";
    bool estConnecte = HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true";
    string role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "";
    string prenom = HttpContextAccessor.HttpContext?.Session.GetString("UserPrenom") ?? "";
}

<!-- Hero principal -->
<div class="hero-home">
    <!-- Décorations visuelles -->
    <div class="hero-sun">☀️</div>
    <div class="hero-cloud cloud-1">☁️</div>
    <div class="hero-cloud cloud-2">☁️</div>
    <div class="hero-cloud cloud-3">⛅</div>
    <div class="hero-ground"></div>
    <div class="hero-deco hero-ball">⛳</div>
    <div class="hero-deco hero-flag">🏌️</div>
    <div class="hero-deco hero-cart">🏎️</div>
    <div class="hero-deco hero-tree tree-1">🌳</div>
    <div class="hero-deco hero-tree tree-2">🌲</div>
    <div class="hero-deco hero-bird bird-1">🕊️</div>
    <div class="hero-deco hero-bird bird-2">🐦</div>
    <div class="hero-home-content">
        @if (estConnecte)
        {
            <p class="hero-subtitle">Bonjour @prenom !</p>
        }
        <p class="hero-pre-title">Tournoi de</p>
        <h1 class="hero-title-golf">GOLF</h1>
        <p class="hero-tagline">Vivez une journée <strong>inoubliable</strong> sur le vert !</p>

        <div class="hero-features">
            <div class="hero-feat">
                <span class="hero-feat-icon">⛳</span>
                <div><strong>Compétition</strong><br><em>amicale</em></div>
            </div>
            <div class="hero-feat">
                <span class="hero-feat-icon">🏆</span>
                <div><strong>Prix &</strong><br><em>Surprises</em></div>
            </div>
            <div class="hero-feat">
                <span class="hero-feat-icon">🍽️</span>
                <div><strong>Cocktail &</strong><br><em>Déjeuner</em></div>
            </div>
        </div>

        <div class="hero-cta">
            @if (estConnecte)
            {
                <a class="btn-hero" href="/Tournoi/Index">Voir les tournois →</a>
                @if (role == "ADMIN")
                {
                    <a class="btn-hero-outline" href="/Admin/Index">Dashboard Admin</a>
                }
                else
                {
                    <a class="btn-hero-outline" href="/Auth/MesInscriptions">Mes inscriptions</a>
                }
            }
            else
            {
                <a class="btn-hero" href="/Auth/Register">Inscrivez-vous dès maintenant ! →</a>
                <a class="btn-hero-outline" href="/Auth/Login">Connexion</a>
            }
        </div>
        <p class="hero-places">— Places limitées —</p>
    </div>
</div>

<!-- 3 features comme l'affiche -->
<div class="grid grid-3 mt-3">
    <div class="feature-card">
        <div class="feature-icon">⛳</div>
        <h3>Compétition amicale</h3>
        <p>Participez en équipe de 4 joueurs dans une ambiance conviviale et sportive.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">🎁</div>
        <h3>Prix & Surprises</h3>
        <p>Des prix pour les meilleures équipes et des surprises tout au long de la journée.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">🍽️</div>
        <h3>Cocktail & Déjeuner</h3>
        <p>Profitez d'un cocktail de bienvenue et d'un déjeuner inclus dans l'inscription.</p>
    </div>
</div>

<!-- Statistiques -->
<div class="stats-row mt-3">
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbTournois</p>
        <p class="stat-label">Tournois</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbTournoisOuverts</p>
        <p class="stat-label">Inscriptions ouvertes</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbParticipants</p>
        <p class="stat-label">Participants</p>
    </div>
    <div class="stat-card">
        <p class="stat-number">@ViewBag.NbEquipes</p>
        <p class="stat-label">Équipes</p>
    </div>
</div>

<!-- Prochain tournoi -->
@{
    var prochain = ViewBag.ProchainTournoi as croupe_06_TournoiGolf.Models.Tournoi;
}
@if (prochain != null)
{
    <div class="card prochain-tournoi">
        <div class="prochain-header">
            <span class="prochain-badge">Prochain événement</span>
        </div>
        <h2>@prochain.Nom</h2>
        <div class="prochain-details">
            <div class="prochain-info">
                <span class="prochain-icon">📅</span>
                <span>@prochain.DateTournoi.ToString("dddd d MMMM yyyy")</span>
            </div>
            <div class="prochain-info">
                <span class="prochain-icon">📍</span>
                <span>@prochain.Lieu</span>
            </div>
        </div>
        @if (prochain.InscriptionsOuvertes)
        {
            <a class="btn mt-2" href="/Inscription/Index?tournoiId=@prochain.TournoiId">S'inscrire à ce tournoi</a>
        }
        else
        {
            <p class="text-muted mt-1">Inscriptions pas encore ouvertes</p>
        }
    </div>
}

<!-- Tarifs -->
<div class="card mt-3">
    <h2>Tarifs d'inscription</h2>
    <div class="grid grid-2">
        <div class="tarif-card">
            <p class="tarif-prix">60 $</p>
            <p class="tarif-type">Employé</p>
            <p class="tarif-desc">Inclut la participation, le déjeuner et le cocktail.</p>
        </div>
        <div class="tarif-card">
            <p class="tarif-prix">50 $</p>
            <p class="tarif-type">Retraité</p>
            <p class="tarif-desc">Tarif préférentiel pour les retraités de La Cité.</p>
        </div>
    </div>
</div>

<!-- Comment ça marche -->
<div class="mt-3">
    <h2 class="text-center mb-3">Comment participer ?</h2>
    <div class="grid grid-4">
        <div class="step-card">
            <div class="step-number">📝</div>
            <h3>Créez un compte</h3>
            <p>Inscrivez-vous gratuitement sur la plateforme.</p>
        </div>
        <div class="step-card">
            <div class="step-number">🏌️</div>
            <h3>Choisissez un tournoi</h3>
            <p>Parcourez les tournois et choisissez celui qui vous plaît.</p>
        </div>
        <div class="step-card">
            <div class="step-number">👥</div>
            <h3>Formez une équipe</h3>
            <p>Créez une équipe ou rejoignez-en une avec un code secret.</p>
        </div>
        <div class="step-card">
            <div class="step-number">⛳</div>
            <h3>Jouez !</h3>
            <p>Présentez-vous le jour du tournoi et profitez de la journée.</p>
        </div>
    </div>
</div>
