@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Accueil";
    bool estConnecte = HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true";
    string prenom = HttpContextAccessor.HttpContext?.Session.GetString("UserPrenom") ?? "";
    string currentLang = HttpContextAccessor.HttpContext?.Session.GetString("Lang") ?? "FR";
}

<!-- ========== HERO SECTION ========== -->
<div class="hero-banner">
    <div class="hero-content">
        <div class="hero-text">
            <span class="hero-badge">
                <i class="fas fa-golf-ball"></i> Édition 2026
            </span>
            <h1 class="hero-title animate-in">
                @(currentLang == "EN" ? "Experience" : "Vivez l'expérience")<br>
                <span class="silver-text">Golf La Cité</span>
            </h1>
            <p class="hero-desc">
                Rejoignez le tournoi annuel le plus prestigieux d'Ottawa. 
                Compétition, réseautage et moments inoubliables sur les plus beaux parcours de la région.
            </p>
            <div class="hero-actions">
                @if (estConnecte)
                {
                    <a href="/Tournoi/Index" class="btn-hero-primary">
                        <i class="fas fa-trophy me-2"></i> Explorer les tournois
                    </a>
                    <a href="/Equipe/Index" class="btn-hero-outline">
                        <i class="fas fa-users me-2"></i> Mes équipes
                    </a>
                }
                else
                {
                    <a href="/Auth/Register" class="btn-hero-primary">
                        <i class="fas fa-rocket me-2"></i> S'inscrire maintenant
                    </a>
                    <a href="/Auth/Login" class="btn-hero-secondary">
                        Déjà membre ? Connexion
                    </a>
                }
            </div>
        </div>
        <div class="hero-visual">
            <div class="hero-img-wrapper">
                <img src="/images/golf-hero.png" alt="Golf La Cité" class="hero-img" />
                <div class="hero-img-badge">
                    <div class="badge-number">15<sup>e</sup></div>
                    <div class="badge-label">Édition</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== WIDGET MÉTÉO ========== -->
<div class="weather-strip" id="weatherWidget">
    <div class="weather-loading">
        <i class="fas fa-spinner fa-spin"></i>
        <span>Chargement de la météo pour Ottawa...</span>
    </div>
    <div class="weather-content" style="display:none;">
        <div class="weather-location">
            <i class="fas fa-map-marker-alt"></i>
            <span id="weatherCity">Ottawa, ON</span>
            <span class="weather-label">— Conditions pour le prochain tournoi</span>
        </div>
        <div class="weather-details">
            <div class="weather-main">
                <span class="weather-icon-big" id="weatherIcon">☀️</span>
                <span class="weather-temp" id="weatherTemp">--°C</span>
                <span class="weather-desc" id="weatherDesc">Chargement...</span>
            </div>
            <div class="weather-extras">
                <div class="weather-stat">
                    <i class="fas fa-tint"></i>
                    <span id="weatherHumidity">--</span>%
                    <small>Humidité</small>
                </div>
                <div class="weather-stat">
                    <i class="fas fa-wind"></i>
                    <span id="weatherWind">--</span> km/h
                    <small>Vent</small>
                </div>
                <div class="weather-stat">
                    <i class="fas fa-cloud-rain"></i>
                    <span id="weatherRain">--</span>%
                    <small>Pluie</small>
                </div>
            </div>
            <div class="weather-advice" id="weatherAdvice"></div>
        </div>
    </div>
</div>

<!-- ========== STATISTIQUES ========== -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-users"></i></div>
        <div class="stat-info">
            <div class="stat-number">@ViewBag.NbParticipants</div>
            <div class="stat-label">Participants inscrits</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
        <div class="stat-info">
            <div class="stat-number">@ViewBag.NbTournois</div>
            <div class="stat-label">Tournois créés</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-door-open"></i></div>
        <div class="stat-info">
            <div class="stat-number">@ViewBag.NbTournoisOuverts</div>
            <div class="stat-label">Inscriptions ouvertes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-users-cog"></i></div>
        <div class="stat-info">
            <div class="stat-number">@ViewBag.NbEquipes</div>
            <div class="stat-label">Équipes formées</div>
        </div>
    </div>
</div>

<!-- ========== SERVICES ========== -->
<div class="section-header">
    <h2 class="section-title">Tout ce dont vous avez besoin</h2>
    <p class="section-subtitle">Une plateforme complète pour gérer votre expérience de golf</p>
</div>

<div class="services-grid">
    <div class="service-card card-tournoi">
        <div class="service-icon">
            <i class="fas fa-trophy"></i>
        </div>
        <h3>Compétitions</h3>
        <p>Inscrivez-vous aux tournois, suivez les classements et vivez des compétitions passionnantes.</p>
        <a href="/Tournoi/Index" class="service-link">
            Voir les tournois <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="service-card card-equipe">
        <div class="service-icon equipe-icon">
            <i class="fas fa-user-friends"></i>
        </div>
        <h3>Équipes</h3>
        <p>Formez votre dream team, invitez vos amis avec un code secret et dominez le parcours.</p>
        <a href="/Equipe/Index" class="service-link">
            Gérer mes équipes <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="service-card card-commandite">
        <div class="service-icon commandite-icon">
            <i class="fas fa-handshake"></i>
        </div>
        <h3>Commandites</h3>
        <p>Devenez partenaire officiel. Choisissez votre palier Bronze, Argent ou Or et gagnez en visibilité.</p>
        <a href="/Sponsor/Index" class="service-link">
            Découvrir les paliers <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>
</div>

<!-- ========== POURQUOI NOUS ========== -->
<div class="why-section">
    <div class="why-content">
        <div class="why-text">
            <span class="why-badge">Pourquoi nous choisir ?</span>
            <h2>L'excellence du golf, <br><span class="gold-text">simplifiée.</span></h2>
            <div class="why-features">
                <div class="why-feature">
                    <div class="why-check"><i class="fas fa-check"></i></div>
                    <div>
                        <strong>Inscription en 2 minutes</strong>
                        <p>Processus simplifié, paiement sécurisé et confirmation instantanée.</p>
                    </div>
                </div>
                <div class="why-feature">
                    <div class="why-check"><i class="fas fa-check"></i></div>
                    <div>
                        <strong>Gestion d'équipe intuitive</strong>
                        <p>Créez votre équipe, partagez le code secret et suivez vos coéquipiers.</p>
                    </div>
                </div>
                <div class="why-feature">
                    <div class="why-check"><i class="fas fa-check"></i></div>
                    <div>
                        <strong>Support dédié</strong>
                        <p>Notre équipe est disponible pour vous accompagner à chaque étape.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="why-visual">
            <div class="why-card-stack">
                <div class="mini-card mc-1">
                    <i class="fas fa-shield-alt"></i>
                    <span>Paiement sécurisé</span>
                </div>
                <div class="mini-card mc-2">
                    <i class="fas fa-mobile-alt"></i>
                    <span>100% Responsive</span>
                </div>
                <div class="mini-card mc-3">
                    <i class="fas fa-bolt"></i>
                    <span>Temps réel</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== CTA FINAL ========== -->
<div class="cta-banner">
    <div class="cta-content">
        <h2>Prêt à rejoindre l'aventure ?</h2>
        <p>Inscrivez-vous dès maintenant et réservez votre place pour le prochain tournoi.</p>
        <div class="cta-actions">
            @if (!estConnecte)
            {
                <a href="/Auth/Register" class="btn-cta-primary">
                    Créer mon compte gratuitement
                </a>
            }
            else
            {
                <a href="/Tournoi/Index" class="btn-cta-primary">
                    Découvrir les tournois disponibles
                </a>
            }
            <a href="/Home/Contact" class="btn-cta-secondary">
                <i class="fas fa-headset me-2"></i> Nous contacter
            </a>
        </div>
    </div>
</div>

<!-- ========== STYLES ========== -->
<style>
    /* Hero */
    .hero-banner {
        background: var(--primary-navy);
        border-radius: 24px;
        padding: 60px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-premium);
    }
    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .hero-content {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 60px;
        position: relative;
        z-index: 2;
    }
    .hero-text { flex: 1; }
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(148, 163, 184, 0.15);
        color: var(--accent-silver);
        padding: 10px 20px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 25px;
    }
    .hero-title {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.1;
        margin: 0 0 15px;
        letter-spacing: -1px;
    }
    .silver-text {
        color: #fff;
        text-shadow: 0 0 15px rgba(255,255,255,0.3);
    }
    .hero-desc {
        color: rgba(255,255,255,0.65);
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 30px;
        max-width: 480px;
    }
    .hero-actions { display: flex; gap: 15px; flex-wrap: wrap; }
    .btn-hero-primary {
        background: #fff;
        color: var(--primary-navy);
        padding: 14px 32px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 800;
        font-size: 1rem;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(255,255,255,0.2);
    }
    .btn-hero-primary:hover {
        background: var(--light-silver);
        transform: translateY(-2px);
    }
    .btn-hero-secondary {
        background: transparent;
        color: #fff;
        padding: 14px 32px;
        border-radius: 12px;
        border: 2px solid rgba(255,255,255,0.3);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s;
    }
    .btn-hero-secondary:hover {
        background: rgba(255,255,255,0.1);
        border-color: #fff;
        transform: translateY(-2px);
    }
    .hero-visual { flex-shrink: 0; }
    .hero-img-wrapper {
        position: relative;
        width: 280px;
        height: 280px;
    }
    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }
    .hero-img-badge {
        position: absolute;
        bottom: -15px;
        left: -15px;
        background: var(--primary-navy);
        color: #fff;
        padding: 14px 20px;
        border-radius: 16px;
        text-align: center;
        border: 1px solid var(--accent-silver);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }
    .badge-number { font-size: 1.6rem; font-weight: 900; line-height: 1; }
    .badge-number sup { font-size: 0.7rem; }
    .badge-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }

    /* Stats */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 50px;
    }
    .stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #f1f5f9;
        transition: transform 0.3s;
    }
    .stat-card:hover { transform: translateY(-5px); }
    .stat-icon {
        width: 52px;
        height: 52px;
        background: var(--light-silver);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-navy);
        font-size: 1.3rem;
    }
    .stat-number {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--primary-navy);
        line-height: 1;
    }
    .stat-label {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 4px;
    }

    /* Section Headers */
    .section-header {
        text-align: center;
        margin-bottom: 35px;
    }
    .section-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #1a3c2a;
        margin-bottom: 8px;
    }
    .section-subtitle {
        color: #64748b;
        font-size: 1rem;
    }

    /* Services */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 50px;
    }
    .service-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 40px 32px;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255, 255, 255, 0.5);
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .service-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #1a3c2a, #D4AF37);
        transform: scaleX(0);
        transition: transform 0.35s;
    }
    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(26,60,42,0.1);
        border-color: transparent;
    }
    .service-card:hover::after { transform: scaleX(1); }
    .service-icon {
        width: 65px;
        height: 65px;
        background: rgba(26,60,42,0.08);
        color: #1a3c2a;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 20px;
        transition: all 0.3s;
    }
    .service-card:hover .service-icon {
        background: #1a3c2a;
        color: #D4AF37;
        transform: scale(1.1);
    }
    .equipe-icon { background: rgba(59,130,246,0.08); color: #3b82f6; }
    .service-card:hover .equipe-icon { background: #3b82f6; color: #fff; }
    .commandite-icon { background: rgba(212,175,55,0.1); color: #D4AF37; }
    .service-card:hover .commandite-icon { background: #D4AF37; color: #1a3c2a; }
    .service-card h3 {
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: #1e293b;
    }
    .service-card p {
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 18px;
    }
    .service-link {
        color: #1a3c2a;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.88rem;
        transition: all 0.2s;
    }
    .service-link:hover { color: #D4AF37; }

    /* Why Section */
    .why-section {
        background: #fff;
        border-radius: 24px;
        padding: 50px;
        margin-bottom: 30px;
        border: 1px solid #e2e8f0;
    }
    .why-content {
        display: flex;
        gap: 60px;
        align-items: center;
    }
    .why-text { flex: 1; }
    .why-badge {
        display: inline-block;
        background: rgba(26,60,42,0.07);
        color: #1a3c2a;
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 15px;
    }
    .why-text h2 {
        font-size: 1.8rem;
        font-weight: 800;
        color: #1a3c2a;
        margin-bottom: 30px;
        line-height: 1.3;
    }
    .why-features { display: flex; flex-direction: column; gap: 20px; }
    .why-feature {
        display: flex;
        gap: 15px;
        align-items: flex-start;
    }
    .why-check {
        width: 32px;
        height: 32px;
        min-width: 32px;
        background: rgba(26,60,42,0.08);
        color: #1a3c2a;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        margin-top: 2px;
    }
    .why-feature strong {
        display: block;
        font-size: 0.95rem;
        color: #1e293b;
        margin-bottom: 3px;
    }
    .why-feature p {
        color: #64748b;
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
    }
    .why-visual { flex-shrink: 0; width: 280px; }
    .why-card-stack {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    .mini-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 22px;
        border-radius: 16px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        transition: transform 0.3s;
    }
    .mini-card:hover { transform: translateX(8px); }
    .mini-card i { font-size: 1.2rem; }
    .mc-1 {
        background: linear-gradient(135deg, #1a3c2a, #2d6a2e);
        color: #D4AF37;
    }
    .mc-2 {
        background: #fff;
        color: #1a3c2a;
        border: 1px solid #e2e8f0;
    }
    .mc-3 {
        background: linear-gradient(135deg, #D4AF37, #e8c84a);
        color: #1a3c2a;
    }

    /* CTA */
    .cta-banner {
        background: linear-gradient(135deg, #1a3c2a 0%, #0d2818 100%);
        border-radius: 24px;
        padding: 50px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .cta-banner::before {
        content: '';
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(212,175,55,0.1) 0%, transparent 60%);
        border-radius: 50%;
    }
    .cta-content { position: relative; z-index: 2; }
    .cta-content h2 {
        color: #fff;
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 10px;
    }
    .cta-content p {
        color: rgba(255,255,255,0.6);
        margin-bottom: 30px;
        font-size: 1rem;
    }
    .cta-actions { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }
    .btn-cta-primary {
        background: linear-gradient(135deg, #D4AF37, #c9a030);
        color: #1a3c2a;
        padding: 16px 35px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.95rem;
        box-shadow: 0 4px 20px rgba(212,175,55,0.3);
        transition: all 0.3s;
    }
    .btn-cta-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(212,175,55,0.5);
        color: #1a3c2a;
    }
    .btn-cta-secondary {
        border: 2px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.8);
        padding: 16px 35px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }
    .btn-cta-secondary:hover {
        background: rgba(255,255,255,0.08);
        color: #fff;
    }

    /* Animations */
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-in {
        animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .hero-desc { animation-delay: 0.1s; }
    .hero-actions { animation-delay: 0.2s; }
    .hero-visual { animation: fadeInUp 1s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards; opacity: 0; }

    /* Responsive */
    @@media (max-width: 991px) {
        .hero-title { font-size: 2.8rem; }
        .hero-banner { padding: 40px; }
    }
    
    @@media (max-width: 768px) {
        .hero-content { flex-direction: column; text-align: center; }
        .hero-title { font-size: 2.2rem; }
        .hero-desc { max-width: 100%; margin: 0 auto 30px; }
        .hero-actions { justify-content: center; }
        .hero-visual { display: none; }
        .stats-row { flex-wrap: wrap; gap: 20px; padding: 25px; }
        .stat-divider { display: none; }
        .services-grid { grid-template-columns: 1fr; }
        .why-content { flex-direction: column; }
        .why-visual { width: 100%; }
        .why-card-stack { flex-direction: row; flex-wrap: wrap; }
        .mini-card { flex: 1; min-width: 150px; }
        .hero-banner, .why-section, .cta-banner { padding: 30px; }
        /* Weather widget responsive */
        .weather-details { flex-direction: column; gap: 15px; }
        .weather-extras { justify-content: center; }
    }
</style>

@section Scripts {
<style>
    /* ===== WIDGET MÉTÉO ===== */
    .weather-strip {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
        border-radius: 20px;
        margin: 0 0 30px 0;
