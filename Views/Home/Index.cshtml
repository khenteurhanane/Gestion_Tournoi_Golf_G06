</style>

@section Scripts {
<script>
(function() {
    // Detect weather gradient theme
    function applyWeatherTheme(code) {
        const card = document.getElementById('weatherWidget');
        const o1 = document.getElementById('wOrb1');
        const o2 = document.getElementById('wOrb2');
        if (!card) return;
        let bg, c1, c2;
        if (code === 0) { bg = 'linear-gradient(135deg,#1a6fc4 0%,#0e4a8c 100%)'; c1='rgba(255,200,50,0.35)'; c2='rgba(100,180,255,0.2)'; }
        else if (code <= 2) { bg = 'linear-gradient(135deg,#2d6ab4 0%,#154a8e 100%)'; c1='rgba(200,220,255,0.25)'; c2='rgba(255,200,50,0.15)'; }
        else if (code <= 3) { bg = 'linear-gradient(135deg,#3d4f6e 0%,#1e2d45 100%)'; c1='rgba(150,170,200,0.25)'; c2='rgba(100,130,170,0.2)'; }
        else if (code <= 49) { bg = 'linear-gradient(135deg,#4a5568 0%,#2d3748 100%)'; c1='rgba(160,170,185,0.25)'; c2='rgba(120,140,160,0.15)'; }
        else if (code <= 67) { bg = 'linear-gradient(135deg,#2c4a6e 0%,#1a3050 100%)'; c1='rgba(80,150,220,0.3)'; c2='rgba(30,100,180,0.2)'; }
        else if (code <= 77) { bg = 'linear-gradient(135deg,#3d5a80 0%,#1e3a5f 100%)'; c1='rgba(200,220,255,0.3)'; c2='rgba(150,200,255,0.2)'; }
        else { bg = 'linear-gradient(135deg,#1a2a4a 0%,#0d1b33 100%)'; c1='rgba(255,100,50,0.25)'; c2='rgba(255,180,50,0.2)'; }
        card.style.background = bg;
        if(o1) o1.style.background = `radial-gradient(circle, ${c1} 0%, transparent 70%)`;
        if(o2) o2.style.background = `radial-gradient(circle, ${c2} 0%, transparent 70%)`;
    }

    function calcGolfScore(code, rainProb, windSpeed) {
        if (code <= 2 && rainProb < 30 && windSpeed < 30) return [5,'Parfait','🏆'];
        if (code <= 3 && rainProb < 50) return [4,'Très bon','🏌️'];
        if (code <= 49 && rainProb < 60) return [3,'Correct','⛳'];
        if (code <= 67) return [2,'Difficile','🌂'];
        return [1,'Déconseillé','⛔'];
    }

    function updateGolfStars(score, label, emoji) {
        const starsEl = document.getElementById('weatherGolfStars');
        const emojiEl = document.getElementById('weatherGolfEmoji');
        const labelEl = document.getElementById('weatherGolfLabel');
        if (starsEl) {
            let html = '';
            for(let i=1;i<=5;i++) html += `<span class="wc-star ${i<=score?'filled':'empty'}">★</span>`;
            starsEl.innerHTML = html;
            if(labelEl) { starsEl.appendChild(Object.assign(document.createElement('span'),{className:'wc-golf-label',textContent:' '+label})); }
        }
        if(emojiEl) emojiEl.textContent = emoji;
    }

    function getWeatherInfo(c) {
        if(c===0) return ['☀️','Ciel dégagé'];
        if(c<=2) return ['⛅','Partiellement nuageux'];
        if(c<=3) return ['☁️','Couvert'];
        if(c<=49) return ['🌫️','Brouillard'];
        if(c<=57) return ['🌦️','Bruine légère'];
        if(c<=67) return ['🌧️','Pluie'];
        if(c<=77) return ['❄️','Neige'];
        if(c<=82) return ['🌦️','Averses'];
        return ['⛈️','Orage'];
    }

    // Fonction principale : charge la météo pour une lat/lon donnée
    function loadWeather(lat, lon, cityOverride) {
        fetch(`/Weather/GetWeather?lat=${lat}&lon=${lon}`)
            .then(r => r.json())
            .then(data => {
                const info = getWeatherInfo(data.weatherCode);
                const [score, label, emoji] = calcGolfScore(data.weatherCode, data.rainProb, data.windSpeed);
                const setText = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = val; };
                setText('weatherCityText', cityOverride || data.city);
                setText('weatherTempText', Math.round(data.temp) + '°');
                setText('weatherIconText', info[0]);
                setText('weatherDescText', info[1]);
                setText('weatherHumidityText', data.humidity + '%');
                setText('weatherWindText', Math.round(data.windSpeed) + ' km/h');
                setText('weatherRainText', data.rainProb + '%');
                setText('weatherUvText', data.uvIndex.toFixed(1));
                setText('weatherApparentText', Math.round(data.apparentTemp) + '°C');
                updateGolfStars(score, label, emoji);
                applyWeatherTheme(data.weatherCode);
            })
            .catch(() => {});
    }

    // Fallback via IP si GPS refusé
    function loadWeatherByIP() {
        fetch('https://ip-api.com/json/?lang=fr&fields=city,regionName,lat,lon,status')
            .then(r => r.json())
            .then(geo => {
                if (geo.status === 'success') {
                    const cityLabel = geo.city + ', ' + geo.regionName;
                    loadWeather(geo.lat, geo.lon, cityLabel);
                }
            })
            .catch(() => {});
    }

    // Indicateur de chargement
    const cityEl = document.getElementById('weatherCityText');
    if (cityEl) cityEl.textContent = 'Détection...';

    // GPS en premier — demande immédiate de permission
    if ('geolocation' in navigator) {
        navigator.geolocation.getCurrentPosition(
            function(pos) {
                const lat = pos.coords.latitude;
                const lon = pos.coords.longitude;
                // Géocodage inversé : obtenir le vrai nom de la ville
                fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json&accept-language=fr`)
                    .then(r => r.json())
                    .then(geo => {
                        const addr = geo.address || {};
                        const city = addr.city || addr.town || addr.village || addr.municipality || addr.county || '';
                        const province = addr.state || addr.region || '';
                        const cityLabel = city && province ? `${city}, ${province}` : (city || province || 'Ma position');
                        loadWeather(lat, lon, cityLabel);
                    })
                    .catch(() => loadWeather(lat, lon, 'Ma position'));
            },
            function() {
                // GPS refusé : fallback IP
                loadWeatherByIP();
            },
            { timeout: 8000, maximumAge: 300000 }
        );
    } else {
        // Navigateur sans GPS : fallback IP
        loadWeatherByIP();
    }

    // Apply initial theme from server-rendered code
    const initIcon = document.getElementById('weatherIconText');
    if (initIcon) {
        const ic = initIcon.textContent.trim();
        if(ic==='☀️') applyWeatherTheme(0);
        else if(ic==='⛅') applyWeatherTheme(1);
        else if(ic==='☁️') applyWeatherTheme(3);
        else if(ic==='🌧️') applyWeatherTheme(61);
        else if(ic==='❄️') applyWeatherTheme(71);
        else if(ic==='⛈️') applyWeatherTheme(95);
        else applyWeatherTheme(3);
    }

    // Live clock - updates every second
    function updateClock() {
        const now = new Date();
        const days = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
        const months = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
        const dayName = days[now.getDay()];
        const date = now.getDate();
        const month = months[now.getMonth()];
        const year = now.getFullYear();
        const hours = String(now.getHours()).padStart(2,'0');
        const mins = String(now.getMinutes()).padStart(2,'0');
        const secs = String(now.getSeconds()).padStart(2,'0');

        const dateEl = document.getElementById('weatherDateText');
        const timeEl = document.getElementById('weatherTimeText');
        if(dateEl) dateEl.textContent = `${dayName} ${date} ${month} ${year}`;
        if(timeEl) timeEl.textContent = `${hours}:${mins}:${secs}`;
    }
    updateClock();
    setInterval(updateClock, 1000);
})();
</script>
