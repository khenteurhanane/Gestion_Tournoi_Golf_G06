@using System.Globalization
@using Microsoft.AspNetCore.Http
@using croupe_06_TournoiGolf.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Accueil";

    bool estConnecte = HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true";
    var prochainTournoi = ViewBag.ProchainTournoi as Tournoi;
    int nbParticipants = ViewBag.NbParticipants ?? 0;
    int nbTournois = ViewBag.NbTournois ?? 0;
    int nbEquipes = ViewBag.NbEquipes ?? 0;
    int nbTournoisOuverts = ViewBag.NbTournoisOuverts ?? 0;

    string etiquetteHero = prochainTournoi != null
        ? "Inscriptions en cours"
        : "Plateforme officielle";

    string titreHero = prochainTournoi?.Nom ?? "Tournoi de Golf annuel du College La Cite";
    string descriptionHero = prochainTournoi != null
        ? $"Rejoignez-nous au {prochainTournoi.Lieu} pour une journee de competition, de reseautage et d'organisation professionnelle."
        : "Une plateforme unifiee pour inscrire les participants, gerer les equipes, suivre les commandites et piloter les tournois.";

    string dateProchainTournoi = prochainTournoi?.DateTournoi.ToString("d MMMM yyyy", new CultureInfo("fr-CA")) ?? "Date a confirmer";
    string statutProchainTournoi = prochainTournoi == null
        ? "Programmation en preparation"
        : (prochainTournoi.InscriptionsOuvertes ? "Inscriptions ouvertes" : "Inscriptions fermees");
    string lieuProchainTournoi = prochainTournoi?.Lieu ?? "Lieu a confirmer";
}

<div class="home-academic">
    <section class="academic-hero">
        <div class="academic-hero__media">
            <img src="/images/golf-hero.png" alt="Parcours de golf" class="academic-hero__image" />
            <div class="academic-hero__overlay"></div>
        </div>

        <div class="academic-hero__content">
            <span class="academic-chip">@etiquetteHero</span>
            <h1 class="academic-hero__title">@titreHero</h1>
            <p class="academic-hero__text">@descriptionHero</p>

            <div class="academic-hero__actions">
                @if (estConnecte)
                {
                    <a href="/Tournoi/Index" class="academic-btn academic-btn--primary">
                        <span>Voir les tournois</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="/Equipe/Index" class="academic-btn academic-btn--secondary">
                        <span>Mes equipes</span>
                        <i class="fas fa-users"></i>
                    </a>
                }
                else
                {
                    <a href="/Auth/Register" class="academic-btn academic-btn--primary">
                        <span>S'inscrire</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="/Sponsor/Index" class="academic-btn academic-btn--secondary">
                        <span>Devenir commanditaire</span>
                        <i class="fas fa-handshake"></i>
                    </a>
                }
            </div>

            <div class="academic-hero__facts">
                <div class="academic-fact">
                    <span class="academic-fact__label">Prochain tournoi</span>
                    <strong class="academic-fact__value">@dateProchainTournoi</strong>
                    <span class="academic-fact__meta">@lieuProchainTournoi</span>
                </div>
                <div class="academic-fact">
                    <span class="academic-fact__label">Inscriptions ouvertes</span>
                    <strong class="academic-fact__value">@nbTournoisOuverts</strong>
                    <span class="academic-fact__meta">tournoi(x) actif(s)</span>
                </div>
                <div class="academic-fact">
                    <span class="academic-fact__label">Equipes enregistrees</span>
                    <strong class="academic-fact__value">@nbEquipes</strong>
                    <span class="academic-fact__meta">@statutProchainTournoi</span>
                </div>
            </div>
        </div>
    </section>

    <section class="weather-card" id="weatherCard">
        <div class="weather-bg-orb orb-1"></div>
        <div class="weather-bg-orb orb-2"></div>

        <div class="wc-left">
            <div class="wc-location">
                <i class="fas fa-location-dot"></i>
                <span id="weatherCity">Conditions du tournoi</span>
            </div>

            <div class="wc-temp-block">
                <div class="wc-icon" id="weatherIcon">⛳</div>
                <div class="wc-temp" id="weatherTemp">--</div>
                <div class="wc-unit">°C</div>
            </div>

            <div class="wc-desc" id="weatherDesc">Chargement de la meteo...</div>
            <div class="wc-feels" id="weatherFeels">Mise a jour en direct pour la region du tournoi</div>
        </div>

        <div class="wc-divider"></div>

        <div class="wc-right">
            <div class="wc-date-row">
                <div class="wc-date" id="weatherDate">@DateTime.Now.ToString("dddd d MMMM", new CultureInfo("fr-CA"))</div>
                <div class="wc-time" id="weatherTime">@DateTime.Now.ToString("HH:mm")</div>
            </div>

            <div class="wc-stats">
                <div class="wc-stat-item">
                    <div class="wc-stat-icon"><i class="fas fa-wind"></i></div>
                    <div class="wc-stat-val" id="weatherWind">-- km/h</div>
                    <div class="wc-stat-lbl">Vent</div>
                </div>
                <div class="wc-stat-item">
                    <div class="wc-stat-icon"><i class="fas fa-droplet"></i></div>
                    <div class="wc-stat-val" id="weatherHumidity">--%</div>
                    <div class="wc-stat-lbl">Humidite</div>
                </div>
                <div class="wc-stat-item">
                    <div class="wc-stat-icon"><i class="fas fa-cloud-rain"></i></div>
                    <div class="wc-stat-val" id="weatherRain">--%</div>
                    <div class="wc-stat-lbl">Pluie</div>
                </div>
                <div class="wc-stat-item">
                    <div class="wc-stat-icon"><i class="fas fa-sun"></i></div>
                    <div class="wc-stat-val" id="weatherUv">--</div>
                    <div class="wc-stat-lbl">UV</div>
                </div>
            </div>

            <div class="wc-golf-rating">
                <div class="wc-golf-emoji">🏌️</div>
                <div>
                    <div class="wc-golf-title">Lecture golf du jour</div>
                    <div class="wc-golf-stars" id="golfStars"></div>
                    <div class="wc-golf-label" id="golfLabel">Evaluation en cours</div>
                </div>
            </div>
        </div>
    </section>

    <section class="academic-grid">
        <article class="academic-panel academic-panel--wide">
            <div class="academic-panel__header">
                <div class="academic-panel__icon">
                    <i class="fas fa-circle-info"></i>
                </div>
                <h2>A propos</h2>
            </div>

            <div class="academic-divider"></div>

            <p class="academic-panel__text">
                La plateforme Tournoi de Golf G06 centralise l'inscription, la creation d'equipes, le suivi des commandites et la gestion des tournois dans une interface plus claire et plus professionnelle.
            </p>

            <div class="academic-stats">
                <div class="academic-stat">
                    <span class="academic-stat__value">@nbParticipants</span>
                    <span class="academic-stat__label">Participants</span>
                </div>
                <div class="academic-stat">
                    <span class="academic-stat__value">@nbTournois</span>
                    <span class="academic-stat__label">Tournois</span>
                </div>
                <div class="academic-stat">
                    <span class="academic-stat__value">@nbEquipes</span>
                    <span class="academic-stat__label">Equipes</span>
                </div>
                <div class="academic-stat">
                    <span class="academic-stat__value">@nbTournoisOuverts</span>
                    <span class="academic-stat__label">Ouverts</span>
                </div>
            </div>
        </article>

        <article class="academic-panel academic-panel--details">
            <div class="academic-panel__accent"></div>

            <div class="academic-panel__header">
                <div class="academic-panel__icon">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h2>Details</h2>
            </div>

            <div class="academic-detail-list">
                <div class="academic-detail">
                    <div class="academic-detail__icon">
                        <i class="fas fa-calendar-day"></i>
                    </div>
                    <div>
                        <h3>Date</h3>
                        <p>@dateProchainTournoi</p>
                        <p>@statutProchainTournoi</p>
                    </div>
                </div>

                <div class="academic-detail">
                    <div class="academic-detail__icon">
                        <i class="fas fa-location-dot"></i>
                    </div>
                    <div>
                        <h3>Lieu</h3>
                        <p>@(prochainTournoi?.Lieu ?? "A determiner")</p>
                        <p>@(prochainTournoi != null ? $"{prochainTournoi.PlacesParticipantsMax} places disponibles au maximum" : "Consultez la liste des tournois pour plus d'information")</p>
                    </div>
                </div>
            </div>

            <a href="/Tournoi/Index" class="academic-btn academic-btn--ghost academic-btn--block">
                <span>Voir tous les tournois</span>
                <i class="fas fa-map"></i>
            </a>
        </article>
    </section>

    <section class="academic-partners">
        <div class="academic-partners__intro">
            <h2>Nos partenaires</h2>
            <p>
                Votre systeme de commandite fait deja partie du site. Cette section oriente les visiteurs vers les paliers et les opportunites de soutien reelles.
            </p>
        </div>

        <div class="academic-partners__grid">
            <a href="/Sponsor/Index" class="academic-logo-card">
                <span>Palier Bronze</span>
            </a>
            <a href="/Sponsor/Index" class="academic-logo-card">
                <span>Palier Argent</span>
            </a>
            <a href="/Sponsor/Index" class="academic-logo-card">
                <span>Palier Or</span>
            </a>
            <a href="/Home/Contact" class="academic-logo-card">
                <span>Partenariat sur mesure</span>
            </a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const weatherUrl = '/Weather/GetWeather';
            const dateFormatter = new Intl.DateTimeFormat('fr-CA', {
                weekday: 'long',
                day: 'numeric',
                month: 'long'
            });

            function mapWeather(code) {
                if ([0].includes(code)) return { icon: '☀️', label: 'Ciel degage' };
                if ([1, 2].includes(code)) return { icon: '🌤️', label: 'Partiellement ensoleille' };
                if ([3].includes(code)) return { icon: '☁️', label: 'Nuageux' };
                if ([45, 48].includes(code)) return { icon: '🌫️', label: 'Brume' };
                if ([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return { icon: '🌧️', label: 'Averses possibles' };
                if ([71, 73, 75, 77, 85, 86].includes(code)) return { icon: '❄️', label: 'Neige' };
                if ([95, 96, 99].includes(code)) return { icon: '⛈️', label: 'Orage' };
                return { icon: '⛳', label: 'Conditions variables' };
            }

            function buildGolfRating(weather) {
                let score = 5;
                if (weather.WindSpeed > 25) score -= 2;
                else if (weather.WindSpeed > 18) score -= 1;

                if (weather.RainProb > 60) score -= 2;
                else if (weather.RainProb > 30) score -= 1;

                if (weather.Temp < 8 || weather.Temp > 31) score -= 1;

                score = Math.max(1, Math.min(5, score));

                const labels = {
                    5: 'Excellente fenetre de jeu',
                    4: 'Tres bonnes conditions',
                    3: 'Conditions correctes',
                    2: 'Parcours plus exigeant',
                    1: 'Conditions difficiles'
                };

                return { score, label: labels[score] };
            }

            function renderStars(score) {
                const target = document.getElementById('golfStars');
                if (!target) return;
                target.innerHTML = '';
                for (let i = 1; i <= 5; i++) {
                    const span = document.createElement('span');
                    span.className = 'wc-star ' + (i <= score ? 'filled' : 'empty');
                    span.textContent = '★';
                    target.appendChild(span);
                }
            }

            function setFallback() {
                document.getElementById('weatherCity').textContent = 'Meteo indisponible';
                document.getElementById('weatherDesc').textContent = 'Le service meteo ne repond pas pour le moment.';
                document.getElementById('weatherFeels').textContent = 'Reessayez plus tard.';
                document.getElementById('weatherIcon').textContent = '🌥️';
                document.getElementById('golfLabel').textContent = 'Widget temporairement indisponible';
                renderStars(3);
            }

            fetch(weatherUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(async response => {
                    if (!response.ok) throw new Error('weather');
                    return await response.json();
                })
                .then(weather => {
                    const meta = mapWeather(weather.weatherCode);
                    const rating = buildGolfRating(weather);

                    document.getElementById('weatherCity').textContent = weather.city || 'Region du tournoi';
                    document.getElementById('weatherIcon').textContent = meta.icon;
                    document.getElementById('weatherTemp').textContent = Math.round(weather.temp);
                    document.getElementById('weatherDesc').textContent = meta.label;
                    document.getElementById('weatherFeels').textContent = 'Ressenti ' + Math.round(weather.apparentTemp) + '°C';
                    document.getElementById('weatherWind').textContent = Math.round(weather.windSpeed) + ' km/h';
                    document.getElementById('weatherHumidity').textContent = weather.humidity + '%';
                    document.getElementById('weatherRain').textContent = weather.rainProb + '%';
                    document.getElementById('weatherUv').textContent = weather.uvIndex.toFixed(1);
                    document.getElementById('weatherDate').textContent = dateFormatter.format(new Date());
                    document.getElementById('weatherTime').textContent = new Date().toLocaleTimeString('fr-CA', { hour: '2-digit', minute: '2-digit' });
                    document.getElementById('golfLabel').textContent = rating.label;
                    renderStars(rating.score);
                })
                .catch(() => setFallback());
        })();
    </script>
}
