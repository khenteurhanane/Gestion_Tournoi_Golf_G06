        margin-left: auto;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 10px 18px;
        color: rgba(255,255,255,0.85);
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        max-width: 280px;
    }
</style>
<script>
(function() {
    // API Open-Meteo — Ottawa, Ontario (aucune clé requise)
    const LAT = 45.4215;
    const LON = -75.6919;
    const CITY = "Ottawa, ON";

    const url = `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}` +
        `&current_weather=true` +
        `&hourly=relativehumidity_2m,precipitation_probability` +
        `&timezone=America/Toronto&forecast_days=1`;

    function getWeatherIcon(code) {
        if (code === 0) return "☀️";
        if (code <= 2) return "⛅";
        if (code === 3) return "☁️";
        if (code <= 49) return "🌫️";
        if (code <= 67) return "🌧️";
        if (code <= 77) return "❄️";
        if (code <= 82) return "🌦️";
        return "⛈️";
    }

    function getWeatherDesc(code) {
        if (code === 0) return "Ciel dégagé";
        if (code <= 2) return "Partiellement nuageux";
        if (code === 3) return "Couvert";
        if (code <= 49) return "Brouillard";
        if (code <= 57) return "Bruine";
        if (code <= 67) return "Pluie";
        if (code <= 77) return "Neige";
        if (code <= 82) return "Averses";
        return "Orage";
    }

    function getAdvice(code, rain) {
        if (code >= 61 || rain > 60) return "☔ Prévoir un imperméable — risque de pluie";
        if (code >= 45 && code <= 57) return "🌫️ Conditions brumeuses — conduite prudente";
        if (code === 0 || code <= 2) return "🏌️ Conditions idéales pour jouer !";
        if (code === 3) return "⛅ Temps couvert — confortable pour le golf";
        return "🌤️ Bonnes conditions de jeu";
    }

    fetch(url)
        .then(r => r.json())
        .then(data => {
            const cw = data.current_weather;
            const hourIndex = 0; // heure actuelle
            const humidity = data.hourly.relativehumidity_2m[hourIndex] ?? "--";
            const rainProb = data.hourly.precipitation_probability[hourIndex] ?? "--";

            document.getElementById('weatherTemp').textContent = Math.round(cw.temperature) + "°C";
            document.getElementById('weatherIcon').textContent = getWeatherIcon(cw.weathercode);
            document.getElementById('weatherDesc').textContent = getWeatherDesc(cw.weathercode);
            document.getElementById('weatherHumidity').textContent = humidity;
            document.getElementById('weatherWind').textContent = Math.round(cw.windspeed);
            document.getElementById('weatherRain').textContent = rainProb;
            document.getElementById('weatherCity').textContent = CITY;
            document.getElementById('weatherAdvice').innerHTML =
                '<span>' + getAdvice(cw.weathercode, rainProb) + '</span>';

            document.querySelector('.weather-loading').style.display = 'none';
            document.querySelector('.weather-content').style.display = 'block';
        })
        .catch(() => {
            document.querySelector('.weather-loading').innerHTML =
                '<i class="fas fa-exclamation-triangle"></i><span>Météo indisponible</span>';
        });
})();
</script>
}
