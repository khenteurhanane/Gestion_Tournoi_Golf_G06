@model croupe_06_TournoiGolf.Models.Commandite

@{
    ViewData["Title"] = "Créer une Commandite";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0">Nouvelle Commandite</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Creer" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TournoiId" class="form-label fw-bold">Tournoi à commanditer</label>
                            <select asp-for="TournoiId" class="form-select" required>
                                <option value="">-- Sélectionnez un tournoi --</option>
                                @foreach (var tournoi in ViewBag.Tournois)
                                {
                                    <option value="@tournoi.TournoiId">@tournoi.Nom - @tournoi.Lieu (@tournoi.DateTournoi.ToShortDateString())</option>
                                }
                            </select>
                            <span asp-validation-for="TournoiId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TypeCommandite" class="form-label fw-bold">Type de commandite</label>
                            <select asp-for="TypeCommandite" class="form-select" id="TypeCommandite" required>
                                <option value="">-- Sélectionnez un type --</option>
                                <option value="Bronze">Bronze (500 $)</option>
                                <option value="Argent">Argent (1 500 $)</option>
                                <option value="Or">Or (3 000 $)</option>
                                <option value="Autre">Autre montant</option>
                            </select>
                            <span asp-validation-for="TypeCommandite" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Montant" class="form-label fw-bold">Montant ($)</label>
                            <input asp-for="Montant" id="Montant" type="number" step="10.00" class="form-control" placeholder="1000.00" required />
                            <span asp-validation-for="Montant" class="text-danger"></span>
                            <small id="montantInfo" class="text-muted d-none">Ce montant est fixe pour ce type de commandite.</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Commentaire" class="form-label fw-bold">Commentaires ou détails (Optionnel)</label>
                            <textarea asp-for="Commentaire" class="form-control" rows="3" placeholder="Ex: Nom à afficher sur la pancarte du trou 7..."></textarea>
                            <span asp-validation-for="Commentaire" class="text-danger"></span>
                        </div>

                        <div id="avantagesSection" class="mb-4 d-none">
                            <h6 class="fw-bold mb-2"><i class="bi bi-star-fill text-warning me-2"></i>Avantages du palier :</h6>
                            <ul id="avantagesListe" class="list-unstyled small text-muted mb-0">
                                <!-- Rempli par JS -->
                            </ul>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border border-success">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="h6 mb-0 text-muted">Places incluses :</span>
                                <span id="displayPlaces" class="h6 mb-0 text-dark fw-bold">1 joueur</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h5 mb-0 text-dark">Montant total à payer :</span>
                                <span id="displayMontant" class="h3 mb-0 text-success fw-bold">0,00 $</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                            <button type="submit" class="btn btn-success px-4">Soumettre la commandite</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const typeSelect = document.getElementById("TypeCommandite");
            const montantInput = document.getElementById("Montant");
            const displayMontant = document.getElementById("displayMontant");

            function updateDisplay() {
                const val = parseFloat(montantInput.value) || 0;
                displayMontant.innerText = val.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD' });
            }

            typeSelect.addEventListener("change", function () {
                const selectedValue = this.value;
                const montantInfo = document.getElementById("montantInfo");
                
                if (selectedValue !== "Autre" && selectedValue !== "") {
                    // Type prédéfini
                    montantInput.readOnly = true;
                    montantInfo.classList.remove("d-none");
                } else {
                    // Type personnalisé ou vide
                    montantInput.readOnly = false;
                    montantInfo.classList.add("d-none");
                }

                const displayPlaces = document.getElementById("displayPlaces");
                const avantagesSection = document.getElementById("avantagesSection");
                const avantagesListe = document.getElementById("avantagesListe");
                
                let avantages = [];
                avantagesSection.classList.remove("d-none");

                switch (selectedValue) {
                    case "Bronze":
                        montantInput.value = "500.00";
                        displayPlaces.innerText = "1 joueur inclus";
                        avantages = ["Logo sur le site web", "Mention lors de la remise des prix"];
                        break;
                    case "Argent":
                        montantInput.value = "1500.00";
                        displayPlaces.innerText = "2 joueurs inclus";
                        avantages = ["Logo sur le site web & affiches", "Mention spéciale au coup d'envoi", "Soutien officiel Argent"];
                        break;
                    case "Or":
                        montantInput.value = "3000.00";
                        displayPlaces.innerText = "4 joueurs inclus";
                        avantages = ["Logo premium (Toutes plateformes)", "Pancarte personnalisée (Trou)", "Espace kiosque au club-house", "Équipe de 4 joueurs incluse"];
                        break;
                    default:
                        displayPlaces.innerText = "1 joueur inclus";
                        avantagesSection.classList.add("d-none");
                        if (selectedValue === "Autre") {
                             if(montantInput.value === "500.00" || montantInput.value === "1500.00" || montantInput.value === "3000.00" || montantInput.value === "0") {
                                 montantInput.value = "";
                             }
                        }
                        break;
                }

                // Afficher les avantages
                avantagesListe.innerHTML = "";
                avantages.forEach(txt => {
                    const li = document.createElement("li");
                    li.innerHTML = '<i class="bi bi-check2-circle text-success me-2"></i>' + txt;
                    avantagesListe.appendChild(li);
                });

                updateDisplay();
            });

            montantInput.addEventListener("input", updateDisplay);

            // Initial call
            updateDisplay();
        });
    </script>
}
