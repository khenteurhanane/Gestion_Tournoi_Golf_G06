@model IEnumerable<croupe_06_TournoiGolf.Models.Participant>
@{
    var commandite = (croupe_06_TournoiGolf.Models.Commandite)ViewBag.Commandite;
    ViewData["Title"] = "Gestion des joueurs sponsorisés";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0"><i class="fas fa-users"></i> Gestion des joueurs - @commandite.Tournoi.Nom</h3>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Informations de la commandite</h5>
                    <p><strong>Type :</strong> @commandite.TypeCommandite</p>
                    <p><strong>Montant :</strong> @commandite.Montant.ToString("C")</p>
                    <p><strong>Statut :</strong> 
                        @if (commandite.Statut == "PAYEE") { <span class="badge bg-success">Payée</span> }
                        else { <span class="badge bg-warning text-dark">En attente</span> }
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">Retour à mes commandites</a>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="row">
                <!-- Formulaire d'ajout -->
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6><i class="fas fa-plus-circle"></i> Ajouter un joueur</h6>
                            <form asp-action="AjouterJoueur" method="post">
                                <input type="hidden" name="commanditeId" value="@commandite.CommanditeId" />
                                <div class="mb-3">
                                    <label class="form-label">Prénom</label>
                                    <input type="text" name="prenom" class="form-control" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nom</label>
                                    <input type="text" name="nom" class="form-control" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="email" class="form-control" required />
                                </div>
                                <button type="submit" class="btn btn-success w-100" @(commandite.Statut != "PAYEE" ? "disabled" : "")>
                                    Ajouter le joueur
                                </button>
                                @if (commandite.Statut != "PAYEE")
                                {
                                    <small class="text-danger d-block mt-2">Le paiement est requis pour ajouter des joueurs.</small>
                                }
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Liste des joueurs -->
                <div class="col-md-8">
                    <h6>Joueurs inscrits (@Model.Count() / 4)</h6>
                    @if (!Model.Any())
                    {
                        <div class="text-center py-4 bg-white border rounded">
                            <p class="text-muted mb-0">Aucun joueur ajouté pour le moment.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Nom Complet</th>
                                    <th>Email</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model)
                                {
                                    <tr>
                                        <td>@p.Prenom @p.Nom</td>
                                        <td>@p.Email</td>
                                        <td>
                                            <form asp-action="SupprimerJoueur" method="post" onsubmit="return confirm('Retirer ce joueur ?');">
                                                <input type="hidden" name="participantId" value="@p.ParticipantId" />
                                                <input type="hidden" name="commanditeId" value="@commandite.CommanditeId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i> Retirer
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
