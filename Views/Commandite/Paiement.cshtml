@model croupe_06_TournoiGolf.Models.Commandite
@{
    ViewData["Title"] = "Paiement Sécurisé";
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">

<div class="premium-payment-wrapper">
    <!-- Fond décoratif -->
    <div class="bg-blur-circle circle-1"></div>
    <div class="bg-blur-circle circle-2"></div>

    <div class="glass-payment-card animate__animated animate__fadeIn">
        <div class="payment-header">
            <div class="status-badge">Transaction Sécurisée</div>
            <h1 class="header-title">Finalisez votre engagement</h1>
            <p class="header-subtitle">Partenariat pour le <span>@Model.Tournoi.Nom</span></p>
        </div>

        <div class="payment-main-grid">
            <!-- Section Gauche : Récapitulatif -->
            <div class="summary-section">
                <div class="summary-item">
                    <span class="label">Forfait choisi</span>
                    <span class="value-badge @Model.TypeCommandite.ToLower()">@Model.TypeCommandite</span>
                </div>
                <div class="summary-divider"></div>
                <div class="total-container">
                    <div class="total-label">Total à régler</div>
                    <div class="total-price">@Model.Montant.ToString("C")</div>
                </div>
                
                <!-- Visualisation de la carte dynamique -->
                <div class="virtual-card-preview" id="cardPreview">
                    <div class="card-chip"></div>
                    <div class="card-number-display" id="disp-card-number">•••• •••• •••• ••••</div>
                    <div class="card-bottom">
                        <div class="card-holder">
                            <div class="mini-label">Titulaire</div>
                            <div class="name-display" id="disp-card-name">VALUED SPONSOR</div>
                        </div>
                        <div class="card-expiry">
                            <div class="mini-label">Expire</div>
                            <div class="expiry-display" id="disp-card-expiry">MM/AA</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section Droite : Formulaire -->
            <div class="form-section">
                <div class="method-selector">
                    <button type="button" class="method-btn active" id="btn-card" onclick="toggleMethod('card')">
                        <i class="fas fa-credit-card"></i> Carte
                    </button>
                    <button type="button" class="method-btn" id="btn-interac" onclick="toggleMethod('interac')">
                        <i class="fas fa-university"></i> Virement Interac
                    </button>
                </div>

                <form asp-action="SimulerPaiement" method="post" id="paymentForm" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="commanditeId" value="@Model.CommanditeId" />
                    <input type="hidden" name="methodePaiement" id="methodePaiement" value="Carte de Crédit/Débit" />

                    <div id="cardFields">
                        <div class="floating-group">
                            <input type="text" id="cardName" class="premium-input" placeholder=" " 
                                   value="@(string.IsNullOrEmpty(Model.Utilisateur.NomEntreprise) ? $"{Model.Utilisateur.Prenom} {Model.Utilisateur.Nom}" : Model.Utilisateur.NomEntreprise)" required />
                            <label>Nom complet sur la carte</label>
                        </div>

                        <div class="floating-group">
                            <input type="text" id="cardNumber" class="premium-input" placeholder=" " maxlength="19" required />
                            <label>Numéro de carte</label>
                            <i class="fas fa-credit-card input-icon"></i>
                        </div>

                        <div class="input-row">
                            <div class="floating-group">
                                <input type="text" id="cardExpiry" class="premium-input" placeholder=" " maxlength="5" required />
                                <label>Expiration (MM/AA)</label>
                            </div>
                            <div class="floating-group">
                                <input type="password" id="cardCvv" class="premium-input" placeholder=" " maxlength="3" required />
                                <label>CVV</label>
                            </div>
                        </div>
                    </div>

                    <div id="interacFields" style="display:none;">
                        <div class="interac-box">
                            <div class="interac-icon"><i class="fas fa-info-circle"></i></div>
                            <div class="interac-content">
                                <p>Effectuez votre virement à : <strong>virement@golfg06.ca</strong></p>
                                <p>Question : <strong>Commandite #@Model.CommanditeId</strong></p>
                                <p>Réponse : <strong>Golf2024</strong></p>
                            </div>
                        </div>
                    </div>

                    <div class="loader-overlay" id="paymentLoader" style="display:none;">
                        <div class="spinner"></div>
                        <p>Sécurisation en cours...</p>
                    </div>

                    <button type="submit" class="premium-submit-btn" id="submitBtn">
                        <span>Confirmer le paiement</span>
                        <i class="fas fa-lock"></i>
                    </button>
                </form>
            </div>
        </div>
        
        <div class="payment-footer">
            <p><i class="fas fa-shield-alt"></i> Cryptage SSL 256 bits · PCI-DSS Compliant</p>
            <a asp-action="Index">Annuler la transaction</a>
        </div>
    </div>
</div>

<style>
/* CSS haut de gamme pour l'expérience premium */
:root {
    --gold-grad: linear-gradient(135deg, #c8a84e 0%, #a88a30 100%);
    --green-grad: linear-gradient(135deg, #1b4332 0%, #2d6a2e 100%);
    --premium-font: 'Outfit', sans-serif;
}

.premium-payment-wrapper {
    font-family: var(--premium-font);
    position: relative;
    padding: 60px 20px;
    display: flex;
    justify-content: center;
    overflow: hidden;
}

.bg-blur-circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
}
.circle-1 { width: 400px; height: 400px; background: rgba(45, 106, 46, 0.15); top: -100px; left: -100px; }
.circle-2 { width: 300px; height: 300px; background: rgba(200, 168, 78, 0.1); bottom: -50px; right: -50px; }

.glass-payment-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 30px;
    width: 100%;
    max-width: 950px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.1);
    padding: 50px;
    z-index: 1;
}

.status-badge {
    background: rgba(45, 106, 46, 0.1);
    color: #2d6a2e;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-block;
    margin-bottom: 15px;
}

.header-title { font-size: 2.5rem; font-weight: 800; color: #1a2e12; margin: 0; }
.header-subtitle { color: #5a7a4a; font-size: 1.1rem; margin-top: 5px; }
.header-subtitle span { font-weight: 600; color: #1b4332; }

.payment-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    margin-top: 40px;
}

/* Virtual Card */
.virtual-card-preview {
    background: linear-gradient(135deg, #1b4332 0%, #0c2018 100%);
    border-radius: 20px;
    padding: 30px;
    color: white;
    height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    margin-top: 30px;
    position: relative;
}

.card-chip {
    width: 45px; height: 35px;
    background: linear-gradient(135deg, #ffd700 0%, #b8860b 100%);
    border-radius: 8px;
}

.card-number-display { font-size: 1.4rem; letter-spacing: 2px; font-family: monospace; }
.card-bottom { display: flex; justify-content: space-between; }
.mini-label { font-size: 0.6rem; text-transform: uppercase; opacity: 0.6; }
.name-display, .expiry-display { font-size: 0.9rem; font-weight: 600; }

.summary-item { display: flex; justify-content: space-between; align-items: center; }
.value-badge { padding: 4px 12px; border-radius: 6px; font-weight: 800; text-transform: uppercase; font-size: 0.8rem; }
.value-badge.or { background: #fee2e2; color: #991b1b; } /* Custom style */
.total-price { font-size: 2.2rem; font-weight: 800; color: #2d6a2e; }

/* Inputs floating */
.floating-group { position: relative; margin-bottom: 25px; }
.premium-input {
    width: 100%; padding: 15px; border-radius: 12px;
    border: 2px solid #e2e8f0; background: white;
    font-weight: 600; font-size: 1rem; transition: all 0.3s;
}
.floating-group label {
    position: absolute; left: 15px; top: 15px;
    color: #94a3b8; pointer-events: none; transition: all 0.3s;
}
.premium-input:focus ~ label, .premium-input:not(:placeholder-shown) ~ label {
    top: -10px; left: 10px; font-size: 0.75rem; background: white; padding: 0 5px; color: #2d6a2e;
}

.method-selector { display: flex; gap: 10px; }
.method-btn {
    flex: 1; padding: 12px; border-radius: 12px; border: 2px solid #e2e8f0;
    background: white; font-weight: 600; transition: 0.2s; cursor: pointer;
}
.method-btn.active { border-color: #2d6a2e; background: rgba(45, 106, 46, 0.05); color: #2d6a2e; }

.premium-submit-btn {
    width: 100%; padding: 18px; border-radius: 15px; border: none;
    background: var(--green-grad); color: white; font-size: 1.1rem;
    font-weight: 700; cursor: pointer; display: flex; justify-content: center; gap: 15px;
    box-shadow: 0 10px 20px rgba(45, 106, 46, 0.2); transition: 0.3s;
}
.premium-submit-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(45, 106, 46, 0.3); }

.payment-footer { margin-top: 40px; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 20px; }
.payment-footer p { color: #94a3b8; font-size: 0.8rem; }
.payment-footer a { color: #5a7a4a; text-decoration: underline; font-size: 0.9rem; }

.summary-divider { height: 1px; background: #e2e8f0; margin: 20px 0; }
.loader-overlay {
    position: absolute; inset: 0; background: rgba(255,255,255,0.9);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    z-index: 100; border-radius: 30px;
}
.spinner { width: 40px; height: 40px; border: 4px solid #e2e8f0; border-top: 4px solid #2d6a2e; border-radius: 50%; animation: spin 1s linear infinite; }
@@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

@media (max-width: 850px) {
    .payment-main-grid { grid-template-columns: 1fr; }
    .glass-payment-card { padding: 30px; }
}
</style>

@section Scripts {
    <script>
        // Synchronisation carte virtuelle
        const cardNameInput = document.getElementById('cardName');
        const cardNumberInput = document.getElementById('cardNumber');
        const cardExpiryInput = document.getElementById('cardExpiry');
        
        cardNameInput.addEventListener('input', (e) => {
            document.getElementById('disp-card-name').textContent = e.target.value.toUpperCase() || "VALUED SPONSOR";
        });

        cardNumberInput.addEventListener('input', (e) => {
            let val = e.target.value.replace(/\D/g, '');
            let formatted = val.match(/.{1,4}/g)?.join(' ') || "";
            if (formatted.length > 19) formatted = formatted.substring(0, 19);
            e.target.value = formatted;
            document.getElementById('disp-card-number').textContent = formatted || "•••• •••• •••• ••••";
        });

        cardExpiryInput.addEventListener('input', (e) => {
            let val = e.target.value.replace(/\D/g, '');
            if (val.length > 4) val = val.substring(0, 4);
            if (val.length > 2) val = val.substring(0,2) + '/' + val.substring(2,4);
            e.target.value = val;
            document.getElementById('disp-card-expiry').textContent = val || "MM/AA";
        });

        function toggleMethod(m) {
            const cardFields = document.getElementById('cardFields');
            const interacFields = document.getElementById('interacFields');
            const btnCard = document.getElementById('btn-card');
            const btnInterac = document.getElementById('btn-interac');
            const methodePaiement = document.getElementById('methodePaiement');

            if (m === 'card') {
                cardFields.style.display = 'block';
                interacFields.style.display = 'none';
                btnCard.classList.add('active');
                btnInterac.classList.remove('active');
                methodePaiement.value = "Carte de Crédit/Débit";
            } else {
                cardFields.style.display = 'none';
                interacFields.style.display = 'block';
                btnCard.classList.remove('active');
                btnInterac.classList.add('active');
                methodePaiement.value = "Virement Interac";
            }
        }

        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            document.getElementById('submitBtn').style.opacity = '0.5';
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('paymentLoader').style.display = 'flex';
            
            const form = this;
            setTimeout(() => { form.submit(); }, 2000);
            e.preventDefault();
        });
    </script>
}
