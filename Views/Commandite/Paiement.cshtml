@model croupe_06_TournoiGolf.Models.Commandite
@{
    ViewData["Title"] = "Paiement de la Commandite";
}

<div class="payment-container">
    <div class="payment-card">
        <h1 class="payment-title">Finalisez votre commandite</h1>
        <p class="payment-subtitle">Tournoi : <strong>@Model.Tournoi.Nom</strong></p>
        
        <div class="payment-details">
            <div class="detail-row">
                <span>Type de commandite :</span>
                <span class="detail-value">@Model.TypeCommandite</span>
            </div>
            <hr />
            <div class="detail-row total-row">
                <span>Montant à payer :</span>
                <span class="total-amount">@Model.Montant.ToString("C")</span>
            </div>
        </div>

        <div class="payment-form-section mt-4">
            <h3 class="section-title">Mode de paiement</h3>
            
            <div class="payment-methods-tabs mb-4">
                <button type="button" class="method-tab active" onclick="switchPaymentMethod('card')">
                    <i class="fas fa-credit-card"></i> Carte Débit/Crédit
                </button>
                <button type="button" class="method-tab" onclick="switchPaymentMethod('interac')">
                    <i class="fas fa-exchange-alt"></i> Virement Interac
                </button>
            </div>

            <!-- Formulaire de simulation de paiement - US-11-T04 -->
            <form asp-action="SimulerPaiement" method="post" id="paymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="commanditeId" value="@Model.CommanditeId" />
                <input type="hidden" name="methodePaiement" id="methodePaiement" value="Carte de Crédit/Débit" />
                
                <!-- Section Carte -->
                <div id="cardSection">
                    <div class="form-group">
                        <label>Titulaire de la carte</label>
                        <input type="text" value="@(string.IsNullOrEmpty(Model.Utilisateur.NomEntreprise) ? $"{Model.Utilisateur.Prenom} {Model.Utilisateur.Nom}" : Model.Utilisateur.NomEntreprise)" required />
                    </div>
                    
                    <div class="form-group">
                        <label>Numéro de carte de crédit</label>
                        <div class="card-input-wrapper">
                            <input type="text" placeholder="4540 1234 5678 9012" maxlength="19" required />
                            <span class="card-type-icon">VISA / MC</span>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group col-half">
                            <label>Date d'expiration</label>
                            <input type="text" placeholder="MM/AA" maxlength="5" required />
                        </div>
                        <div class="form-group col-half">
                            <label>CVV (Code de sécurité)</label>
                            <input type="password" placeholder="***" maxlength="3" required />
                        </div>
                    </div>
                </div>

                <!-- Section Interac (Cachée par défaut) -->
                <div id="interacSection" style="display:none;">
                    <div class="interac-instructions text-start">
                        <p class="mb-3">Pour finaliser votre commandite, veuillez effectuer un virement Interac aux coordonnées suivantes :</p>
                        <div class="interac-detail">
                            <strong>Courriel :</strong> <span>paiement@golfg06.com</span>
                        </div>
                        <div class="interac-detail">
                            <strong>Question :</strong> <span>Numéro de Commandite</span>
                        </div>
                        <div class="interac-detail">
                            <strong>Réponse :</strong> <span>Golf2024</span>
                        </div>
                        <p class="mt-3 small text-muted">Note : Votre commandite sera confirmée une fois le virement reçu.</p>
                    </div>
                </div>

                <p class="text-muted small mb-3 text-start mt-3">
                    <i class="fas fa-lock text-success"></i> Transaction sécurisée et cryptée. Les données ne sont pas conservées.
                </p>
                
                <!-- Zone d'attente (spinner) affichée pendant le traitement simulé -->
                <div id="paymentLoader" style="display: none;">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Traitement...</span>
                    </div>
                    <p class="mt-2 text-success fw-bold">Traitement de la transaction en cours...</p>
                </div>

                <button type="submit" class="btn btn-payment-simulate" id="btnPayer">
                    <span class="btn-text">Confirmer le paiement de @Model.Montant.ToString("C")</span>
                    <span class="btn-icon">💳</span>
                </button>
            </form>
        </div>
        
        <div class="mt-3">
            <a asp-action="Index" class="text-muted text-decoration-none small">Annuler et revenir plus tard</a>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-gold: #D4AF37;
        --dark-bg: #1a1a1a;
        --card-bg: #ffffff;
        --text-dark: #333;
    }

    .payment-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 2rem;
        background: #f8f9fa;
    }

    .payment-card {
        background-color: var(--card-bg);
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        padding: 3rem;
        width: 100%;
        max-width: 550px;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .payment-title {
        color: #198754;
        font-weight: 800;
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
    }

    .payment-subtitle {
        color: #666;
        margin-bottom: 2rem;
        font-size: 1.1rem;
    }

    .payment-details {
        background: #f1f8f5;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 1px dashed #198754;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        color: #555;
    }

    .detail-value {
        font-weight: bold;
        color: #333;
    }

    .total-row {
        margin-top: 1rem;
        font-size: 1.2rem;
        color: #333;
    }

    .total-amount {
        color: #198754;
        font-size: 1.8rem;
        font-weight: 900;
    }

    .section-title {
        color: #333;
        font-size: 1.2rem;
        text-align: left;
        margin-bottom: 1.5rem;
        font-weight: 700;
        border-bottom: 2px solid #eee;
        padding-bottom: 0.5rem;
    }

    .form-group {
        text-align: left;
        margin-bottom: 1.2rem;
    }

    .form-group label {
        display: block;
        color: #777;
        font-size: 0.85rem;
        margin-bottom: 0.4rem;
        font-weight: 600;
    }

    .form-group input {
        width: 100%;
        background: #fdfdfd;
        border: 1.5px solid #dee2e6;
        border-radius: 10px;
        padding: 0.9rem;
        color: #333;
        transition: border-color 0.2s;
    }

    .form-group input:focus {
        border-color: #198754;
        outline: none;
    }

    .card-input-wrapper {
        position: relative;
    }

    .card-type-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-weight: bold;
        color: #666;
        font-size: 0.8rem;
        background: #eee;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .form-row {
        display: flex;
        gap: 15px;
    }

    .col-half {
        flex: 1;
    }

    .btn-payment-simulate {
        background: linear-gradient(135deg, #198754 0%, #146c43 100%);
        border: none;
        color: white;
        padding: 1.2rem;
        font-size: 1.2rem;
        font-weight: bold;
        border-radius: 12px;
        width: 100%;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 1rem;
        box-shadow: 0 4px 15px rgba(25, 135, 84, 0.3);
    }

    .btn-payment-simulate:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(25, 135, 84, 0.4);
    }

    /* New styles for payment methods */
    .payment-methods-tabs {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .method-tab {
        flex: 1;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #666;
        padding: 10px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .method-tab.active {
        background: #e8f5e9;
        border-color: #198754;
        color: #198754;
    }

    .method-tab i {
        margin-right: 5px;
    }

    .interac-instructions {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px dashed #198754;
    }

    .interac-detail {
        margin-bottom: 0.5rem;
    }

    .interac-detail strong {
        color: #198754;
        width: 120px;
        display: inline-block;
    }
</style>

@section Scripts {
    <script>
        function switchPaymentMethod(method) {
            const cardSection = document.getElementById('cardSection');
            const interacSection = document.getElementById('interacSection');
            const methodInput = document.getElementById('methodePaiement');
            const tabs = document.querySelectorAll('.method-tab');
            
            tabs.forEach(tab => tab.classList.remove('active'));
            
            if (method === 'card') {
                cardSection.style.display = 'block';
                interacSection.style.display = 'none';
                methodInput.value = "Carte de Crédit/Débit";
                tabs[0].classList.add('active');
                // Re-ajouter les attributs 'required'
                cardSection.querySelectorAll('input').forEach(i => i.required = true);
            } else {
                cardSection.style.display = 'none';
                interacSection.style.display = 'block';
                methodInput.value = "Virement Interac";
                tabs[1].classList.add('active');
                // Enlever les attributs 'required' pour ne pas bloquer le formulaire
                cardSection.querySelectorAll('input').forEach(i => i.required = false);
            }
        }

        // Gestion de la soumission du formulaire avec délai de simulation
        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            // Empêcher la soumission multiple et basculer l'affichage (bouton -> spinner)
            document.getElementById('btnPayer').style.display = 'none';
            document.getElementById('paymentLoader').style.display = 'block';
            
            // Simulation d'un délai de communication réseau de 1.5 seconde
            const form = this;
            setTimeout(() => {
                form.submit();
            }, 1500);
            
            e.preventDefault(); // Suspendre la soumission immédiate
        });
    </script>
}

