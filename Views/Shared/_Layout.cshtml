<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tournoi de Golf G06</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css?v=20260331" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="dashboard-body">
    @using Microsoft.AspNetCore.Http
    @using Microsoft.AspNetCore.Mvc.Localization
    @inject IViewLocalizer Localizer
    @inject IHttpContextAccessor HttpContextAccessor
    @{
        bool estConnecte = HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true";
        string role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "";
        string prenom = HttpContextAccessor.HttpContext?.Session.GetString("UserPrenom") ?? "";
        string nom = HttpContextAccessor.HttpContext?.Session.GetString("UserNom") ?? "";
        string currentLang = HttpContextAccessor.HttpContext?.Session.GetString("Lang") ?? "FR";
    }

    <div class="app-container">
        <!-- Sidebar -->
        <aside class="app-sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-golf-ball"></i>
                    <span>Golf G06</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a href="/" class="@(ViewData["Title"]?.ToString() == "Accueil" ? "active" : "")">
                    <i class="fas fa-home"></i> <span>@(currentLang == "EN" ? "Home" : "Accueil")</span>
                </a>
                <a href="/Tournoi/Index" class="@(ViewData["Title"]?.ToString() == "Liste des Tournois" ? "active" : "")">
                    <i class="fas fa-calendar-alt"></i> <span>@(currentLang == "EN" ? "Tournaments" : "Tournois")</span>
                </a>
                <a href="/Sponsor/Index" class="@(ViewData["Title"]?.ToString() == "Paliers de Commandite" ? "active" : "")">
                    <i class="fas fa-star text-warning"></i> <span>@(currentLang == "EN" ? "Become a Sponsor" : "Commanditer")</span>
                </a>
                <a href="/Boutique/Index" class="@(ViewData["Title"]?.ToString() == "Boutique" ? "active" : "")">
                    <i class="fas fa-store text-success"></i> <span>@(currentLang == "EN" ? "Shop" : "Magasiner")</span>
                </a>
                
                @if (estConnecte)
                {
                    <div class="nav-divider">Menu Utilisateur</div>
                    
                    @if (role == "ADMIN")
                    {
                        <a href="/Admin/Index" class="@(ViewData["Title"]?.ToString() == "Espace Administrateur" ? "index" == "active" ? "active" : "" : "")">
                            <i class="fas fa-chart-pie"></i> <span>Dashboard Admin</span>
                        </a>
                        <a href="/Admin/Utilisateurs">
                            <i class="fas fa-users-cog"></i> <span>Utilisateurs</span>
                        </a>
                        <a href="/Admin/Participants">
                            <i class="fas fa-user-tag"></i> <span>Participants</span>
                        </a>
                    }
                    else if (role == "COMMANDITAIRE")
                    {
                        <a href="/Commandite/Index">
                            <i class="fas fa-handshake"></i> <span>Mes commandites</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Equipe/Index">
                            <i class="fas fa-user-friends"></i> <span>Mes équipes</span>
                        </a>
                        <a href="/Auth/MesInscriptions">
                            <i class="fas fa-check-circle"></i> <span>Mes inscriptions</span>
                        </a>
                    }

                    <a href="/Auth/Profil">
                        <i class="fas fa-user-circle"></i> <span>Mon profil</span>
                    </a>
                }
                
                <div class="nav-bottom">
                    <a href="/Home/Contact">
                        <i class="fas fa-envelope"></i> <span>Contact</span>
                    </a>
                    @if (estConnecte)
                    {
                        <a href="/Auth/Logout" class="logout-link">
                            <i class="fas fa-sign-out-alt"></i> <span>Déconnexion</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="login-link">
                            <i class="fas fa-sign-in-alt"></i> <span>Connexion</span>
                        </a>
                    }
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="app-main">
            <!-- Topbar -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <!-- Bouton hamburger TOUJOURS visible -->
                    <button class="hamburger-btn" id="sidebarToggle" aria-label="Menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h2 class="page-title">@ViewData["Title"]</h2>
                    <span class="page-subtitle">Gestion du tournoi annuel</span>
                </div>
                <div class="topbar-right">
                    <div class="lang-switcher me-4">
                        @{
                            string targetLang = currentLang == "FR" ? "EN" : "FR";
                        }
                        <a href="/Home/SetLanguage?lang=@targetLang" class="lang-btn">
                            <span class="lang-flag">@(currentLang == "FR" ? "🇫🇷" : "🇬🇧")</span>
                            <span class="ms-2">@currentLang</span>
                            <i class="fas fa-sync-alt ms-2" style="font-size: 0.7rem; opacity: 0.5;"></i>
                        </a>
                    </div>
                    @if (estConnecte)
                    {
                        <div class="user-profile">
                            <div class="user-info">
                                <span class="user-name">@prenom @nom</span>
                                <span class="user-role">@role</span>
                            </div>
                            <div class="user-avatar">
                                @prenom[0]
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="btn btn-sm btn-login-topbar">Se connecter</a>
                    }
                </div>
            </header>

            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    </div>
    <!-- Overlay mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <style>
        :root {
            --sidebar-width: 250px;
            --topbar-height: 75px;
            --primary-navy: #0f172a;
            --dark-navy: #020617;
            --accent-silver: #94a3b8;
            --light-silver: #f1f5f9;
            --bg-light: #f8fafc;
            --sidebar-bg: #0f172a;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: rgba(148, 163, 184, 0.1);
            --card-bg: #ffffff;
            --shadow-premium: 0 10px 30px rgba(15, 23, 42, 0.05);
        }

        body.dashboard-body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            color: var(--text-main);
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar - cachée par défaut, s'ouvre au clic */
        .app-sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            position: fixed;
            height: 100vh;
            display: flex;
            flex-direction: column;
            z-index: 300;
            box-shadow: 4px 0 30px rgba(0,0,0,0.15);
            transform: translateX(-100%);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .app-sidebar.open {
            transform: translateX(0);
        }

        .sidebar-header {
            padding: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.25rem;
            color: #fff;
            font-family: 'Outfit', sans-serif;
        }

        .logo i { color: var(--accent-silver); }

        .sidebar-nav {
            padding: 20px 0;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .sidebar-nav a {
            padding: 14px 25px;
            margin: 4px 15px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            color: rgba(255,255,255,0.7);
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 0.95rem;
            position: relative;
            overflow: hidden;
        }

        .sidebar-nav a i {
            width: 20px;
            font-size: 1.1rem;
        }

        .sidebar-nav a:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }

        .sidebar-nav a.active {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-weight: 700;
            border-right: 3px solid var(--accent-silver);
        }
        
        .sidebar-nav a.active i {
            color: var(--accent-silver);
        }

        .nav-divider {
            padding: 20px 25px 10px;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3);
            font-weight: 700;
        }

        .nav-bottom {
            margin-top: auto;
            padding-bottom: 20px;
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 10px;
        }

        .logout-link:hover {
            color: #ff6b6b !important;
            background: rgba(255, 107, 107, 0.1) !important;
        }

        .login-link:hover {
            color: var(--accent-gold) !important;
        }

        /* Main Content - toujours plein écran, sidebar par-dessus */
        .app-main {
            flex: 1;
            margin-left: 0;
            display: flex;
            flex-direction: column;
        }

        .app-topbar {
            height: var(--topbar-height);
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .topbar-left {
            display: flex;
            flex-direction: column;
        }

        .page-title {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            color: var(--primary-navy);
            line-height: 1.2;
            font-family: 'Outfit', sans-serif;
            letter-spacing: -0.5px;
        }

        .page-subtitle {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .btn-login-topbar {
            background: var(--primary-navy);
            color: #fff !important;
            border-radius: 10px;
            font-weight: 700;
            padding: 10px 24px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
            transition: all 0.3s ease;
            font-family: 'Outfit', sans-serif;
        }

        .btn-login-topbar:hover {
            transform: translateY(-2px);
            background: var(--dark-navy);
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
        }

        .user-info {
            text-align: right;
        }

        .user-name {
            display: block;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-main);
        }

        .user-role {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .user-avatar {
            width: 44px;
            height: 44px;
            background: var(--light-silver);
            color: var(--primary-navy);
            border: 1px solid var(--accent-silver);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.1rem;
            font-family: 'Outfit', sans-serif;
            transition: all 0.3s ease;
        }

        .user-avatar:hover {
            transform: scale(1.05) rotate(5deg);
        }

        .lang-btn {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: var(--text-main);
            font-weight: 700;
            font-size: 0.85rem;
            padding: 8px 16px;
            border-radius: 10px;
            background: var(--light-silver);
            transition: all 0.2s;
            border-bottom: none;
        }
        
        .lang-btn:hover {
            background: var(--accent-silver);
            color: #fff;
        }

        .lang-flag { font-size: 1.1rem; }

        .content-wrapper {
            padding: 30px;
            flex: 1;
        }

        /* Responsive (ajustements padding uniquement) */
        @@media (max-width: 768px) {
            .content-wrapper { padding: 20px 15px; }
            .app-topbar { padding: 0 15px; }
            .page-title { font-size: 1.1rem; }
        }

        /* Bouton hamburger - TOUJOURS visible */
        .hamburger-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            background: var(--light-silver);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            margin-right: 16px;
            flex-shrink: 0;
            color: var(--primary-navy);
            font-size: 1.2rem;
            transition: all 0.2s ease;
        }
        .hamburger-btn:hover {
            background: var(--accent-silver);
            color: #fff;
            transform: scale(1.05);
        }
        .hamburger-btn.open {
            background: var(--primary-navy);
            color: #fff;
        }
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.5);
            z-index: 200;
            backdrop-filter: blur(3px);
            cursor: pointer;
        }
        .sidebar-overlay.active {
            display: block;
        }
        .topbar-left {
            display: flex;
            align-items: center;
            flex-direction: row;
        }
        .topbar-left h2, .topbar-left span {
            display: block;
        }
    </style>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.querySelector('.app-sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleIcon = sidebarToggle.querySelector('i');

        function openSidebar() {
            sidebar.classList.add('open');
            overlay.classList.add('active');
            sidebarToggle.classList.add('open');
            toggleIcon.classList.replace('fa-bars', 'fa-times');
            document.body.style.overflow = 'hidden';
        }
        function closeSidebar() {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
            sidebarToggle.classList.remove('open');
            toggleIcon.classList.replace('fa-times', 'fa-bars');
            document.body.style.overflow = '';
        }

        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
        });
        overlay.addEventListener('click', closeSidebar);

        // Fermer sidebar au clic sur un lien
        document.querySelectorAll('.sidebar-nav a').forEach(link => {
            link.addEventListener('click', closeSidebar);
        });
    </script>
</body>
</html>
