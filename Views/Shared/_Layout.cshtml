<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tournoi de Golf G06</title>
    <meta name="description" content="Plateforme de gestion de tournoi de golf - La Cité" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    Tournoi Golf G06
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @using Microsoft.AspNetCore.Http
                    @inject IHttpContextAccessor HttpContextAccessor
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Tournoi/Index">Tournois</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Contact">Contact</a>
                        </li>
                        @if (HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true")
                        {
                            if (HttpContextAccessor.HttpContext?.Session.GetString("UserRole") == "ADMIN")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Admin/Index">Dashboard</a>
                                </li>
                            }
                            else if (HttpContextAccessor.HttpContext?.Session.GetString("UserRole") == "COMMANDITAIRE")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Commandite/Index">Mes commandites</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-success" style="font-weight:600;" href="/Equipe/Index">Gérer mes équipes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Auth/MesInscriptions">Mes inscriptions</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" href="/Auth/Profil">Mon profil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Auth/Logout">Déconnexion</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-btn-login" href="/Auth/Login">Connexion</a>
                            </li>
                        }
                    </ul>
                    @if (HttpContextAccessor.HttpContext?.Session.GetString("IsLoggedIn") == "true")
                    {
                        <span class="navbar-text" style="color:var(--gold); font-size:0.85rem;">
                            @HttpContextAccessor.HttpContext?.Session.GetString("UserPrenom")
                            @HttpContextAccessor.HttpContext?.Session.GetString("UserNom")
                        </span>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-links">
            <a href="/Home/Contact">Contact</a> |
            <a href="/Home/Privacy">Confidentialité</a>
        </div>
        &copy; 2026 - Tournoi de Golf G06 - La Cité
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
    <script src="/js/validation.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
