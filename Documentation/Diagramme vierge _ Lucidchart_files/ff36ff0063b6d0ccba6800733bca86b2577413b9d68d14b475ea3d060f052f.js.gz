var UcEEo={["/aws/category/Analytics"]:{description:"AWS provides a comprehensive set of analytics services that fit all your data analytics needs and enables organizations of all sizes and industries to reinvent their business with data. From storage and management, data governance, actions, and experiences, AWS offers purpose-built services that provide the best price-performance, scalability, and lowest cost.",fullName:"Analytics",id:"/aws/category/Analytics",shortName:"Analytics"},["/aws/category/Blockchain"]:{description:"",
fullName:"Blockchain",id:"/aws/category/Blockchain",shortName:"Blockchain"},["/aws/category/Business"]:{description:"Innovative business applications with the same on-demand scalability, reliability, pay-as-you go pricing, and machine learning that drives AWS cloud infrastructure.",fullName:"Business Applications",id:"/aws/category/Business",shortName:"Business"},["/aws/category/Compute"]:{description:"Millions of organizations run diverse workloads using AWS compute services.",fullName:"Compute",
id:"/aws/category/Compute",shortName:"Compute"},["/aws/category/Containers"]:{description:"AWS offers services that give you a secure place to store and manage your container images, orchestration that manages when and where your containers run, and flexible compute engines to power your containers.",fullName:"Containers",id:"/aws/category/Containers",shortName:"Containers"},["/aws/category/Databases"]:{description:"AWS databases offer a high-performance, secure, and reliable foundation to power generative Al solutions and data-driven applications that drive value for your business and customers.",
fullName:"Database",id:"/aws/category/Databases",shortName:"Database"},["/aws/category/Developer"]:{description:"",fullName:"Developer Tools",id:"/aws/category/Developer",shortName:"Developer"},["/aws/category/Enablement"]:{description:"",fullName:"Customer Enablement",id:"/aws/category/Enablement",shortName:"Enablement"},["/aws/category/Financial"]:{description:"Whether you were born in the cloud, or you are just starting your migration journey to the cloud, AWS has a set of solutions to help you manage and optimize your spend.",
fullName:"Cloud Financial Management",id:"/aws/category/Financial",shortName:"Financial"},["/aws/category/Frontend"]:{description:"AWS offers a broad set of tools and services to support development workflows for native iOS, Android, React Native, and JavaScript developers. Discover how easy it is to develop, deploy, and operate your app, even if you are new to AWS.",fullName:"Front-End Web & Mobile",id:"/aws/category/Frontend",shortName:"Front-End"},["/aws/category/Game"]:{description:"",fullName:"Games",
id:"/aws/category/Game",shortName:"Games"},["/aws/category/Groups"]:{description:"Group resources represent containers and organizational constructs in AWS architecture diagrams, such as VPCs, subnets, availability zones, regions, and security groups.",fullName:"Groups",id:"/aws/category/Groups",shortName:"Groups"},["/aws/category/Integration"]:{description:"Application integration on AWS is a suite of services that enable communication between decoupled components within microservices, distributed systems, and serverless applications. You don't need to refactor your entire architecture to benefit-decoupling applications at any scale can reduce the impact of changes, making it easier to update and faster to release new features.",
fullName:"Application Integration",id:"/aws/category/Integration",shortName:"Integration"},["/aws/category/IoT"]:{description:"AWS offers Internet of Things (IoT) services and solutions to connect and manage billions of devices. Collect, store, and analyze loT data for industrial, consumer, commercial, and automotive workloads.",fullName:"Internet of Things",id:"/aws/category/IoT",shortName:"IoT"},["/aws/category/Management"]:{description:"With AWS Management and Governance services, you don't have to choose between innovating faster and maintaining control over cost, compliance, and security—you can do both.",
fullName:"Management & Governance",id:"/aws/category/Management",shortName:"Management"},["/aws/category/Media"]:{description:"AWS offers the most purpose-built media services, software, and appliances of any cloud to make creating, transforming, and delivering digital content fast and easy.",fullName:"Media",id:"/aws/category/Media",shortName:"Media"},["/aws/category/Migration"]:{description:"AWS offers a wide range of migration tools, guidance, services, and programs to help you assess, migrate and modernize applications and data from building the business case to leveraging AWS services to deliver new experiences.",
fullName:"Migration & Modernization",id:"/aws/category/Migration",shortName:"Migration"},["/aws/category/ML"]:{description:"AWS helps you at every stage of your ML adoption journey with the most comprehensive set ML services and purpose-built infrastructure. Our pretrained Al services provide ready-made intelligence for your applications and workflows.",fullName:"Artificial Intelligence",id:"/aws/category/ML",shortName:"AI"},["/aws/category/Networking"]:{description:"AWS offers a broad set of networking and content delivery services that provide the highest level of reliability, security, and performance in the cloud.",
fullName:"Networking & Content Delivery",id:"/aws/category/Networking",shortName:"Networking"},["/aws/category/Quantum"]:{description:"",fullName:"Quantum Technologies",id:"/aws/category/Quantum",shortName:"Quantum"},["/aws/category/Satellite"]:{description:"",fullName:"Satellite",id:"/aws/category/Satellite",shortName:"Satellite"},["/aws/category/Security"]:{description:"AWS is architected to be the most secure global cloud infrastructure on which to build, migrate, and manage applications and workloads.",
fullName:"Security, Identity, & Compliance",id:"/aws/category/Security",shortName:"Security"},["/aws/category/Storage"]:{description:"AWS provides a broad portfolio of storage services with deep functionality for storing, accessing, protecting, and analyzing your data.",fullName:"Storage",id:"/aws/category/Storage",shortName:"Storage"},["/aws/category/User"]:{description:"",fullName:"End User Computing",id:"/aws/category/User",shortName:"User"}};var UcuN={gPl:"/aws/service/Athena",lSl:"/aws/service/CleanRooms",cTl:"/aws/service/CloudSearch",mWl:"/aws/service/DataExchange",tWl:"/aws/service/DataPipeline",AWl:"/aws/service/DataZone",Xch:"/aws/service/EMR",VZl:"/aws/service/EntityResolution",l0l:"/aws/service/FinSpace",sPb:"/aws/service/Glue",w2l:"/aws/service/GlueDataBrew",d6l:"/aws/service/Kinesis",nfh:"/aws/service/KinesisDataFirehose",Bpa:"/aws/service/KinesisDataStreams",e6l:"/aws/service/KinesisVideoStreams",z6l:"/aws/service/LakeFormation",
