        "{\"accelerator-error-generic-refresh\":\"Something went wrong. Please refresh the page. <w0>Refresh</w0>\",\"activity-default-title\":\"Activity\",\"ai-feedback-care-to-elaborate\":\"Care to elaborate?\",\"ai-feedback-choose-all-that-apply\":\"Choose all that apply.\",\"ai-feedback-include-conversation\":\"Include my prompts with feedback\",\"ai-feedback-include-conversation-disclaimer\":\"Personal and sensitive info will be removed.\",\"ai-feedback-legal-message\":\"Feedback provided is subject to your existing services agreement or Lucid's <w0>Terms of Service</w0>.\",\"ai-feedback-our-team-will-review-it-asap\":\"Our team will review it ASAP.\",\"ai-feedback-reason-accurate\":\"Accurate\",\"ai-feedback-reason-biased\":\"Biased\",\"ai-feedback-reason-helpful\":\"Helpful\",\"ai-feedback-reason-inaccurate\":\"Inaccurate\",\"ai-feedback-reason-saves-time\":\"Saves time\",\"ai-feedback-reason-unhelpful\":\"Unhelpful\",\"ai-feedback-share-more-details-here\":\"Share more details here...\",\"ai-feedback-submit-button-label\":\"Submit\",\"ai-feedback-title\":\"What went wrong?\",\"ai-feedback-what-went-well\":\"What went well?\",\"asset-info-panel-last-approved-by-v2\":\"Last approved by\",\"asset-info-panel-last-updated-by\":\"Last updated by\",\"asset-info-panel-last-updated-time\":\"Last updated\",\"asset-info-panel-version\":\"Version\",\"back-button-text\":\"Back\",\"blueprint-creator-toolkit-help-center-tooltip-v2\":\"Open help article in learning center.\",\"button-cancel\":\"Cancel\",\"button-clear-all\":\"Clear all\",\"button-close\":\"Close\",\"button-done\":\"Done\",\"button-learn-more\":\"Learn more\",\"button-retry\":\"Retry\",\"button-save\":\"Save\",\"callout-close-button-aria-label\":\"Close callout\",\"collaborator-archived-team-name\":\"Archived team\",\"collaborator-external-group-name\":\"External group\",\"collaborator-external-team-name\":\"External team\",\"collaborator-hidden-team-name\":\"Hidden team\",\"collaborator-list-shared-slack-ch