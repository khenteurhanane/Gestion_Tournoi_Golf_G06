i18n.setData(
    JSON.parse(
        "{\"activity-context-menu-add-attribute\":\"Add attribute\",\"activity-context-menu-toggle-axis\":\"Axis\",\"activity-context-menu-toggle-category\":\"Category\",\"activity-context-menu-toggle-option-bank\":\"Option Bank\",\"add-selection-to-grid-label\":\"Assisted Layout\",\"add-work-items-to-dynamic-table\":\"Add work item(s) to Dynamic Table\",\"added-new-page-screen-reader\":\"New page added.\",\"advanced-content-toolbar-aria-label\":\"Advanced content\",\"advanced-options-control-header\":\"Advanced\",\"advanced-options-control-tooltip\":\"Advanced\",\"advanced-options-swimlane-header-color\":\"Header\",\"advanced-options-swimlane-lane-color\":\"Lane\",\"advanced-options-swimlane-lanes\":\"Lanes\",\"advanced-options-swimlane-orientation\":\"Orientation\",\"advanced-options-swimlane-orientation-horizontal-aria-label\":\"Horizontal\",\"advanced-options-swimlane-orientation-vertical-aria-label\":\"Vertical\",\"advanced-options-swimlane-text-orientation\":\"Text Orientation\",\"advanced-options-swimlane-text-orientation-horizontal-aria-label\":\"Horizontal\",\"advanced-options-swimlane-text-orientation-vertical-aria-label\":\"Vertical\",\"advanced-options-table-auto-resize-tooltip\":\"Auto Expand to Fit Text\",\"advanced-options-table-auto-resize-v2\":\"Auto-Resize\",\"advanced-options-table-borders\":\"Borders\",\"advanced-options-table-borders-all\":\"All Borders\",\"advanced-options-table-borders-column\":\"Column Borders\",\"advanced-options-table-borders-none\":\"None\",\"advanced-options-table-borders-row\":\"Row Borders\",\"advanced-options-table-striping\":\"Striping\",\"advanced-options-table-striping-horizontal\":\"Horizontal striping\",\"advanced-options-table-striping-vertical\":\"Vertical striping\",\"agile-capacity-planning-capacity-editing-disabled\":\"This feature is part of the Agility Accelerator. Upgrade to set team capacity.\",\"agile-capacity-planning-onboarding-description\":\"Easily set and track your team's sprint capacity.\",\"agile-capacity-planning-onboarding-primary-button-text\":\"Try it out\",\"agile-capacity-planning-onboarding-title\":\"Plan for capacity\",\"agile-capacity-planning-set-field-apply-to-all\":\"Apply to all\",\"ai-agent-add-block-action-indicator\":\"Added shape\",\"ai-agent-create-visual-activity-action-indicator\":\"Created visual activity\",\"ai-agent-delete-item-action-indicator\":\"Deleted shape\",\"ai-agent-edit-text-action-indicator-v2\":\"Updated shape\",\"ai-agent-export-document-action-indicator\":\"Exported document\",\"ai-agent-generate-semantic-diagram-action-indicator\":\"Generating diagram\",\"ai-agent-get-data-backed-shapes-action-indicator\":\"Getting data-backed shapes\",\"ai-agent-get-document-history-action-indicator\":\"Checked recent edits\",\"ai-agent-get-resource-schemas-for-dataset-action-indicator\":\"Reading resource schemas\",\"ai-agent-get-resource-types-for-dataset-action-indicator\":\"Reading resource types\",\"ai-agent-get-semantic-datasets-ids-for-domain-action-indicator\":\"Reading document data\",\"ai-agent-query-semantic-resources-action-indicator\":\"Querying resources\",\"ai-agent-text-to-board-action-indicator\":\"Creating board\",\"ai-assistant-chunk-summarize-agent-action-indicator\":\"Summarized\",\"ai-assistant-conditional-formatting-action-indicator-created\":\"Rule created\",\"ai-assistant-conditional-formatting-action-indicator-updated\":\"Rule updated\",\"ai-assistant-describe-what-you-want-or-type-slash\":\"Describe what you want or type /\",\"ai-assistant-diagram-link-text\":\"diagram\",\"ai-assistant-diagram-not-found\":\"Diagram not found. It may have been deleted.\",\"ai-assistant-filter-canvas-agent-action-indicator\":\"Filtered canvas\",\"ai-assistant-generate-ideas-action-indicator\":\"Generated ideas\",\"ai-assistant-generate-ideas-want-to-adjust\":\"I've added more ideas. Want to adjust anything?\",\"ai-assistant-help-center-action-indicator-v2\":\"Searched help center\",\"ai-assistant-import-template-action-indicator\":\"Inserted template\",\"ai-assistant-items-sorted-want-to-adjust\":\"Items sorted. Want to adjust anything?\",\"ai-assistant-lucid-ai\":\"Lucid AI\",\"ai-assistant-navigate-to-diagram\":\"Go to diagram\",\"ai-assistant-navigate-to-visual-activity\":\"Go to visual activity\",\"ai-assistant-not-sure-what-to-say\":\"Not sure what to say? Here's one way to start.\",\"ai-assistant-process-agent-display-name\":\"Process Agent\",\"ai-assistant-recreate-diagram\":\"Recreate diagram\",\"ai-assistant-recreate-visual-activity\":\"Recreate visual activity\",\"ai-assistant-shapes-panel-input-placeholder\":\"Generate...\",\"ai-assistant-shapes-selected.one\":\"{count} shape selected\",\"ai-assistant-shapes-selected.other\":\"{count} shapes selected\",\"ai-assistant-standard-import-action-indicator\":\"Generating shapes\",\"ai-assistant-suggested-action-bpmn-choreography-diagram-display-text\":\"BPMN choreography diagram\",\"ai-assistant-suggested-action-bpmn-conversation-diagram-display-text\":\"BPMN conversation diagram\",\"ai-assistant-suggested-action-class-diagram-display-text\":\"Class diagram\",\"ai-assistant-suggested-action-erd-display-text\":\"ERD\",\"ai-assistant-suggested-action-flowchart-display-text\":\"Flowchart\",\"ai-assistant-suggested-action-hardcoded-response-aws\":\"Okay! Let's start by describing your AWS architecture.\\n\\nDescribe the AWS system you want to create. Just explain its purpose and how the main services (like EC2, S3, or Lambda) will interact.\",\"ai-assistant-suggested-action-hardcoded-response-azure\":\"Okay! Let's start by describing your Azure architecture.\\n\\nDescribe the Azure system you want to create. Just explain its purpose and how the main services (like App Service, Blob Storage, or Azure SQL) will interact.\",\"ai-assistant-suggested-action-hardcoded-response-bpmn-choreography\":\"Perfect, we'll map out the sequence of interactions with a Choreography Diagram.\\n\\nTo get started, please outline the flow of messages between the different participants. Be sure to include any key decisions or events that change the path of the interaction.\",\"ai-assistant-suggested-action-hardcoded-response-bpmn-conversation\":\"Excellent, let's model the high-level conversations in your business process.\\n\\nTo begin, please identify the main participants involved and then describe the key message exchanges that occur between them.\",\"ai-assistant-suggested-action-hardcoded-response-class-diagram\":\"Great, let's build your Class Diagram!\\n\\nJust tell me the main classes you need, and for each one, briefly describe its properties, the actions it can perform, and how it connects to the others.\",\"ai-assistant-suggested-action-hardcoded-response-erd\":\"Happy to help you create an Entity-Relationship Diagram (ERD)!\\n \\nTo get started, please list the key entities in your system (like 'Customer' or 'Product'). Then, for each entity, tell me its important attributes (like 'name' or 'price'). Finally, describe how these entities relate to one another (for example, \\\"one customer can have many orders\\\").\",\"ai-assistant-suggested-action-hardcoded-response-flowchart\":\"Great, let's create a flowchart! It's a perfect way to visualize any process.\\n\\nJust walk me through the steps from start to finish. Be sure to mention any decision points where the path might split (for example, \\\"if payment is approved, then proceed\\\").\",\"ai-assistant-suggested-action-hardcoded-response-gcp\":\"Got it. Let's map out your Google Cloud Platform (GCP) architecture.\\n\\nTo begin, tell me about the system's goal. Be sure to include the core GCP products you envision using and how they'll fit together.\",\"ai-assistant-suggested-action-hardcoded-response-mind-map\":\"Awesome, a mind map is a great way to explore ideas! \\n\\nTo get started, what is the central concept you want to put in the middle? Then, just list the main themes or categories you'd like to see branch out from there, and I'll map it all out for you.\",\"ai-assistant-suggested-action-hardcoded-response-network-diagram\":\"Okay, a network diagram it is!\\n \\nTo build it out, describe the network's layout. Be sure to mention the key devices like routers and firewalls, and any specific subnets or zones you want to show.\",\"ai-assistant-suggested-action-hardcoded-response-sequence-diagram\":\"I'd love to help you create a Sequence Diagram!\\n\\nTo get started, just tell me who (or what systems) are the main players in this interaction. Once we have the participants, just walk me through the messages they exchange in the order they happen!\",\"ai-assistant-suggested-action-mind-map-display-text\":\"Mind map\",\"ai-assistant-suggested-action-network-diagram-display-text\":\"Network diagram\",\"ai-assistant-suggested-action-sequence-diagram-display-text\":\"Sequence diagram\",\"ai-assistant-summarize-view-only-action-indicator\":\"Summarized for you\",\"ai-assistant-try-example-prompt\":\"Try example prompt\",\"ai-assistant-visual-activity-not-found\":\"Visual activity not found. It may have been deleted.\",\"ai-brainstorm-board-example-prompt\":\"Set up a brainstorming board for our upcoming summer marketing campaign. Organize the space so we can categorize ideas by 'Social Media,' 'Email,' and 'Events.' Make sure there's plenty of room for the team to drop in sticky notes.\",\"ai-contextual-callout-expand-mind-map-with-ideas\":\"Expand with ideas\",\"ai-contextual-callout-expand-mind-map-with-questions\":\"Expand with questions\",\"ai-contextual-callout-generate-mind-map-ideas-disabled-tooltip\":\"Select 1 node at a time to expand\",\"ai-edit-diagram-success-action-prefix\":\"Edited\",\"ai-followup-action-brainstorm-ideas-display-text\":\"Brainstorm ideas\",\"ai-followup-action-brainstorm-ideas-hardcoded-response\":\"Okay, I can help you brainstorm some ideas. Can you give me a topic?\",\"ai-followup-action-sort-shapes-display-text\":\"Sort shapes\",\"ai-followup-action-sort-shapes-hardcoded-response\":\"Awesome. I can help you sort shapes. To get started, I'll need:\\n- Which shapes you want to sort (select them, or reference them e.g., all sticky notes)\\n- How you'd like me to sort them (e.g., by color)\",\"ai-followup-action-summarize-content-display-text\":\"Summarize content\",\"ai-followup-action-summarize-content-hardcoded-response\":\"Great, please tell me what you'd like to summarize. You can select the content on the canvas you'd like summarized or reference it.\",\"ai-generate-diagram-edit-preset\":\"Edit preset\",\"ai-generate-diagram-example-aws-deployment-process-contents\":\"Create a high-level AWS architecture diagram for a scalable web application. The application should have a front end hosted on Amazon S3 and distributed via Amazon CloudFront. The backend should use an EC2 Auto Scaling group behind an Application Load Balancer to handle incoming traffic. Data should be stored in an Amazon RDS database. Include an Amazon SQS queue to handle asynchronous tasks and an Amazon SNS topic for notifications.\",\"ai-generate-diagram-example-azure-ml-deployment-contents\":\"Create a high-level Azure architecture diagram for a resilient web application. The front end should be hosted in Azure Blob Storage and distributed globally with Azure CDN. The backend should use Azure App Service, configured to autoscale, with an Azure Application Gateway managing traffic. Store primary data in an Azure SQL Database and use Azure Queue Storage for asynchronous background tasks.\",\"ai-generate-diagram-example-bank-loan-application-contents\":\"Create a BPMN choreography diagram with Applicant, Bank, and Credit Agency as participants. Start with a Start Event labeled Loan Application Initiated, followed by Choreography Tasks for Submit Loan Application (Applicant to Bank) and Acknowledge Receipt (Bank to Applicant). Add Request Credit Report (Bank to Credit Agency) with a Timer Intermediate Event for waiting, followed by Provide Credit Report (Credit Agency to Bank). After receiving the credit report, include an Exclusive Gateway with two branches: one for Notify Approval (Bank to Applicant) with an optional Sign Agreement (Applicant to Bank), ending in a Message End Event labeled Loan Approved; and another for Notify Rejection (Bank to Applicant), ending in a Message End Event labeled Loan Rejected. Ensure all Message Flows, Gateways, and Intermediate Events are logically connected and annotated clearly.\",\"ai-generate-diagram-example-erd-event-management-system-contents-v2\":\"Design an ERD for an event management system that includes entities for events, attendees, venues, and sponsors. Highlight relationships like events-to-attendees (many-to-many), events-to-venues (many-to-one), and events-to-sponsors (many-to-many). Include attributes such as event dates, attendee contact information, venue capacity, and sponsorship amounts.\",\"ai-generate-diagram-example-gcp-serverless-event-architecture-contents\":\"Draft a GCP architecture diagram for a containerized, scalable microservices application. User requests should go through a global external HTTPS Load Balancer. The load balancer will route traffic to various backend services running on Google Kubernetes Engine (GKE). Static assets like images and CSS should be stored in a Google Cloud Storage bucket and served through Cloud CDN. Use Cloud SQL for the primary relational database and Pub/Sub to manage asynchronous messaging between services.\",\"ai-generate-diagram-example-mind-map-startup-business-model-contents-v2\":\"Create a mind map that outlines the key components of a startup business model. Map out areas like value proposition, customer segments, revenue streams, cost structure, key partnerships, key activities, key resources, customer relationships, and distribution channels. Show how these elements interconnect to form a viable business strategy.\",\"ai-generate-diagram-example-network-architecture-contents\":\"Create a network diagram for a small office. The diagram should show an internet connection coming into a primary firewall. Behind the firewall, a core switch connects to an internal corporate LAN (192.168.1.0/24) that includes several PCs and a file server. The firewall also provides a connection for a separate, isolated guest Wi-Fi network (10.10.10.0/24) managed by a wireless access point.\",\"ai-generate-diagram-example-online-shopping-site-contents\":\"Draw a sequence diagram for an online shopping site.\",\"ai-generate-diagram-example-order-fulfillment-contents\":\"Draw a BPMN Conversation diagram of a process involving a customer, retailer, and supplier. The customer and retailer exchange order details. The retailer and supplier communicate about stock availability. The retailer and customer discuss shipment updates. Each pair has a single exchange to coordinate order fulfillment.\",\"ai-generate-diagram-example-project-management-process-contents-v3\":\"Draw a flowchart for a project management process, covering activities like project initiation, planning, execution, monitoring, and closure. Include nodes for resource allocation, risk assessment, and stakeholder communication. Add decision nodes for scope changes, budget approvals, and quality gates throughout the project lifecycle.\",\"ai-generate-diagram-example-project-management-system-contents-v2\":\"Draw a class diagram for a project management system. Include classes such as Project, TeamMember, Task, Milestone, and Comment. Show relationships like project-to-tasks (one-to-many), team members-to-tasks (many-to-many), and tasks-to-comments (one-to-many). Include attributes such as project deadlines, task priorities, team member roles, and milestone dates.\",\"ai-generate-diagram-success-action-prefix\":\"Generated\",\"ai-project-kickoff-example-prompt\":\"I'm starting a project kickoff for a website redesign and need a board to align the team. Create sections for our project goals, high-level milestones, and team roles. Use a clear layout that separates the vision from the tactical next steps.\",\"ai-quick-sticky-placeholder\":\"Ask AI to brainstorm ideas\",\"ai-sprint-planning-example-prompt\":\"Create a sprint planning board for a one-week sprint. I need a simple flow to track tasks from 'To Do' through 'Done,' with a dedicated spot at the top to highlight our main sprint objective.\",\"ai-sprint-retro-example-prompt\":\"Help me run a sprint retro for our 'Mobile Checkout' project. I need a workspace organized into four categories: what went well, what didn't, ideas for next time, and action items. Please include some starting stickies in each area.\",\"ai-tool-loading-generating-diagram\":\"Generating diagram...\",\"ai-zero-state-ask-questions-content-conversation-message\":\"Great, I can answer questions you have about this document or scour our help center to help you learn more about Lucid.\",\"ai-zero-state-ask-questions-description\":\"Explore this document or get help.\",\"ai-zero-state-ask-questions-empty-conversation-message\":\"Great, I can scour our help center to help you learn more about Lucid.  Once you add content to the canvas, I can also answer questions about this document.\",\"ai-zero-state-ask-questions-title\":\"Ask questions\",\"ai-zero-state-brainstorm-board-conversation-message\":\"Great — I'll set up a brainstorming board. A few quick details:\\n1. What is the main topic or problem we're solving?\\n2. How many categories or themes do you want to start with?\\n3. Should I include a 'parking lot' area for unrelated ideas?\\n4. Do you want the board organized by swimlanes or separate frames?\\n\\nAlternatively, you can use the example prompt.\",\"ai-zero-state-brainstorm-board-description\":\"Create a structured brainstorming space for your team to collaborate and organize ideas.\",\"ai-zero-state-brainstorm-board-title\":\"Run a brainstorming session\",\"ai-zero-state-brainstorm-content-conversation-message\":\"Okay, what can I help you with? Here are some examples to get you started.\",\"ai-zero-state-brainstorm-description\":\"Generate ideas and organize them visually.\",\"ai-zero-state-brainstorm-empty-conversation-message\":\"Okay, I can help you brainstorm some ideas. Can you give me a topic?\",\"ai-zero-state-brainstorm-title-v2\":\"Brainstorm ideas\",\"ai-zero-state-diagram-conversation-message\":\"Okay, describe what kind of diagram you want to create or explore an example with the options below.\",\"ai-zero-state-diagram-description\":\"Create a flowchart, ERD, mind map, and much more.\",\"ai-zero-state-diagram-title-v3\":\"Build a diagram\",\"ai-zero-state-process-agentic-sticker-label-v2\":\"New\",\"ai-zero-state-process-description\":\"Work together to capture and draft processes.\",\"ai-zero-state-process-title-v3\":\"Design a process\",\"ai-zero-state-process-user-message\":\"Capture process\",\"ai-zero-state-project-kickoff-conversation-message\":\"Great — I'll set up a project kickoff board. A few quick details:\\n1. What is the name of the project?\\n2. What are the 3-4 key sections you need (e.g., Goals, Roles, Timeline)?\\n3. How many team members should I account for in the roles section?\\n4. Do you want a text area for the project's 'North Star' statement at the top?\\n\\nAlternatively, you can use the example prompt.\",\"ai-zero-state-project-kickoff-description\":\"Create a project kickoff board to align your team on goals, roles, and next steps.\",\"ai-zero-state-project-kickoff-title\":\"Kick off a project\",\"ai-zero-state-sprint-planning-conversation-message\":\"Great — I'll set up a sprint planning board. A few quick details:\\n1. How long is this sprint?\\n2. What's the main goal or theme?\\n3. How many people are on the team?\\n4. Do you want tasks grouped by priority, owner, or status?\\n\\nAlternatively, you can use the example prompt.\",\"ai-zero-state-sprint-planning-description\":\"Create a sprint planning board to organize tasks and align your team for the upcoming sprint.\",\"ai-zero-state-sprint-planning-title\":\"Plan a sprint\",\"ai-zero-state-sprint-retro-conversation-message\":\"Great — I'll set up a sprint retro board. A few quick details:\\n1. What was the name or date of this sprint?\\n2. Which retro format do you prefer (e.g., 'Went Well/To Improve' or 'Start/Stop/Continue')?\\n3. How many participants are joining?\\n4. Do you want a dedicated frame for action items?\\n\\nAlternatively, you can use the example prompt.\",\"ai-zero-state-sprint-retro-description\":\"Create a sprint retrospective to reflect on your team's accomplishments and areas for improvement.\",\"ai-zero-state-sprint-retro-title\":\"Facilitate a sprint retrospective\",\"archived-document-banner-message\":\"Archived: You are viewing an archived document.\",\"asset-version-history-compare-selected-versions-button-label\":\"Compare selected versions\",\"asset-version-history-compare-version-button-label\":\"Compare versions\",\"asset-version-history-exit-compare-versions-mode-button-label\":\"Exit compare versions mode\",\"asset-version-history-header\":\"Version history\",\"asset-version-history-mode-right-panel-back-button-label\":\"Back\",\"asset-version-history-mode-right-panel-header-title-comparing-versions\":\"Comparing versions\",\"asset-version-history-mode-right-panel-header-title-history\":\"History\",\"asset-version-history-mode-right-panel-header-title-select-the-second-version\":\"Select the second version\",\"asset-version-history-previous-revisions\":\"Pre-publication revisions\",\"asset-version-history-previous-revisions-subtitle\":\"These are edits saved before the process was first published in the repository.\",\"asset-version-history-selected-versions\":\"Selected versions\",\"asset-version-history-selected-versions-collapse\":\"Collapse\",\"asset-version-history-selected-versions-expand\":\"Expand\",\"at-mention-comment-ui-hint-tooltip\":\"Add an @mention comment\",\"audience-controls-disabled-tooltip\":\"This feature is currently disabled. Ask the presenter if you'd like to use it.\",\"aws-name-2025-v3\":\"AWS\",\"azure2024-title\":\"Azure\",\"blueprint-module-add-insights-callout-title\":\"Share insights\",\"blueprint-module-insights-info-callout-title\":\"Insight shape\",\"button-add-to-repository\":\"Add to repository\",\"button-cancel\":\"Cancel\",\"button-close\":\"Close\",\"button-dismiss\":\"Dismiss\",\"button-done\":\"Done\",\"button-export-v2\":\"Export\",\"button-import\":\"Import\",\"button-print\":\"Print\",\"button-publish\":\"Publish\",\"button-rail-comment\":\"Comment\",\"button-rail-line\":\"Line\",\"button-rail-more-tools\":\"More tools\",\"button-rail-pages\":\"Pages\",\"button-rail-shapes\":\"Shapes\",\"button-rail-sticky-note\":\"Sticky note\",\"button-rail-text\":\"Text\",\"button-retry\":\"Retry\",\"button-save\":\"Save\",\"button-save-as\":\"Save As\",\"button-share\":\"Share\",\"callout-close-button-aria-label\":\"Close callout\",\"canvas-navigation-status-overlay-title\":\"Canvas navigation hotkeys are active.\",\"canvas-zero-state-action-tag-ai\":\"Diagram with AI\",\"canvas-zero-state-action-tag-browse-shapes\":\"Browse shape libraries\",\"canvas-zero-state-action-tag-import-data\":\"Import data\",\"canvas-zero-state-action-tag-import-templates\":\"Import templates\",\"canvas-zero-state-dismiss\":\"Dismiss\",\"canvas-zero-state-do-not-show-again\":\"Don't show again\",\"canvas-zero-state-dropdown-menu-trigger\":\"Zero state command dropdown menu trigger\",\"canvas-zero-state-title-get-started-faster\":\"Get started faster\",\"chart-context-menu-more-actions\":\"More actions\",\"chart-data-linking-v2\":\"Data linking\",\"chart-group-data\":\"Selected Group Data\",\"chart-line-data\":\"Selected Line Data\",\"chart-object-data\":\"Selected Object Data\",\"chart-page-data\":\"Current Page Data\",\"chart-present\":\"Present\",\"chart-presentation-header-button-tooltip\":\"Presentation Builder\",\"chart-shape-data\":\"Selected Shape Data\",\"clear-custom-thumbnail\":\"Clear custom thumbnail\",\"cloud-insights-generator-after-deprecation-banner-button\":\"Use Lucidscale\",\"cloud-insights-generator-after-deprecation-banner-message\":\"Lucidchart no longer supports Cloud Insights. Start using Lucidscale to model your cloud architecture. <w1>See more details</w1>\",\"cloud-insights-generator-before-deprecation-banner-button\":\"Use Lucidscale\",\"cloud-insights-generator-before-deprecation-banner-message-v2\":\"<w0>On June 30, 2022 Lucidchart will stop supporting Cloud Insights.</w0> Start using Lucidscale to model your cloud architecture.\",\"cloudapp-recorder-unsupported-v2\":\"Zight unsupported.\",\"code-block-advanced-options-convert-to-text\":\"Convert to text block\",\"code-block-advanced-options-copy-code\":\"Copy code\",\"code-block-advanced-options-language-label\":\"Language\",\"code-block-advanced-options-share-code-block\":\"Share code block\",\"code-block-advanced-options-tab-width-label\":\"Tab width\",\"code-block-advanced-options-theme-label\":\"Theme\",\"collaborator-drawer-toggle-aria\":\"Toggle collaborator drawer\",\"collaborator-panel-open-aria\":\"Open collaborator panel\",\"compare-selected-versions\":\"Compare Selected Versions\",\"compare-version\":\"Compare Version\",\"comparing-versions\":\"Comparing Versions\",\"condensed-formatting-toolbar-drag-handle-aria-label\":\"Drag to reposition contextual menu\",\"condensed-formatting-toolbar-drag-handle-tooltip\":\"Drag to move\",\"condensed-formatting-toolbar-more\":\"More\",\"conditional-format-imported-fill-color\":\"Color from Spreadsheet\",\"confirm-cancel\":\"Cancel\",\"confirm-continue\":\"Would you like to continue?\",\"connect-with-lines\":\"Connect with lines\",\"container-color-control-fill-color\":\"Fill color\",\"container-color-control-line-color-2\":\"Line color\",\"container-column-control-fill-column\":\"Fill column\",\"container-group-view-dialog-feedback-header-new\":\"Group View Feedback\",\"container-group-view-dialog-feedback-hint\":\"What did you like or dislike? What steps can we take to reproduce your issue?\",\"container-group-view-dialog-feedback-text-new\":\"Thanks for trying the new Group View! We appreciate your feedback.\",\"container-group-view-leave-feedback\":\"Leave Feedback\",\"container-row-control-fill-row\":\"Fill row\",\"container-view-container\":\"Container\",\"container-view-creating-v2\":\"Creating your Smart Containers...\",\"container-view-data-conflicts-added-item.one\":\"{count} new item\",\"container-view-data-conflicts-added-item.other\":\"{count} new items\",\"container-view-data-conflicts-changed-item.one\":\"{count} item changed\",\"container-view-data-conflicts-changed-item.other\":\"{count} items changed\",\"container-view-data-conflicts-deleted-item.one\":\"{count} item deleted\",\"container-view-data-conflicts-deleted-item.other\":\"{count} items deleted\",\"container-view-data-conflicts-keep-change-explanation-bamboohr\":\"We'll update your Smart Containers from BambooHR but keep any changes you've made since your last import.\",\"container-view-data-conflicts-keep-change-explanation-csv\":\"We'll update your Smart Containers from your CSV file but keep any changes you've made since your last import.\",\"container-view-data-conflicts-keep-change-explanation-excel\":\"We'll update your Smart Containers from your Excel file but keep any changes you've made since your last import.\",\"container-view-data-conflicts-keep-change-explanation-google-sheets\":\"We'll update your Smart Containers from Google Sheets but keep any changes you've made since your last import.\",\"container-view-data-conflicts-revert-change-explanation-bamboohr\":\"We'll clear your changes and make sure your Smart Containers reflect exactly what's in BambooHR. (This option won't affect formatting changes like shape color.)\",\"container-view-data-conflicts-revert-change-explanation-csv\":\"We'll clear your changes and make sure your Smart Containers reflect exactly what's in your CSV. (This option won't affect formatting changes like shape color.)\",\"container-view-data-conflicts-revert-change-explanation-excel\":\"We'll clear your changes and make sure your Smart Containers reflect exactly what's in your Excel file. (This option won't affect formatting changes like shape color.)\",\"container-view-data-conflicts-revert-change-explanation-google-sheets\":\"We'll clear your changes and make sure your Smart Containers reflect exactly what's in Google Sheets. (This option won't affect formatting changes like shape color.)\",\"container-view-data-conflicts-source-deletion-csv\":\"Note: Any items deleted in your CSV file will be removed from your Smart Containers.\",\"container-view-data-conflicts-source-deletion-excel\":\"Note: Any items deleted in your Excel file will be removed from your Smart Containers.\",\"container-view-data-conflicts-source-deletion-google-sheets\":\"Note: Any items deleted in Google Sheets will be removed from your Smart Containers.\",\"container-view-data-refresh-data-set-v2\":\"Refresh Dataset\",\"container-view-dialog-feedback-header-new\":\"Smart Containers Feedback\",\"container-view-dialog-feedback-text-new\":\"Thanks for trying the Smart Containers! We appreciate your feedback.\",\"container-view-general-import-auto-layout-message\":\"Auto layout your shapes\",\"container-view-general-import-back\":\"Back\",\"container-view-general-import-bamboohr-explanation-v2\":\"Select the fields from BambooHR that you'd like to see on your Smart Containers. If you’re not an admin, you can currently only import information about yourself and direct reports. Please <w0>contact Lucid</w0> if you’d like to be able to import more data.\",\"container-view-general-import-bamboohr-too-few-fields\":\"Select at least three fields before continuing. Remember to select a field that represents a container.\",\"container-view-general-import-begin-import\":\"Import Your Data\",\"container-view-general-import-cancel\":\"Cancel\",\"container-view-general-import-choose-file\":\"Choose File\",\"container-view-general-import-create-message\":\"Automatically create containers from your data\",\"container-view-general-import-data-kind\":\"What type of data do you want to import?\",\"container-view-general-import-easy-edit-message\":\"Easily edit and change your data\",\"container-view-general-import-finish\":\"Finish\",\"container-view-general-import-help-info\":\"Want to learn more?\",\"container-view-general-import-help-info-2\":\"Try our<w0>Smart Containers tutorial</w0> to get started.\",\"container-view-general-import-help-link-text\":\"Help\",\"container-view-general-import-image-alt-text\":\"Easily rearranging content inside 4 Smart Containers\",\"container-view-general-import-intro-message\":\"Smart Containers automatically organizes your information into containers and helps you stay up to date by instantly rearranging, resizing, and adjusting to your content.\",\"container-view-general-import-loading\":\"Importing your data...\",\"container-view-general-import-next\":\"Next\",\"container-view-general-import-sample-download\":\"Download Example File\",\"container-view-general-import-sample-download-v2\":\"Download example file\",\"container-view-general-import-template-title\":\"Smart Container Templates\",\"container-view-general-import-title-v2\":\"Import Smart Containers\",\"container-view-grid-container-block-name\":\"Grid Container\",\"container-view-import-help\":\"Need help? Try our <w0>Smart Containers tutorial</w0>.\",\"container-view-move-containers\":\"Move all containers\",\"container-view-page-name\":\"Container View: {field}\",\"container-view-panel-title\":\"Smart Containers\",\"container-view-smart-containers-data-conflicts-keep-change-explanation-generic-v2\":\"We'll update your Smart Containers from your dataset but keep any changes you've made since your last import.\",\"container-view-smart-containers-data-conflicts-revert-change-explanation-generic\":\"We'll clear your changes and make sure your Smart Containers reflect exactly what's in your source