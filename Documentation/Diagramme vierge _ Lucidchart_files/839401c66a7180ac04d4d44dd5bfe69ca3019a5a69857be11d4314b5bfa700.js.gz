var UcfXj={pe:UcMh.YIf,Pe:"id",Te:"name",resources:[{uf:{id:UcDI(UcMh.YIf),name:"Application Owner",restrictToFactSheetTypes:["Application"],subscriptionType:"RESPONSIBLE"},Af:UceXj},{uf:{id:"5aaa00ff-2f14-445b-9107-d70c013fb152",name:"Application Owner",restrictToFactSheetTypes:["Application"],subscriptionType:"RESPONSIBLE"},Af:UceXj},{uf:{id:"5fee1cb3-bba4-4474-8e5d-fe917d04febd",name:"Security Officer",restrictToFactSheetTypes:["Application"],subscriptionType:null},Af:UceXj},{uf:{id:"8bb6bbd2-194c-4cfd-848c-7c3d9fceffa8",name:"Enterprise Architect",
restrictToFactSheetTypes:[],subscriptionType:null},Af:UceXj},{uf:{id:"080a2064-1d32-4c02-a58b-0e67de399c12",name:"Business Owner",restrictToFactSheetTypes:["Application"],subscriptionType:null},Af:UceXj},{uf:{id:"eb839875-27b7-4108-b27a-74ea27e25d07",name:"Process Owner",restrictToFactSheetTypes:["Application","BusinessContext"],subscriptionType:"RESPONSIBLE"},Af:UceXj}],Ag:[]};var UcgXj={pe:UcMh.VJe,Pe:"id",Te:"id",resources:[{uf:{roleId:UcDI(UcMh.VJe),comment:"Example",name:"Application Owner",description:""},Af:{}}],Ag:[]};var UchXj={pe:UcMh.Tag,Pe:"id",Te:"name",resources:[{uf:{id:"404fb524-c40e-4457-b970-7847166d9fd5",tagGroup:{id:"2b0f32a5-cd8e-47f8-b2e6-4211237ece0d",name:"M&A - Application Comparison",shortName:"M&A Org(s)",description:"",mode:"SINGLE",restrictToFactSheetTypes:["Application"],mandatoryForFactSheetTypes:[],replaySequence:0},name:"Both Company A&B",description:null,bgColor:"#61ce62",status:"ACTIVE",replaySequence:14},Af:{}},{uf:{id:"6eaf05ce-8c8c-45db-8bd0-a4fce7a80900",tagGroup:null,name:"Example",
description:null,bgColor:"#999999",status:"ACTIVE",replaySequence:0},Af:{}},{uf:{id:"62db5877-cca4-4c72-abf6-87dd740a55bd",tagGroup:{id:"6fde27bb-fa9d-473a-a511-282c07da403b",name:"TIME MODEL Assessment",shortName:null,description:"Tags when Applications are undergoing a TIME Model Assessment",mode:"SINGLE",restrictToFactSheetTypes:["Application"],mandatoryForFactSheetTypes:[],replaySequence:0},name:"Initial Assessment Request",description:null,bgColor:"#1b3adc",status:"ACTIVE",replaySequence:14},
Af:{}},{uf:{id:"8e705684-944f-417a-afb0-ef94ba2c76ac",tagGroup:{id:"d224486a-4b81-4bc6-8b45-981ccc11db71",name:"Example Tag Group",shortName:"Example Tag Group",description:"Example Tag Group",mode:"MULTIPLE",restrictToFactSheetTypes:[],mandatoryForFactSheetTypes:[],replaySequence:0},name:"Example Tag",description:"",bgColor:"#CCCCCC",status:"ACTIVE",replaySequence:0},Af:{}}],Ag:[{origin:"raw",path:"tagGroup.id",target:UcMh.bkh}]};var UciXj={pe:UcMh.Mk,Pe:"id",Te:"displayName",resources:[{uf:{id:UcDI(UcMh.Mk),userName:"example@lucidchart.com",email:"example@lucidchart.com",role:"ACCOUNTUSER",status:"ACTIVE",technicalUser:!1,displayName:"Example User"},Af:{}}],Ag:[]};var UcjXj=new Set([Ucnd.zHe]),UckXj=Uc_sb.vPb;var UclXj={Pm:Ucpd.wDe,FU:"Adds blocks and shapes to the canvas based on user requests.",Lz:2,description:"This tool is responsible for adding a block to the canvas. The tool has context about which block types are currently available so give it enough context to understand how to pick the right block type."};var UcmXj={Pm:Ucpd.wyf,FU:"Adds clarifications and decisions about the process to the persistent process context frame on the document, making them part of the process documentation.",Lz:0,A1c:!1,description:"**Add Decisions to Process Context Frame Tool**\n\nRecords clarifications and decisions about the process to the process context frame on the document.\n\n**When to Use:**\n- ALWAYS call this tool after the user responds to AskClarifyingQuestions tool. Only include questions the user explicitly answered — skip vague or ambiguous responses.\n- When the user provides important context or clarifications about the process.\n\n**When NOT to Use:**\n- For general conversational responses that do not resolve a specific ambiguity about the process.\n- When the user is asking a question rather than providing an answer.\n\n**Key Behaviors:**\n- Rephrase decisions to third-person — the Q&A is visible to all document collaborators.\n- Be concise. 1 question and 1 answer per decision. Split up complex decisions into multiple simpler ones if needed.\n- Check existing decisions in the context frame (### Context Frame Content -> #### Decisions section in the system prompt) to avoid duplicate decisions.\n- Can be called alongside other tools (not a terminator).\n- Multiple decisions can be added in a single call.\n"};var UcnXj={Pm:Ucpd.xyf,FU:"Adds attached files from the conversation to the persistent process context frame on the document, making them part of the process documentation.",Lz:0,A1c:!1,description:"**Add Files to Process Context Frame Tool**\n\nAdds uploaded files to the persistent process context frame on the document, making them part of the permanent process documentation.\n\n**When to Use:**\n- When user uploads files clearly containing process-related content (SOPs, procedures, templates, workflows, documentation, guidelines, steps) meant for process documentation\n- When user states clearly to add uploaded files as part of the process documentation\n\n**When NOT to Use:**\n- Files uploaded only for one-off questions (no intent to document)\n- Files clearly unrelated to the process (personal files, photos, test data)\n- User explicitly states file is NOT part of process documentation\n- No files have been uploaded yet\n\n**File Reference Format:**\n- Files in conversation history have references in this format {uuid}_{index} (e.g. 'cdf46ea1-3bda-4df7-a244-36222ebf9aef_0')\n- All files have their respective reference as a header in the message content (e.g. \"[File Reference: cdf46ea1-3bda-4df7-a244-36222ebf9aef_0]\")\n- File references are unique across the whole conversation\n\n**Key Behaviors:**\n- **ALWAYS** call this tool proactively if the above criteria is met. Call this tool before AskClarifyingQuestionTool or any other tool to ensure files are added to context before any other operations.\n- When uncertain, err on the side of adding - duplicates are auto-skipped and users can remove them if they are irrelevant\n- Added files persist across sessions and become permanent blocks on the context frame\n- Automatic duplicate detection based on file content - duplicates are skipped\n- Can be called alongside other tools (not a terminator)\n- The tool outputs which files were added and which files were skipped because they were either duplicates or invalid file references\n- The tool is only available after switching to the process agent - consider adding files before the process agent was active if they meet criteria\n- Evaluate each file reference separately - don't batch-assume all should be added/skipped\n- Users can remove files from the context frame, so re-add if a deleted file is re-uploaded or specifically referenced to have the available in the context frame again\n- Be cautious about re-adding files to not frustrate the user\n"};var UcoXj={Pm:Ucpd.Odd,FU:"Reads and queries canvas content using a combination of AI-powered semantic search and deterministic filters.",Lz:3,description:'## Role\nThis is your primary tool for *reading* and *querying* the canvas or document.\nIt retrieves items from the canvas based on your query criteria and returns their JSON representation with the properties you request.\n\n## How It Works\nThis tool uses a **two-stage filtering pipeline**:\n\n1. **Deterministic Filters** (TextPattern, ColorSearch, ShapeTypes, Regions) — Rule-based filters that narrow results precisely. All active deterministic filters are combined with AND logic: items must satisfy **every** specified filter.\n2. **AI Semantic Search** (via SelectionCriteria) — **Optional and rarely needed.** An AI subagent interprets your natural language description and further refines the results. Only use this when the query genuinely requires semantic reasoning that no combination of deterministic filters can express. Leave SelectionCriteria empty whenever possible — deterministic filters are faster and more precise.\n\nAfter both stages, an optional **Proximity Expansion** (ItemsInProximity) can include nearby items for additional context.\n\nYou also control **which properties** appear in the output via BlockProperties, LucidCardBlockProperties, and LineProperties. Only request the properties you need to keep the response focused.\n\n## When to Use This Tool\n- To read or inspect what is on the canvas before taking action.\n- To find specific items by text, color, shape type, spatial location, or semantic meaning.\n- To gather context about the document or a portion of it.\n- When you need to combine multiple filtering criteria (e.g., "pull up the approved items (they\'re green) in the top-right so I can review them").\n\n## When NOT to Use This Tool\n- Do NOT use this tool to generate summaries or interpretations. It returns raw data only.\n- Do NOT use this tool when you already have the item IDs you need from a previous tool call.\n\n## Choosing the Right Parameters\n- **Deterministic filters are the DEFAULT.** Always prefer TextPattern, ColorSearch, ShapeTypes, Regions, and ItemsInProximity — alone or in combination. These are faster, more precise, and do not invoke an AI subagent.\n- **Use TextPattern alternation for broad conceptual searches.** If the user says "find payment-related shapes", use TextPattern "pay|invoice|billing|charge|transaction" rather than SelectionCriteria. Regex alternation can cover a wide semantic range without needing AI.\n- **SelectionCriteria is a LAST RESORT** for queries that genuinely require abstract semantic reasoning no deterministic filter can express (e.g., "find the main decision points in this workflow", "which shapes represent external dependencies?").\n- **Read the full canvas**: Use no filters and no SelectionCriteria to return everything, useful for getting an overall understanding of the document.\n\n## Examples\n\n### Basic: Find items by text\n> User says "I need to finish up the items marked TODO before our sprint review"\n- **TextPattern**: "TODO"\n- **SelectionCriteria**: "" (deterministic filter is sufficient)\n- **Why**: Simple text lookup — no semantic understanding needed.\n\n### Basic: Read the full canvas\n> User says "I just joined this project — can you walk me through what\'s on this board?"\n- No filters, no SelectionCriteria.\n- **Why**: Returns everything so you can understand the document\'s structure before taking action.\n\n### Semantic: Meaning-based query (rare — only when deterministic filters truly cannot express the query)\n> User says "Help me prepare for our architecture review — what are the key decision points in this workflow?"\n- **SelectionCriteria**: "main decision points in the workflow"\n- **Why**: "Decision point" is a semantic concept — a shape might be labeled "Approve?" or "Route A vs B" without literally containing the word "decision". No regex alternation pattern can reliably capture this because it requires understanding the shape\'s *role* in the workflow, not just its text.\n- **Note**: If the user had said "I\'m debugging a failing workflow — find the error-handling steps", prefer TextPattern "error|exception|fail|bug|issue" instead — that CAN be expressed deterministically.\n\n### Deterministic + semantic (only when the semantic part is truly necessary)\n> User says "We need to audit our third-party integrations — which shapes in the bottom-left section represent external dependencies?"\n- **Regions**: ["bottom_left"]\n- **SelectionCriteria**: "shapes that represent external dependencies"\n- **Why**: Region narrows spatially first (deterministic), then the AI subagent identifies which items represent "external dependencies" — a concept that requires reasoning about the shape\'s role and context, not just text matching.\n\n### Broad regex for conceptual text search\n> User says "We\'re updating our pricing model — find everything on the board related to payments"\n- **TextPattern**: "pay|invoice|billing|charge|transaction|receipt|refund"\n- **SelectionCriteria**: "" (regex alternation covers the semantic range)\n- **Why**: The user said "payments" but shapes might say "Invoice", "Billing System", "Charge Customer", etc. Use alternation to cast a wide net.\n\n### Proximity expansion for context\n> User says "I\'m presenting the executive summary section — what other details are grouped around the summary frame?"\n- **TextPattern**: "^summar.*"\n- **ShapeTypes**: ["container"]\n- **ItemsInProximity**: 10\n- **Why**: First find the summary container by text + shape type, then expand outward to discover nearby items. The original matches are always retained, and new items are added closest-first.\n\n### Multiple filters: region + regex + color\n> User says "Our approved items are green in the top-right — pull those up so I can export the list for the stakeholder update"\n- **Regions**: ["top_right"]\n- **TextPattern**: "approv|review|sign.?off|accept|reject|pending"\n- **ColorSearch**: { Hue: 120, HueTolerance: 30, SaturationMin: 30, SaturationMax: 100, ValueMin: 30, ValueMax: 100 }\n- **Why**: Three deterministic filters intersected with AND logic. Only items that are in the top-right AND contain approval-related text AND have a green fill will be returned.\n\n\n### Multiple filters: text + proximity\n> User says "I\'m checking what might be blocked — show me what\'s near the shapes that mention deadlines or due dates"\n- **TextPattern**: "deadline|due date|due by|overdue|timeline"\n- **ItemsInProximity**: 15\n- **SelectionCriteria**: ""\n- **Why**: Regex finds deadline-related shapes, then proximity expansion pulls in their neighbors for context.\n\n### Edge case: avoid redundant queries\n> If a previous tool call already returned item IDs you need, do NOT call this tool again to re-fetch them. Use the data you already have.\n',
E4a:i18n.get("ai-tool-loading-reading-canvas")};var UcpXj={Pm:Ucpd.i7,FU:"Produces targeted summaries of large documents by processing spatially coherent chunks.",Lz:3,description:'Produces highly targeted, specification-driven summaries of a large canvas/document by operating on spatial chunks.\n\n**CRITICAL REQUIREMENT - additionalPrompt usage:**\n- For general summarization: Leave additionalPrompt EMPTY - the tool will use appropriate defaults based on selection\n- For filtered summarization: Provide specific filtering instructions in additionalPrompt like "Locate and summarize all error-related content"\n\nThis tool is used as part of a multi-step process:\n- The overall document is split into spatially/semantically coherent chunks.\n- This tool is called once per chunk with your summary instructions.\n- For each chunk, it extracts only the information that matches your request and returns a dense, factual summary for that chunk.\n- Chunks that do not contain relevant information are effectively ignored (they return no usable summary), so unrelated content does not pollute the final result.\n\nThe outputs are optimized for **tool-to-tool communication**: compact, information-dense, and free of visual/styling noise.\n\n## Selection Handling\nThe tool automatically detects what to summarize:\n- If shapes are selected: summarizes only those selected shapes\n- If no shapes are selected: summarizes the entire document\n\n## Behavior Guarantees\n- The tool focuses on **content, not presentation**:\n  - It ignores styling, coordinates, fonts, and colors unless they carry explicit semantic meaning (e.g., colors encode status or type).\n- It is **strict about relevance**:\n  - If a chunk does not clearly match your requested topics and include criteria, it returns no effective summary for that chunk.\n- The resulting chunk summaries are:\n  - Dense, factual, and faithful to the underlying diagrams and notes.\n  - Easy for a coordinating tool to merge into a final, document-level summary.\n\n## When to Use This Tool\n- When the user specifically asks for a summary of a document or piece of a document\n  - Important that the user is referring to the document contents as this tool only works on the current document\n- When the user asks something that could be construed as wanting a summary of the document, like:\n  - "Tell me about this diagram"\n  - "What is this mindmap about?"\n\n## When NOT to Use This Tool\n- When the user asks for a summary of anything but the document contents\n  - If the user wants to summarize a file they uploaded, text they pasted, or anything else that is not found on the actual document in question, do not use this tool but message the user a summary manually\n',
E4a:i18n.get("ai-tool-loading-summarizing")};var UcqXj={Pm:Ucpd.yQ,FU:"Creates, modifies, and manages conditional formatting rules to style shapes based on conditions.",Lz:2,description:"## Role\n- Help users apply, modify, or remove conditional formatting rules on the canvas.\n- You are NOT able to delete any rules.\n\n## Capabilities\n- The system can format shapes based on the following:\n  - **Text:** If the shape's text or data field **exactly equals** a specific value, **contains** a string, or **does not contain** a string.\n  - **Numbers:** If a number in a shape's data field is **greater than**, **less than**, **equal to**, or within a **specific range**.\n  - **Shape Attributes:** The shape's **type**, its **data field values**, or its **containment** within other shapes.\n  - **Connections:** The number of connections a shape has to other shapes.\n- The system can apply the following visual effects:\n  - Applying a new **fill color**, **border color**, **text color**, or a predefined **shape style** or **icon**.\nIf the user's request falls outside these capabilities, the rule **cannot** be created.\n\n## Interaction Guidelines\n- Before making changes, always clarify which shapes the user wants to edit.\n- Ask the user to specify verbally.\n- If unclear, prompt them to manually select the shapes.\n- If the request for conditional formatting is vague, ask for more context about the desired changes.\n- Always explain what conditional formatting changes will be applied.\n- Maintain a friendly, collaborative, and action-oriented tone.\n- Provide a short (2-5 word) descriptive title to the tool that will be used as the title of the generated or updated rule.\n- If the user requests a specific title, you MUST include that rule name so that the tool will know to use it.\n- If the user requests to delete a rule, let them know that you're unable to do so.\n- If the user's request combines multiple conditions or effects that clearly require separate rules (e.g., \"make shapes\n  with 'High' red and shapes with 'Low' green\"), explicitly break these out into separate commands, each with its own\n  title, condition, and effect.\n\n## Editing Existing Rules\n- **IMPORTANT**: If users refer to a rule that was not created in the current conversation, tell them that they're only allowed to edit rules that were created in the current conversation.\n- When users ask to amend, modify, or edit already created conditional formatting rules, the command text MUST include the rule ID of the rule that needs to be edited.\n- The command text MUST clearly define the FULL rule specification, including both the condition and the effect, even when editing existing rules.\n- Example: \"Edit rule ABC123 to apply red background color to all shapes that contain the text 'Priority'\"\n- If a user requests to edit an existing rule but it's unclear which rule to edit, ask them to specify which rule they want to change.\n- Users are not aware of rule IDs or the existence of rule IDs, so you should ask them to select the rule they want to edit from the list of already-created rules in the conversation history.\n- If the user is trying to edit a rule that has been deleted, let them know.\n- When editing existing rules, you may only modify one rule per command. Do not attempt to edit multiple rules in a single command.\n\n## Technical Details\n- Applies deterministic rules globally to all shapes (e.g., based on value of shape text, shape data, shape type, number of connections to other shapes, or which container it belongs to).\n- If the user's request asks for multiple rules to be created, you MUST create multiple conditional formatting commands. One conditional formatting command CANNOT and MUST NOT have multiple formatting rules attached to it. Each rule must be its own command."};var UcrXj={Pm:Ucpd.PMc,FU:"Removes items such as shapes, sticky notes, and lines from the canvas.",Lz:2,description:'This tool is responsible for deleting items (shapes, sticky notes, lines, etc.) from the canvas. Use this tool when the user wants to remove, delete, or clear items from the document.\n\nWhen a block is deleted, any lines connected to it are automatically removed as well.\n\n## Examples\n- "Delete the sticky note"\n- "Remove the shape"\n- "Clear the items"\n- "Get rid of that"'};var UcsXj={Pm:Ucpd.HFe,FU:"Edits the text and properties of blocks and lines on the canvas.",Lz:2,description:"Use this tool to edit the properties of items (blocks and lines) on the canvas.\n\nNote: Currently only text editing is supported. Future enhancements will support color, size, and other properties."};var UctXj={Pm:Ucpd.PFe,Lz:4,FU:"Exports and downloads the current document as a file for the user.",description:'This tool exports and downloads the current document as a file. When called, it triggers a browser download of the document.\n\n## When to Use\n- The user asks to download, export, or save their document as a file\n- The user wants a PDF or image copy of their work\n- Examples: "Download this as a PDF", "Export my document", "Save this as a PNG"\n\n## When NOT to Use\n- The user wants to print\n- The user wants to share the document with others (that\'s a different workflow)\n- The user wants to save changes to the document (changes are auto-saved)\n\n## Important Notes\n- This triggers an immediate browser download — the user will see a file download in their browser\n- The download includes all pages in the document'};var UcuXj={Pm:Ucpd.ZMc,FU:"Retrieves and filters context from the document, extracting relevant items and properties.",Lz:3,description:"This is your primary way to *read* the canvas or document.\nThis tool retrieves and filters context from the document, extracting only the items, properties, or entire diagrams that are relevant to the request.\n\n**NOTE**: This tool is NOT to be used to generate summaries or interpretations of the document. It is solely to filter and return raw context, with no added commentary.\n\n## How It Works\n- It searches across the entire document for items that match the criteria (e.g., by color, tags, text alignment, shape type, notes).\n- It can return specific items along with only the properties that were requested.\n- It can also declare that an entire diagram is relevant when every part of it matches.\n\nUse plain language in selectionCriteria: the tool translates your instructions into filters internally.\nThink of this as telling the assistant *what to pull out of the canvas so other tools can work with it*.",
E4a:i18n.get("ai-tool-loading-reading-canvas")};var UcvXj={Pm:Ucpd.b5b,FU:"Generates ideas based on prompts or selections and adds them as sticky notes.",Lz:2,description:'Generates ideas and adds them to the canvas as a NEW GRID OF STICKY NOTES.\n\n## What This Tool Does\n- Creates a fresh set of ideas as individual sticky notes arranged in a grid\n- Can generate ideas based on a user prompt or selected items on the canvas\n- The output is always sticky notes, not diagram nodes or connected shapes\n\n## When to Use This Tool\n- When the user wants to brainstorm ideas as sticky notes\n- When creating a new collection of ideas independent of existing diagram structures\n- When the user explicitly asks for sticky notes or a brainstorming grid\n\n## When NOT to Use This Tool\n- **DO NOT use this tool if the user wants to add content to an EXISTING DIAGRAM** (flowchart, mindmap, ERD, etc.)\n- If the user has a mindmap and asks to "add ideas to the mindmap", use Generate Diagram instead - they want to edit the diagram structure, not create sticky notes\n- If the user mentions editing, updating, expanding, or adding to an existing diagram, use Generate Diagram regardless of whether they use words like "ideas" or "brainstorm"\n- If there\'s any existing diagram on the canvas that the user is referencing, default to Generate Diagram\n\n## Key Principle\nWords like "ideas" or "brainstorm" don\'t automatically mean this tool should be used. Check the context:\n- Existing diagram being edited? → Use Generate Diagram\n- New standalone sticky notes? → Use this tool\n',
E4a:i18n.get("ai-tool-loading-generating-ideas")};var UcwXj={Pm:Ucpd.BGf,FU:"Returns JSON schemas for one or more resource types in a semantic dataset.",Lz:3,description:'This tool returns the JSON schema for each requested resource type in a semantic dataset.\nSchemas describe the shape of the data — which fields are available, their types, and how data points relate to each other.\nUse schemas to understand what fields you can filter or query on before calling QuerySemanticResources.\n\n## When to Use\n- After knowing which resource types are relevant to the user\'s question, fetch their schemas to understand the available fields\n- Use this before forming a QuerySemanticResources call when you need to know what data is available\n\n## When NOT to Use\n- Do not fetch all resource type schemas at once — only request schemas for the types relevant to the user\'s question\n- Skip this call if you already know the schema for the resource types you need\n\n## Output\nA JSON object mapping each requested resource type to its JSON schema.\nFor example:\n{\n  "type1": { ... JSON schema for type1 ... },\n  "type2": { ... JSON schema for type2 ... },\n  "type3": { ... JSON schema for type3 ... }\n}\nIf a schema is not found for a particular resource type, that will be indicated in the result.'};var UcxXj={Pm:Ucpd.CGf,FU:"Returns all resource types available in a given semantic dataset.",Lz:3,description:'This tool returns all resource types present in a specific semantic dataset.\nUse this to understand what kinds of data are available before deciding which schemas to fetch or which resources to query.\n\n## When to Use\n- After obtaining a dataset ID (via GetSemanticDatasetIdsForDomain), call this to discover what resource types exist in that dataset\n- Use this before fetching schemas or querying resources, to know what types are available\n\n## When NOT to Use\n- You already called this tool for the dataset and have the resource types cached\n\n## Output\nA JSON array of resource types as strings, e.g.:\n`["type1", "type2", "type3"]`\n\nIf the dataset is not found or has no resource types, the result will say so.'};var UcyXj={Pm:Ucpd.DGf,FU:"Captures a visual screenshot of the document/canvas for AI vision analysis of layout, colors, and spatial relationships.",Lz:3,description:['**Get Screenshot Tool**: Captures a visual screenshot of the document/canvas for vision-based analysis.\n\nUse this tool when you need to understand:\n- Visual layout and spatial relationships between shapes\n- Colors, sizes, and positioning of elements\n- Overall diagram structure and organization\n- Alignment and spacing issues\n- Visual properties that aren\'t captured in text-based tools like FilterCanvas\n\n**Parameters:**\n- captureScope: What to capture (Viewport, FullPage, or Selection)\n- includeBackground: Whether to include the page background\n\n**When to use:**\n- User asks about visual appearance ("What does this look like?")\n- User asks about layout ("Are these aligned?")\n- User asks about colors or styling ("What color is this shape?")\n- You need to verify spatial relationships before making changes\n- You want to understand the visual context before answering questions\n\n**When NOT to use:**\n- For text content analysis (use FilterCanvas instead)\n- For semantic structure (use FilterCanvas instead)\n- When shape properties are already known from previous tools\n\n**Example scenarios:**\n- "Show me what the canvas looks like" → Use GetScreenshot with Viewport scope\n- "Are these shapes aligned properly?" → Use GetScreenshot then analyze positioning\n- "What\'s the layout of this section?" → Use GetScreenshot to see spatial arrangement']};var UczXj={Pm:Ucpd.jGe,FU:"Returns the semantic dataset IDs in the document for a given semantic domain.",Lz:3,description:'This tool returns the semantic dataset IDs present in the current document for a specific semantic domain. Given a domain key, it returns an array of semantic dataset IDs of that domain type.\n\n## When to Use\n- You know the DomainType the user is referring to and need the dataset IDs for that domain\n- Use this tool to discover dataset IDs for a specific domain before acting on them\n\n## When NOT to Use\n- You already know the specific dataset IDs the user is referring to — avoid redundant calls\n\n## Output\nAn array of dataset ID strings for the given domain, e.g.:\n`["uuid-1", "uuid-2"]`\n\nIf the document has no semantic data for the given domain, the result will say so.'};var UcAXj={Pm:Ucpd.Ved,FU:"Searches help center articles to provide guidance for unsupported requests. This tool is used as a fallback for when you cannot directly support the user's request.",Lz:4,description:"When unable to fulfill a request, invoke this tool to search the help center for an article that can help.\n\nUse this tool to query lucid help center articles to construct a response. Always use this tool first when the user is asking you something that you or another tool cannot do.\nWhen selecting this tool you should also provide a single concise sentence that explains you cannot directly perform the action the user is requesting.",
E4a:i18n.get("ai-tool-loading-searching-helpdesk")};var UcBXj={Pm:Ucpd.ERd,FU:"Imports templates from the template library to bootstrap a document based on user requests.",Lz:1,description:"Imports all shapes from a template to bootstrap a document based on the user's request.",E4a:i18n.get("ai-tool-loading-importing-template")};var UcCXj={Pm:Ucpd.fOf,Lz:3,FU:"Queries resources from a semantic dataset with optional filters by type, keyword, or related resource.",description:"This tool retrieves actual semantic resources from a dataset, with optional filters to narrow the results.\nUse this to answer specific user questions about their data once you know what resource types and fields are available.\n\n## When to Use\n- After determining which resource types are relevant (via GetResourceTypesForDataset) and optionally understanding their schemas (via GetResourceSchemasForDataset)\n- When the user wants to find specific resources, answer questions about their data, or use data to create/modify shapes\n\n## When NOT to Use\n- Do not call without at least one filter — unfiltered queries on large datasets may return too many results and be unhelpful\n- Do not guess field names or filters without consulting the schema first\n\n## Warning\n- This tool enforces a result cap by default to prevent context bloating. If the cap is hit, the response will include a truncation warning instructing you to call the tool again with `bypassCap` set to `true` to retrieve the full result set.\n\n## Filters\n- `resourceTypes`: Required. Must include at least one resource type to filter results by.\n- `keyword`: Search resources by keyword against resource names\n- `relatedTo`: Find resources related to specific resources (provide their resource ids)\n- `bypassCap`: Set to `true` only after instructed by a truncation warning and you are sure you will need the full set of resources. Defaults to `false`.\n- Multiple filters can be combined\n\n## Output\nA JSON array of matching semantic resources, each with id, name, type, and data fields.\nIf the dataset is not found or no resources match, the result will say so."};var UcDXj={Pm:Ucpd.BOf,FU:"Removes decisions from the persistent process context frame on the document, typically to resolve contradictions before adding a replacement decision.",Lz:0,A1c:!1,description:"**Remove Decisions from Process Context Frame Tool**\n\nRemoves one or more decisions from the process context frame on the document.\n\n**When to Use:**\n- When the user provides information that contradicts an existing decision in the context frame. Remove the conflicting decision, then call AddDecisionsToProcessContextFrame with the new decision.\n- When the user explicitly asks to remove a decision from the context frame.\n\n**When NOT to Use:**\n- When no decisions exist in the context frame.\n\n**Key Behaviors:**\n- Multiple decisions can be removed in a single call.\n- Can be called alongside other tools (not a terminator).\n"};var UcEXj={Pm:Ucpd.Nxa,FU:"Sorts, categorizes, or clusters canvas objects into named groups.",Lz:2,description:'Sorts, categorizes, or clusters objects on the canvas into named groups.\n\n### Capabilities\n- Takes a list of canvas objects, makes a copy of them, and sorts them into groups based on shared characteristics, relationships, or user-defined criteria.\n- Can identify patterns, similarities, or connections between objects to create meaningful groupings.\n- Does NOT move or modify the original objects, but instead creates new copies of them organized into groups.\n- Can NOT operate on diagrams, only standalone items.\n\n### Usage Guidelines\n- Always pass ItemIds when the user has asked for specific items to be sorted.\n  - e.g., if the user says "Sort the sticky notes based on priority", ensure the tool call includes the ItemIds of those sticky notes, which you should identify by reading the canvas.\n- If no ItemIds are provided, the tool will attempt to sort the user\'s selected items, so leave ItemIds blank if the user wants to sort the selection.\n- If no ItemIds are provided and there is no selection, the tool will sort all canvas objects. This should be rare, so try to provide ItemIds whenever possible unless the user references the selection.\n\n### Gotchas\n- If the user is asking for specific shapes to be sorted, you MUST call filter canvas to identify the ItemIds of those shapes and pass them to the tool. Failure to do so may result in the tool sorting the wrong items or all items on the canvas, which you must avoid.\n- ALWAYS read the canvas first, unless the user just wants to summarize the selection.',
E4a:i18n.get("ai-tool-loading-sorting-shapes")};var UcFXj={Pm:Ucpd.RJe,FU:"Generates structured board content like retrospectives, sprint planning boards, brainstorming sessions, and other collaborative layouts.",Lz:1,description:"This tool generates structured canvas content using the Standard Import format and\nplaces it directly on the canvas.\n\n## When to use this tool\nUse this tool when the user wants to:\n- Create a new board layout from a text description\n- Generate structured content like retrospectives, sprint planning boards, brainstorming sessions, etc.\n- Set up a board template based on their described workflow\n- Create organized layouts with sticky notes, containers, or grouped content\n\n## How it works\nThe tool takes a detailed text prompt describing the desired content, generates the corresponding\ndocument structure using the Standard Import format, and places it on the canvas. The prompt\nshould include all relevant context since the tool cannot see the chat history or existing\ncanvas content."};var UcGXj={Pm:Ucpd.vsc,FU:"Converts user text descriptions into structured, visual board content.",Lz:1,description:'This tool creates a visual board - a structured canvas layout - from natural language descriptions\n\n## What a board is\n  A board is a visual workspace organized into labeled sections (frames), each containing content. Boards are ideal for any activity that benefits from visual\n  organization, categorization, or structured thinking — not just software/agile contexts.\n\n\n## When to use this tool\nUse this tool when the user wants to:\n- Create a new board layout from a text description\n- Generate structured content like retrospectives, sprint planning boards, brainstorming sessions, etc.\n- Prepare a template-like workspace that participants can fill in, e.g., set up a SWOT analysis\n- Set up a board template based on their described workflow\n\n## When NOT to use this tool\n  - Do NOT use this tool for creating connected diagrams like flowcharts, ERDs, etc. — use Generate Diagram instead\n  - Do NOT use this tool when the user just wants to add a single shape or sticky note — use Add Block or Generate Ideas instead\n  - Do NOT use this tool when the user just wants a flat list of brainstormed ideas as sticky notes without any board structure — use Generate Ideas instead\n\n## Choosing between this tool and Generate Ideas\n  - There is some overlap between this tool and Generate Ideas since both can create sticky notes from text prompts, but the key difference is that this tool creates a structured board layout with labeled frames, while Generate Ideas creates a flat collection of unorganized sticky notes.\n  - Use this tool when the user wants organized, structured brainstorming with labeled sections or categories (e.g., "brainstorm pros and cons", "create a brainstorming session")\n  - Use Generate Ideas when the user wants a simple flat collection of ideas as sticky notes without a structured layout (e.g., "brainstorm names for my project", "give me ideas for team activities")\n\n## After using this tool\n  - ONLY tell the user what was created. You MUST NOT ask follow-up questions, suggest edits, offer refinements, or prompt the user for next steps.\n  - There is NO ability to edit or refine boards generated with this tool, so any follow-up questions are misleading and not actionable.\n  - Your response MUST be a simple statement of what was generated — nothing more.\n\n\n## How it works\nThe tool analyzes the user\'s request to determine what type of board they want to create, then generates the appropriate board structure and content.',
E4a:i18n.get("ai-tool-loading-generating-board")};var UcHXj={Pm:Ucpd.wGf,Lz:1,FU:"Generates a diagram within the agent's semantic domain from a prompt and links shapes to semantic data sources using resource ID labels.",description:'Generates a diagram within the agent\'s semantic domain from a prompt using the domain\'s shape library, then automatically links shapes whose labels match semantic resource IDs to their corresponding data sources in the specified datasets.\n\n## When to Use\n- When the user wants to create a diagram that incorporates live data from semantic datasets in the document\n- Only after querying the semantic data (using GetResourceTypesForDataset, GetResourceSchemasForDataset, QuerySemanticResources, etc.) to understand what resources are available\n- When the user\'s intent relates to the domain\'s architecture and involves at least some data-backed shapes\n\n## When NOT to Use\n- Before using query tools to understand the available data — always gather data context first\n- For general diagrams with no data backing — use GenerateDiagram instead\n- For non-domain diagrams\n\n## How Data-Backed Shapes Work\n- To make a shape data-backed, the prompt must use the resource ID as the exact shape label — no additional text, no modifications\n- Resource IDs may contain special characters (such as double-quote characters) that must appear verbatim in the label — see the `prompt` parameter description for how to handle this correctly\n- The tool automatically detects labels that match resource IDs in the provided datasets and links them\n- Shapes with regular descriptive labels are created as normal (non-data-backed) shapes\n- Do NOT include semantic framework terminology ("semantic data", "datasets", "semantic resources") in the prompt — the tool handles linking internally\n\n## Shape Library\n- All shapes must use the domain\'s shape library only'};var UcIXj={Pm:Ucpd.yGf,Lz:3,FU:"Retrieves canvas shapes backed by semantic data from a specific dataset.",description:"This tool finds shapes on the canvas that are linked to semantic resources in a specific dataset, and returns their JSON representation.\n\n## When to Use\n- When the user asks about shapes on the canvas that are linked to semantic data — note: not all shapes are data-backed.\n- When you need shape IDs in order to act on (move, edit, select, etc) specific data-backed shapes\n- After querying resources via QuerySemanticResources, to find their corresponding shapes on the canvas\n\n## When NOT to Use\n- Do not use to query resources in the semantic dataset itself — use QuerySemanticResources for that\n- Do not use if you only need resource data without needing the shapes\n- Not all shapes in the domain are data-backed. If you need to find shapes that are NOT linked to semantic resources, use CanvasQuery instead\n\n## Filters\n- `resourceTypes`: Return only shapes linked to resources of these types\n- `resourceIds`: Return only shapes linked to these specific resource IDs\n- If provided together, both filters are applied (AND logic)\n- Filters are required to prevent excessive results. If no filters are provided, the tool will return an error instructing you to provide at least one filter.\n\n## Warning\n- This tool enforces a result cap by default to prevent context bloating. If the cap is hit, the response will include a truncation warning instructing you to call again with `bypassCap` set to `true`, only use this if you are certain you need the full set.\n\n## Output\nA JSON representation of the matching canvas shapes, in the same format returned by CanvasQuery."};var UcJXj={Pm:Ucpd.hGe,E4a:i18n.get("ai-tool-get-document-history-loading-text"),FU:"Retrieves the most recent actions on the document to understand what changed and who changed it.",Lz:0,description:"Returns the most recent document actions in chronological order.\n\nEach action has an `Action` field indicating its type and some additional fields depending on the type of the action.\n\nWhen to use:\n- To understand what the user was recently working on before their current request\n- To detect changes made outside your own tool calls (e.g. manual user edits between turns)\n- To verify whether a previous operation produced the expected result"};var UcKXj={Pm:Ucpd.Lpa,FU:"Undoes the most recent action on the canvas, reverting the last change.",Lz:2,A1c:!0,description:['## Role\nUse this tool to undo canvas actions when the user asks to go back, undo, revert, or ctrl+z their changes.\nThe tool will automatically display a confirmation dialog to the user — you do not need to ask for confirmation first.\n\n## When to Use\n- User says "undo", "go back", "revert", "ctrl+z", "undo that", "take that back", or similar\n- User expresses dissatisfaction with recent AI-made changes and wants them reversed\n- User asks to undo multiple steps (e.g. "undo the last 3 changes") — set Steps accordingly\n\n## Parameters\n- **Steps** (optional): Number of undo steps to revert. Omit or set to 1 for a single undo. Set to the number the user specifies for multi-step requests.\n\n## Limitations\n- Each step undoes one undo batch (one logical change)\n- If there is nothing to undo, the tool will inform the user']};var UcLXj={Pm:Ucpd.NUf,FU:"Wraps existing items in an assisted layout container for editing.",Lz:2,description:"This tool creates an assisted layout container around existing items on the canvas.\nUse this when items need to be edited but are not already inside an assisted layout container.\nItems must be contiguously connected (all connected via lines) and cannot already be in an assisted layout."};var UcMXj=[{role:Uc2e.VMa,Og:Uc2e.nw,Sk:UcOe.aq,Bu:{contents:"Create a flowchart for the agile development process.",title:"Create a flowchart for the agile development process.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A(("Start"))\n  B["Define Product Backlog: Gather requirements, prioritize features, and create backlog items"]\n  C["Sprint Planning: Select items from the backlog to work on during the upcoming sprint, define sprint goals"]\n  D["Sprint Execution: Implement features, conduct daily stand-up meetings to track progress, and address issues"]\n  E{"Testing and Integration: Validate new features through testing and integrate them into the existing system"}\n  F["Review and Retrospective: Evaluate sprint outcomes, reflect on successes and areas for improvement"]\n  G["Update Product Backlog: Modify backlog based on feedback, new insights, and changes in priority"]\n  H(("End"))\n  I{"Completion Check: Confirm all sprint goals have been met and the product increment is ready for demonstration"}\n  J["Return Point: Re-evaluate current sprint\'s product backlog for thorough review"]\n  A --\x3e B\n  B --\x3e C\n  C --\x3e D\n  D --\x3e E\n  E --\x3e|"yes"| F\n  E --\x3e|"no"| J\n  J --\x3e C\n  F --\x3e G\n  G --\x3e I\n  I --\x3e|"yes"| H\n  I --\x3e|"no"| J\n  J --\x3e C',
Nu:"Create a flowchart for the agile development process."}}];var UcNXj=[{role:Uc2e.ufa,Og:Uc2e.nw,Sk:UcOe.aq,Bu:{contents:"Create a flowchart for the company’s strategic planning process.",title:"Create a flowchart for the company’s strategic planning process.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TB\n  A["`CEO: \nResponsible for overall company strategy, leadership, and direction`"] --\x3e B["`COO: \nOversees daily operations and implements company policies`"]\n  A --\x3e C["`CFO: \nManages financial planning, risk management, and financial reporting`"]\n  A --\x3e D["`CTO: \nLeads technology strategy, product development, and innovation`"]\n  B --\x3e E["`VP of Operations: \nEnsures efficient workflow and process management`"]\n  B --\x3e F["`VP of Human Resources: \nManages recruitment, training, and employee relations`"]\n  C --\x3e G["`VP of Finance: \nHandles budgeting, forecasting, and financial compliance`"]\n  C --\x3e H["`VP of Risk Management: \nIdentifies and mitigates financial and operational risks`"]\n  D --\x3e I["`VP of Engineering: \nLeads engineering teams through development and maintenance phases`"]\n  D --\x3e J["`VP of Product: \nOversees product strategy, development, and market fit`"]',
Nu:"Create a flowchart for the company’s strategic planning process."}},{role:Uc2e.ufa,Og:Uc2e.UA,Sk:UcOe.aq,Bu:{contents:"Design an org chart for the executive management team.",title:"Design an org chart for the executive management team.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TB\n  A["`CEO: \nResponsible for overall company strategy, leadership, and direction`"] --\x3e B["`COO: \nOversees daily operations and implements company policies`"]\n  A --\x3e C["`CFO: \nManages financial planning, risk management, and financial reporting`"]\n  A --\x3e D["`CTO: \nLeads technology strategy, product development, and innovation`"]\n  B --\x3e E["`VP of Operations: \nEnsures efficient workflow and process management`"]\n  B --\x3e F["`VP of Human Resources: \nManages recruitment, training, and employee relations`"]\n  C --\x3e G["`VP of Finance: \nHandles budgeting, forecasting, and financial compliance`"]\n  C --\x3e H["`VP of Risk Management: \nIdentifies and mitigates financial and operational risks`"]\n  D --\x3e I["`VP of Engineering: \nLeads engineering teams through development and maintenance phases`"]\n  D --\x3e J["`VP of Product: \nOversees product strategy, development, and market fit`"]',
Nu:"Design an org chart for the executive management team."}},{role:Uc2e.ufa,Og:Uc2e.AU,Sk:UcOe.aq,Bu:{contents:"Generate a task board for quarterly business goals.",title:"Generate a task board for quarterly business goals.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A(["Start"])\n  B(["Set quarterly revenue targets"])\n  C(["Identify key growth metrics"])\n  D(["Plan marketing campaigns"])\n  E(["Allocate budget"])\n  F(["Delegate tasks to teams"])\n  G(["Monitor progress"])\n  H(["Review and analyze results"])\n  I(["Adjust strategies if necessary"])\n  J(["Achieve quarterly business goals"])\n  K(["End"])\n  A --\x3e B\n  B --\x3e C\n  C --\x3e D\n  D --\x3e E\n  E --\x3e F\n  F --\x3e G\n  G --\x3e H\n  H --\x3e I\n  I --\x3e J\n  J --\x3e K',
Nu:"Generate a task board for quarterly business goals."}},{role:Uc2e.ufa,Og:Uc2e.NHa,Sk:UcOe.aCb,Bu:{contents:"Create a database model for customer relationship management.",title:"Create a database model for customer relationship management.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nerDiagram\n    Customer {\n        string Id\n        string FirstName\n        string LastName\n        string Email\n        string PhoneNumber\n    }\n\n    Address {\n        string Id\n        string CustomerId\n        string Street\n        string City\n        string State\n        string ZipCode\n    }\n\n    Order {\n        string Id\n        string CustomerId\n        datetime OrderDate\n        double TotalAmount\n    }\n\n    Product {\n        string Id\n        string Name\n        double Price\n    }\n\n    OrderItem {\n        string Id\n        string OrderId\n        string ProductId\n        int Quantity\n        double LineTotal\n    }\n\n    SupportTicket {\n        string Id\n        string CustomerId\n        datetime DateOpened\n        string IssueDescription\n        string Status\n    }\n\n    Note {\n        string Id\n        string CustomerId\n        datetime DateCreated\n        string Content\n    }\n\n    Customer ||--|{ Address: has\n    Customer ||--|{ Order: places\n    Order ||--|{ OrderItem: includes\n    OrderItem ||--|| Product: contains\n    Customer ||--|{ SupportTicket: raises\n    Customer ||--|{ Note: has',
Nu:"Create a database model for customer relationship management."}},{role:Uc2e.ufa,Og:Uc2e.Fia,Sk:UcOe.zBa,Bu:{contents:"Design a document management system for internal procedures.",title:"Design a document management system for internal procedures.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nclassDiagram\n    class Document {\n        +id: string\n        +title: string\n        +content: string\n        +author: string\n        +dateCreated: Date\n        +dateModified: Date\n    }\n\n    class Procedure {\n        +id: string\n        +name: string\n        +description: string\n        +steps: string\n        +owner: string\n    }\n\n    class User {\n        +id: string\n        +name: string\n        +email: string\n        +role: string\n    }\n\n    class DocumentRepository {\n        +addDocument(doc: Document): void\n        +removeDocument(docId: string): void\n        +getDocument(docId: string): Document\n        +listDocuments(): Document[]\n    }\n\n    class ProcedureRepository {\n        +addProcedure(proc: Procedure): void\n        +removeProcedure(procId: string): void\n        +getProcedure(procId: string): Procedure\n        +listProcedures(): Procedure[]\n    }\n\n    class UserManagement {\n        +addUser(user: User): void\n        +removeUser(userId: string): void\n        +getUser(userId: string): User\n        +listUsers(): User[]\n    }\n\n    class Notification {\n        +sendNotification(user: User, message: string): void\n    }\n\n    DocumentRepository ..> Document : manages\n    ProcedureRepository ..> Procedure : manages\n    UserManagement ..> User : manages\n    Notification ..> User : notifies',
Nu:"Design a document management system for internal procedures."}},{role:Uc2e.ufa,Og:Uc2e.LF,Sk:UcOe.aq,Bu:{contents:"Generate a brainstorming mindmap for optimizing business operations.",title:"Generate a brainstorming mindmap for optimizing business operations.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A["Start"] --\x3e B["Brainstorm Optimization Strategies"]\n  B --\x3e C["Identify Bottlenecks"]\n  B --\x3e D["Analyze Current Processes"]\n  C --\x3e E["Automate Repetitive Tasks"]\n  C --\x3e F["Improve Workflow"]\n  C --\x3e G["Enhance Communication"]\n  D --\x3e H["Conduct Time-and-Motion Studies"]\n  D --\x3e I["Gather Employee Feedback"]\n  D --\x3e J["Leverage Technology"]\n  E --\x3e K["Implement RPA (Robotic Process Automation)"]\n  F --\x3e L["Utilize Lean Methodologies"]\n  F --\x3e M["Adopt Agile Practices"]\n  G --\x3e N["Use Collaboration Tools"]\n  G --\x3e O["Regular Team Meetings"]\n  H --\x3e P["Identify Efficiency Opportunities"]\n  I --\x3e Q["Address Pain Points"]\n  J --\x3e R["Adopt New Software"]\n  R --\x3e S["Train Employees"]\n  K --\x3e T["Continuous Monitoring"]\n  S --\x3e U["Measure Impact"]\n  U --\x3e V["Adjust Strategies as Needed"]\n  V --\x3e W["Improve Business Processes"]\n  W --\x3e Z["End"]',
Nu:"Generate a brainstorming mindmap for optimizing business operations."}}];var UcOXj=[{role:Uc2e.xxa,Og:Uc2e.nw,Sk:UcOe.aq,Bu:{contents:"Create a flowchart for handling customer service inquiries.",title:"Create a flowchart for handling customer service inquiries.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A("Start") --\x3e B["Receive customer inquiry"]\n  B --\x3e C["Categorize inquiry"]\n  C --\x3e D{"Is it a technical issue?"}\n  D --\x3e|"Yes"| E["Assign to technical support"]\n  D --\x3e|"No"| F{"Is it a billing issue?"}\n  F --\x3e|"Yes"| G["Assign to billing department"]\n  F --\x3e|"No"| H{"Is it a general question?"}\n  H --\x3e|"Yes"| I["Answer query directly"]\n  H --\x3e|"No"| J["Escalate to supervisor"]\n  E --\x3e K["Resolve technical issue"]\n  G --\x3e L["Resolve billing issue"]\n  J --\x3e M["Supervisor resolves issue"]\n  I --\x3e N["Confirm customer satisfaction"]\n  K --\x3e N\n  L --\x3e N\n  M --\x3e N\n  N --\x3e O("End")',
Nu:"Create a flowchart for handling customer service inquiries."}},{role:Uc2e.xxa,Og:Uc2e.UA,Sk:UcOe.aq,Bu:{contents:"Design an org chart for the customer service department.",title:"Design an org chart for the customer service department.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A["Start"] --\x3e B["Customer Service Department Head"]\n  B --\x3e C["Customer Service Manager"]\n  C --\x3e D["Team Lead 1"]\n  C --\x3e E["Team Lead 2"]\n  D --\x3e F["Customer Service Representative 1"]\n  D --\x3e G["Customer Service Representative 2"]\n  D --\x3e H["Customer Service Representative 3"]\n  E --\x3e I["Customer Service Representative 4"]\n  E --\x3e J["Customer Service Representative 5"]\n  E --\x3e K["Customer Service Representative 6"]\n  K --\x3e L["End"]',
Nu:"Design an org chart for the customer service department."}},{role:Uc2e.xxa,Og:Uc2e.AU,Sk:UcOe.aq,Bu:{contents:"Generate a flowchart for managing customer service tasks.",title:"Generate a flowchart for managing customer service tasks.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A["Start"] --\x3e B["Receive customer inquiry"]\n  B --\x3e C["Classify inquiry type"]\n  C --\x3e D{"Is it a technical issue?"}\n  D --\x3e|"Yes"| E["Forward to technical support"]\n  D --\x3e|"No"| F{"Is it a billing issue?"}\n  F --\x3e|"Yes"| G["Forward to billing department"]\n  F --\x3e|"No"| H["Forward to general customer support"]\n  E --\x3e I["Technical support resolution"]\n  G --\x3e J["Billing department resolution"]\n  H --\x3e K["General support resolution"]\n  I --\x3e L["Communicate resolution to customer"]\n  J --\x3e L\n  K --\x3e L\n  L --\x3e M["Close the inquiry"]\n  M --\x3e N["End"]',
Nu:"Generate a flowchart for managing customer service tasks."}},{role:Uc2e.xxa,Og:Uc2e.vDe,Sk:UcOe.aq,Bu:{contents:"Create an account map that outlines the major decisionmakers in an organization.",title:"Create an account map that outlines the major decisionmakers in an organization.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  CEO["CEO"]\n  CEO --\x3e VP_Fin["VP of Finance"]\n  CEO --\x3e VP_Mark["VP of Marketing"]\n  CEO --\x3e VP_Sales["VP of Sales"]\n  VP_Fin --\x3e Dir_Acc["Director of Accounting"]\n  VP_Fin --\x3e Dir_Tax["Director of Tax"]\n  VP_Mark --\x3e Dir_MktgOps["Director of Marketing Operations"]\n  VP_Sales --\x3e Dir_SalesOps["Director of Sales Operations"]\n  Dir_Acc --\x3e Mgr_Acc["Accounting Manager"]\n  Dir_Tax --\x3e Mgr_Tax["Tax Manager"]\n  Dir_MktgOps --\x3e Mgr_Mktg["Marketing Manager"]\n  Dir_SalesOps --\x3e Mgr_Sales["Sales Manager"]\n  Mgr_Acc --\x3e Acc_Emp["Accounting Employees"]\n  Mgr_Tax --\x3e Tax_Emp["Tax Employees"]\n  Mgr_Mktg --\x3e Mktg_Emp["Marketing Employees"]\n  Mgr_Sales --\x3e Sales_Emp["Sales Employees"]',
Nu:"Create an account map that outlines the major decisionmakers in an organization."}},{role:Uc2e.xxa,Og:Uc2e.eIa,Sk:UcOe.aq,Bu:{contents:"Design a user journey map that outlines the customer experience for a banking app.",title:"Design a user journey map that outlines the customer experience for a banking app.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  A["Start"] --\x3e B["User downloads and installs the banking app"]\n  B --\x3e C["User opens the app"]\n  C --\x3e D["User creates an account"]\n  D --\x3e E["Security check (e.g., One-Time Password verification)"]\n  E --\x3e F["Account creation successful?"]\n  F --\x3e|"Yes"| G["User sets up profile (e.g., personal details, preferences)"]\n  F --\x3e|"No"| H["User reattempts account creation"]\n  G --\x3e I["User explores app features"]\n  I --\x3e J["User attempts a financial transaction"]\n  J --\x3e K["Transaction type (e.g., transfer, payment, deposit)"]\n  K --\x3e L["Security check (e.g., PIN, biometric verification)"]\n  L --\x3e M["Transaction successful?"]\n  M --\x3e|"Yes"| N["User receives transaction confirmation"]\n  M --\x3e|"No"| O["User reattempts transaction"]\n  N --\x3e P["User navigates to customer support for queries/help"]\n  P --\x3e Q["User chooses support method (e.g., chat, email, phone)"]\n  Q --\x3e R["User receives support and resolution"]\n  R --\x3e S["User provides feedback on the app experience"]\n  S --\x3e T["User logs out"]\n  T --\x3e U["End"]',
Nu:"Design a user journey map that outlines the customer experience for a banking app."}},{role:Uc2e.xxa,Og:Uc2e.LF,Sk:UcOe.zBa,Bu:{contents:"Generate a brainstorming mindmap that outlines new customer service strategies.",title:"Generate a brainstorming mindmap that outlines new customer service strategies.",Tu:'%%{init:{"theme":"base","themeCSS":".edge-thickness-normal{ stroke-width: 1px; }.node rect{ stroke-width: 1px; }","themeVariables":{"fontSize":"10pt","fontFamily":"Liberation Sans","primaryColor":"#fff","primaryTextColor":"#3a414a","primaryBorderColor":"#3a414a"}}}%%\nflowchart TD\n  B["Brainstorm Customer Service Improvements"]\n  B --\x3e C["Training Enhancements"]\n  B --\x3e D["Technology Upgrades"]\n  B --\x3e E["Communication Improvements"]\n  B --\x3e F["Feedback Mechanisms"]\n  subgraph Training\n    C --\x3e CA["Increase Training Frequency"]\n    C --\x3e CB["Develop Advanced Training Modules"]\n    C --\x3e CC["Implement Mentorship Programs"]\n  end\n  subgraph Technology\n    D --\x3e DA["Upgrade CRM Software"]\n    D --\x3e DB["Introduce AI Chatbots"]\n    D --\x3e DC["Improve Service Monitoring Tools"]\n  end\n  subgraph Communication\n    E --\x3e EA["Enhance Multichannel Communication"]\n    E --\x3e EB["Regularly Update FAQs"]\n    E --\x3e EC["Standardize Communication Protocols"]\n  end\n  subgraph Feedback\n    F --\x3e FA["Implement Customer Satisfaction Surveys"]\n    F --\x3e FB["Track Feedback and Trends"]\n    F --\x3e FC["Incorporate Feedback into Training"]\n  end',
