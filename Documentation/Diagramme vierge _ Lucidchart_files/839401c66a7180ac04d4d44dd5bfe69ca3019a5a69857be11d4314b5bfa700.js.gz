linkedRoles:[{roleId:"080a2064-1d32-4c02-a58b-0e67de399c12",comment:null,name:"Business Owner",description:""}],roles:[{id:"080a2064-1d32-4c02-a58b-0e67de399c12",name:"Business Owner",restrictToFactSheetTypes:["Application"],subscriptionType:null}]},Af:{}},{uf:{id:"b4bd0d5e-4e1e-4025-b0db-57db6ea0b0cb",userId:"73c8d857-f15f-4fd5-80d8-e3bf68600d92",type:"RESPONSIBLE",linkedRoles:[{roleId:"5aaa00ff-2f14-445b-9107-d70c013fb152",comment:null,name:"Application Owner",description:""}],roles:[{id:"5aaa00ff-2f14-445b-9107-d70c013fb152",
name:"Application Owner",restrictToFactSheetTypes:["Application"],subscriptionType:"RESPONSIBLE"}]},Af:{}}],Ag:[{origin:"raw",path:"linkedRoles.roleId",target:UcMh.VJe}]};var UcaZj={Pm:Ucpd.s3b,FU:"Displays a structured question form to collect specific information from users when requests are ambiguous or lack detail.",Lz:4,A1c:!0,description:['**Ask Clarifying Questions Tool**\n\nRole:\n- Display structured clarifying questions when user requests are ambiguous or lack sufficient detail\n- Collect specific information needed to proceed with a task\n- Present questions in a clear, user-friendly form format\n\nHow It Works:\n- You provide the contextMessage and questionForm\n- The tool displays them to the user as an interactive form\n- After the user answers, you receive their responses and can proceed\n\nQuestion Guidelines:\n- Keep questions clear, concise, and focused\n- Prefer multi-select when the user could reasonably choose more than one option. Use single-select only when options are truly mutually exclusive. Never create "Both" or "All of the above" as a single option — use multi-select instead.\n- Provide helpful option labels that are easy to understand\n- Include context message to explain why you\'re asking these questions\n- Keep the number of questions minimal (2-3 questions max)\n- Make sure each question is necessary to proceed\n- Don\'t ask for information you already have from context',
"\n\n**IMPORTANT: This is a terminator tool.** Calling this tool ends the current orchestration loop and waits for user input. Only call this tool when you are ready to stop iterating and return control to the user."]};var UcbZj={Pm:Ucpd.Wfb,FU:"Sends a message to the user with essential information and an optional follow-up question.",Lz:4,A1c:!0,description:["## Role\nUse this tool to send a message to the user — such as answering a question, providing a summary, or asking a clarifying question.\n\n**IMPORTANT**: When used to signal task completion, this **must be the *only* tool call in that round**.\n\n## Message Guidelines\n\n### Personality and Tone\n- Friendly, collaborative, and action-oriented\n- Focus on clear, concise communication\n\n### Clarifying Questions\n- If a user request is vague or lacks sufficient detail, ask clarifying questions before taking action.\n- Do not select tools to run if a request could potentially be fulfilled by multiple different tools — ask for clarification first.\n\n### Honesty About Limitations\nBe transparent about what the assistant and tools can and cannot do, without excessive apologies.\n\n### Refusal Policy\nPolitely refuse unsupported requests without lengthy apologies.\nSuggest relevant alternatives if appropriate.\n\n## Technical Usage\n- Use the current date placeholder as {{currentDate}} when referencing today's date.\n\n## Exclusion rules\n- Don't include unnecessary filler, greetings, and redundancy.\n- Remove any internal metadata (diagram IDs, item IDs, coordinates, technical identifiers, etc.).\n- Never provide links or URLs directly, whether in markdown format or not.\n- Do not mention tool internals, schemas, or post-processing.\n\n## Suggested Actions\n- You may optionally include 1-3 suggested follow-up actions as clickable buttons via the SuggestedActions parameter.",
